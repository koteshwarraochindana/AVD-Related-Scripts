# ============================================================
# AVD Personal Host Assignment Script
# ============================================================

# -----------------------------
# Environment Variables
# -----------------------------
$SubscriptionId = "56fb6a7f-8b65-4aba-90f0-b17a9dbb7b55"
$ResourceGroupName = "prd_scentral_avd_corp2_infra_rg"
$HostPoolName = "AVD-CAS2-CORP2-SC"

# Hardcoded CSV file
$CsvPath = "C:\Temp\Assignments.csv"

# Log files
$TimeStamp = Get-Date -Format "yyyyMMdd_HHmmss"
$ReportFile = "C:\AVD\AVD_Assignment_Report_$TimeStamp.csv"
$LogFile = "C:\AVD\AVD_Assignment_Log_$TimeStamp.txt"

# -----------------------------
# Start Logging
# -----------------------------
Start-Transcript -Path $LogFile

Write-Host ""
Write-Host "Connecting to Azure..." -ForegroundColor Cyan

Connect-AzAccount
Set-AzContext -SubscriptionId $SubscriptionId | Out-Null

# -----------------------------
# Read CSV
# -----------------------------
$Assignments = Import-Csv $CsvPath

$Results = @()

foreach ($Item in $Assignments)
{
    $SessionHostName = $Item.SessionHostName.Trim()
    $AssignedUser = $Item.AssignedUser.Trim()

    Write-Host ""
    Write-Host "Processing: $SessionHostName" -ForegroundColor Yellow

    try
    {
        # Verify User Exists
        $User = Get-AzADUser -UserPrincipalName $AssignedUser -ErrorAction Stop

        # Get Session Host
        $SessionHost = Get-AzWvdSessionHost `
            -ResourceGroupName $ResourceGroupName `
            -HostPoolName $HostPoolName `
            -Name $SessionHostName `
            -ErrorAction Stop

        # Check Existing Assignment
        if (!:IsNullOrWhiteSpace($SessionHost.AssignedUser))
        {
            $Status = "Skipped"

            $Message = "Already assigned to $($SessionHost.AssignedUser)"

            Write-Host "Skipped - Already assigned to $($SessionHost.AssignedUser)" -ForegroundColor Yellow
        }
        else
        {
            Update-AzWvdSessionHost `
                -ResourceGroupName $ResourceGroupName `
                -HostPoolName $HostPoolName `
                -Name $SessionHostName `
                -AssignedUser $AssignedUser `
                -ErrorAction Stop

            $Status = "Success"
            $Message = "Assigned successfully"

            Write-Host "Assigned $AssignedUser" -ForegroundColor Green
        }
    }
    catch
    {
        $Status = "Failed"
        $Message = $_.Exception.Message

        Write-Host "Failed: $Message" -ForegroundColor Red
    }

    $Results += [PSCustomObject]@{
        TimeStamp       = Get-Date
        SessionHostName = $SessionHostName
        AssignedUser    = $AssignedUser
        Status          = $Status
        Message         = $Message
    }
}

# -----------------------------
# Export Results
# -----------------------------
$Results | Export-Csv $ReportFile -NoTypeInformation

Stop-Transcript

Write-Host ""
Write-Host "==================================" -ForegroundColor Cyan
Write-Host "Assignment process completed." -ForegroundColor Green
Write-Host "Log File    : $LogFile"
Write-Host "Report File : $ReportFile"
Write-Host "==================================" -ForegroundColor Cyan

# ============================================================
# AVD Personal Host Pool - Bulk Session Host Assignment
# ============================================================

# -----------------------------
# Configuration
# -----------------------------
$SubscriptionId    = "56fb6a7f-8b65-4aba-90f0-b17a9dbb7b55"
$ResourceGroupName = "prd_scentral_avd_corp2_infra_rg"
$HostPoolName      = "AVD-CAS2-CORP2-SC"
$CsvPath           = "C:\Temp\Assignments.csv"
$OutputPath        = "C:\Temp\AVD_Assignment_Results.csv"


# -----------------------------
# Validate Module
# -----------------------------
if (-not (Get-Module -ListAvailable -Name Az.DesktopVirtualization)) {

    Write-Host ""
    Write-Host "ERROR: Az.DesktopVirtualization module is not installed." `
        -ForegroundColor Red

    exit
}


# -----------------------------
# Validate CSV
# -----------------------------
if (-not (Test-Path $CsvPath)) {

    Write-Host ""
    Write-Host "ERROR: CSV file not found:" -ForegroundColor Red
    Write-Host $CsvPath -ForegroundColor Yellow

    exit
}


# -----------------------------
# Select Azure Subscription
# -----------------------------
Write-Host ""
Write-Host "Connecting to Azure..." -ForegroundColor Cyan

try {

    Set-AzContext `
        -SubscriptionId $SubscriptionId `
        -ErrorAction Stop | Out-Null

    Write-Host "Azure subscription selected successfully." `
        -ForegroundColor Green
}
catch {

    Write-Host ""
    Write-Host "ERROR: Unable to select Azure subscription." `
        -ForegroundColor Red

    Write-Host $_.Exception.Message -ForegroundColor Red

    exit
}


# -----------------------------
# Import CSV
# -----------------------------
$Assignments = Import-Csv -Path $CsvPath

if (-not $Assignments -or $Assignments.Count -eq 0) {

    Write-Host ""
    Write-Host "ERROR: CSV contains no records." `
        -ForegroundColor Red

    exit
}


# -----------------------------
# Validate CSV Columns
# -----------------------------
$Columns = $Assignments[0].PSObject.Properties.Name

if ($Columns -notcontains "SessionHostName") {

    Write-Host ""
    Write-Host "ERROR: CSV must contain column: SessionHostName" `
        -ForegroundColor Red

    exit
}

if ($Columns -notcontains "UserEmail") {

    Write-Host ""
    Write-Host "ERROR: CSV must contain column: UserEmail" `
        -ForegroundColor Red

    exit
}


# -----------------------------
# Retrieve All Session Hosts
# -----------------------------
Write-Host ""
Write-Host "Retrieving session hosts from host pool..." `
    -ForegroundColor Cyan

try {

    $SessionHosts = Get-AzWvdSessionHost `
        -ResourceGroupName $ResourceGroupName `
        -HostPoolName $HostPoolName `
        -ErrorAction Stop
}
catch {

    Write-Host ""
    Write-Host "ERROR: Unable to retrieve session hosts." `
        -ForegroundColor Red

    Write-Host $_.Exception.Message -ForegroundColor Red

    exit
}

Write-Host "Session hosts found: $($SessionHosts.Count)" `
    -ForegroundColor Green


# -----------------------------
# Process CSV
# -----------------------------
$Results = @()

$TotalRows = $Assignments.Count
$Counter = 0

Write-Host ""
Write-Host "Starting assignment process..." `
    -ForegroundColor Cyan

Write-Host "============================================================"


foreach ($Item in $Assignments) {

    $Counter++

    # -----------------------------
    # Read CSV values
    # -----------------------------
    $RawHostName = if ($null -ne $Item.SessionHostName) {
        $Item.SessionHostName.Trim()
    }
    else {
        ""
    }

    $UserEmail = if ($null -ne $Item.UserEmail) {
        $Item.UserEmail.Trim()
    }
    else {
        ""
    }


    # -----------------------------
    # Remove FQDN from CSV
    # -----------------------------
    $ShortHostName = ($RawHostName -split "\.")[0]


    Write-Host ""
    Write-Host "[$Counter/$TotalRows] $ShortHostName -> $UserEmail" `
        -ForegroundColor Cyan


    # -----------------------------
    # Validate CSV values
    # -----------------------------
    if ([string]::IsNullOrWhiteSpace($ShortHostName)) {

        Write-Host "SKIPPED - Session host name is empty." `
            -ForegroundColor Yellow

        $Results += [PSCustomObject]@{
            Sequence        = $Counter
            TimeStamp       = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            SessionHostName = $RawHostName
            UserEmail       = $UserEmail
            CurrentAssigned = ""
            Status          = "Skipped"
            Message         = "Session host name is empty"
        }

        continue
    }


    if ([string]::IsNullOrWhiteSpace($UserEmail)) {

        Write-Host "SKIPPED - User email is empty." `
            -ForegroundColor Yellow

        $Results += [PSCustomObject]@{
            Sequence        = $Counter
            TimeStamp       = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            SessionHostName = $ShortHostName
            UserEmail       = $UserEmail
            CurrentAssigned = ""
            Status          = "Skipped"
            Message         = "User email is empty"
        }

        continue
    }


    # -----------------------------
    # Find Session Host
    # -----------------------------
    # Azure may return:
    #
    # AVD-CAS2-CORP2-SC/CAWV1ddd.adhcscint.net
    #
    # CSV may contain:
    #
    # CAWV1ddd
    #
    # Normalize both to:
    #
    # CAWV1ddd
    # -----------------------------

    $TargetHost = $SessionHosts | Where-Object {

        $AzureSessionHostName = ($_.Name -split "/")[-1]

        $AzureShortHostName = ($AzureSessionHostName -split "\.")[0]

        $AzureShortHostName -ieq $ShortHostName
    }


    # -----------------------------
    # Session Host Not Found
    # -----------------------------
    if (-not $TargetHost) {

        Write-Host "FAILED - Session host not found." `
            -ForegroundColor Red

        $Results += [PSCustomObject]@{
            Sequence        = $Counter
            TimeStamp       = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            SessionHostName = $ShortHostName
            UserEmail       = $UserEmail
            CurrentAssigned = ""
            Status          = "Failed"
            Message         = "Session host not found in host pool"
        }

        continue
    }


    # -----------------------------
    # Get Current Assignment
    # -----------------------------
    $CurrentAssigned = $TargetHost.AssignedUser


    # -----------------------------
    # NEVER overwrite existing user
    # -----------------------------
    if (-not [string]::IsNullOrWhiteSpace($CurrentAssigned)) {

        Write-Host "SKIPPED - Already assigned to $CurrentAssigned" `
            -ForegroundColor Yellow

        $Results += [PSCustomObject]@{
            Sequence        = $Counter
            TimeStamp       = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            SessionHostName = $ShortHostName
            UserEmail       = $UserEmail
            CurrentAssigned = $CurrentAssigned
            Status          = "Skipped"
            Message         = "Session host already has an assigned user. No changes made."
        }

        continue
    }


    # -----------------------------
    # Assign User
    # -----------------------------
    try {

        # Use the exact Azure resource name returned by Azure.
        # This avoids FQDN/name-format issues.
        $SessionHostResourceName = $TargetHost.Name

        Update-AzWvdSessionHost `
            -ResourceGroupName $ResourceGroupName `
            -HostPoolName $HostPoolName `
            -Name $SessionHostResourceName `
            -AssignedUser $UserEmail `
            -ErrorAction Stop |
            Out-Null


        Write-Host "SUCCESS - Assigned to $UserEmail" `
            -ForegroundColor Green


        # Update local object so that if the same host
        # appears twice in the CSV, it won't be assigned twice.
        $TargetHost.AssignedUser = $UserEmail


        $Results += [PSCustomObject]@{
            Sequence        = $Counter
            TimeStamp       = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            SessionHostName = $ShortHostName
            UserEmail       = $UserEmail
            CurrentAssigned = ""
            Status          = "Success"
            Message         = "Session host assigned successfully"
        }

    }
    catch {

        Write-Host "FAILED - Assignment failed." `
            -ForegroundColor Red

        Write-Host $_.Exception.Message `
            -ForegroundColor Red


        $Results += [PSCustomObject]@{
            Sequence        = $Counter
            TimeStamp       = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            SessionHostName = $ShortHostName
            UserEmail       = $UserEmail
            CurrentAssigned = ""
            Status          = "Failed"
            Message         = $_.Exception.Message
        }
    }
}


# -----------------------------
# Export Results
# -----------------------------
Write-Host ""
Write-Host "============================================================"
Write-Host "Assignment Process Completed" `
    -ForegroundColor Green
Write-Host "============================================================"


$Results |
    Export-Csv `
        -Path $OutputPath `
        -NoTypeInformation `
        -Encoding UTF8


# -----------------------------
# Summary
# -----------------------------
$SuccessCount = @(
    $Results | Where-Object { $_.Status -eq "Success" }
).Count

$SkippedCount = @(
    $Results | Where-Object { $_.Status -eq "Skipped" }
).Count

$FailedCount = @(
    $Results | Where-Object { $_.Status -eq "Failed" }
).Count


Write-Host ""
Write-Host "                    SUMMARY" `
    -ForegroundColor Cyan

Write-Host "------------------------------------------------------------"

Write-Host "Total Records : $TotalRows"
Write-Host "Successful    : $SuccessCount" -ForegroundColor Green
Write-Host "Skipped       : $SkippedCount" -ForegroundColor Yellow
Write-Host "Failed        : $FailedCount" -ForegroundColor Red

Write-Host "------------------------------------------------------------"

Write-Host ""
Write-Host "Results exported to:" -ForegroundColor Cyan
Write-Host $OutputPath -ForegroundColor White
Write-Host ""

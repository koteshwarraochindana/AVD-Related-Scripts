# ============================================================ #
# AVD Personal Host Assignment Script (Final Working Build)   #
# ============================================================ #

# -----------------------------
# Configuration
# -----------------------------
$SubscriptionId   = "56fb6a7f-8b65-4aba-90f0-b17a9dbb7b55"
$ResourceGroupName = "prd_scentral_avd_corp2_infra_rg"
$HostPoolName      = "AVD-CAS2-CORP2-SC"
$CsvPath           = "C:\Temp\Assignments.csv"

# -----------------------------
# Pre-Run Checks
# -----------------------------
if (!(Get-Module -ListAvailable -Name Az.DesktopVirtualization, Az.Resources)) {
    Write-Host "Error: Required Azure PowerShell modules are missing." -ForegroundColor Red
    Return
}

if (!(Test-Path $CsvPath)) {
    Write-Host "Error: CSV file not found at $CsvPath" -ForegroundColor Red
    Return
}

# -----------------------------
# Azure Authentication
# -----------------------------
Write-Host ""
Write-Host "Connecting to Azure Subscription..." -ForegroundColor Cyan
Select-AzSubscription -SubscriptionId $SubscriptionId | Out-Null

# -----------------------------
# Process Input Data
# -----------------------------
$Assignments = Import-Csv $CsvPath
$TotalRows   = $Assignments.Count
$Counter     = 1

Write-Host ""
Write-Host "Processing $TotalRows records from your CSV list..." -ForegroundColor Cyan
Write-Host "--------------------------------------------------------" -ForegroundColor Cyan

$Results = foreach ($Item in $Assignments) {
    # Clean input strings
    $RawHostName = $Item.SessionHostName.Trim()
    $AssignedUser = $Item.AssignedUser.Trim()
    
    # Strip domain suffix safely (turns machine.domain.net into machine)
    $ShortHostName = $RawHostName.Split('.')[0]

    # Format the exact target path Azure requires
    $FullHostName = "$HostPoolName/$ShortHostName"

    try {
        # 1. Verify User exists in Azure Active Directory
        $User = Get-AzADUser -UserPrincipalName $AssignedUser -ErrorAction Stop

        # 2. Get the current Session Host status
        $SessionHost = Get-AzWvdSessionHost `
            -ResourceGroupName $ResourceGroupName `
            -HostPoolName $HostPoolName `
            -Name $FullHostName `
            -ErrorAction Stop

        # 3. Handle Assignment checking and writing
        if (![string]::IsNullOrWhiteSpace($SessionHost.AssignedUser)) {
            $Status = "Skipped"
            $Message = "Already assigned to $($SessionHost.AssignedUser)"
        } else {
            Update-AzWvdSessionHost `
                -ResourceGroupName $ResourceGroupName `
                -HostPoolName $HostPoolName `
                -Name $FullHostName `
                -AssignedUser $AssignedUser `
                -ErrorAction Stop | Out-Null
            $Status = "Success"
            $Message = "Assigned successfully"
        }
    } catch {
        $Status = "Failed"
        $Message = $_.Exception.Message
    }

    # Color customization for live logs
    $LineColor = switch ($Status) {
        "Success" { "Green" }
        "Skipped" { "Yellow" }
        Default   { "Red" }
    }

    # Print live status message
    Write-Host "[$Counter/$TotalRows] $ShortHostName -> $AssignedUser ($Status)" -ForegroundColor $LineColor
    $Counter++

    # Send object data to final summary matrix collection
    [PSCustomObject]@{
        Sequence        = $Counter - 1
        TimeStamp       = (Get-Date -Format "yyyy-MM-dd HH:mm:ss")
        SessionHostName = $RawHostName
        CleanHostName   = $ShortHostName
        AssignedUser    = $AssignedUser
        Status          = $Status
        Message         = $Message
    }
}

# -----------------------------
# Print Final Log Table
# -----------------------------
Write-Host ""
Write-Host "========================================================================================" -ForegroundColor Cyan
Write-Host "Process Finished! Total Processed Rows: $TotalRows" -ForegroundColor Green
Write-Host "========================================================================================" -ForegroundColor Cyan
Write-Host ""

$Results | Format-Table -Property Sequence, TimeStamp, CleanHostName, AssignedUser, Status, Message -AutoSize

# ============================================================ #
# AVD Personal Host Assignment - CSV Based                    #
# ============================================================ #

# -----------------------------
# Environment Variables
# -----------------------------
$SubscriptionId    = "56fb6a7f-8b65-4aba-90f0-b17a9dbb7b55"
$ResourceGroupName = "prd_scentral_avd_corp2_infra_rg"
$HostPoolName      = "AVD-CAS2-CORP2-SC"
$CsvPath           = "C:\Temp\Assignments.csv"
$OutputPath        = "C:\Temp\AVD_Assignment_Results.csv"


# -----------------------------
# Prerequisite Check
# -----------------------------
if (!(Get-Module -ListAvailable -Name Az.DesktopVirtualization)) {
    Write-Host "Error: Az.DesktopVirtualization module is missing." -ForegroundColor Red
    return
}

if (!(Test-Path $CsvPath)) {
    Write-Host "Error: Input CSV file not found at $CsvPath" -ForegroundColor Red
    return
}


# -----------------------------
# Connect to Azure
# -----------------------------
Write-Host ""
Write-Host "Connecting to Azure..." -ForegroundColor Cyan

Connect-AzAccount -WarningAction SilentlyContinue

Set-AzContext `
    -SubscriptionId $SubscriptionId |
    Out-Null


# -----------------------------
# Import CSV
# -----------------------------
$Assignments = Import-Csv $CsvPath

if (!$Assignments) {
    Write-Host "Error: CSV contains no records." -ForegroundColor Red
    return
}

$TotalRows = $Assignments.Count
$Counter = 1


Write-Host ""
Write-Host "Found $TotalRows input records in CSV file." -ForegroundColor Cyan
Write-Host "Starting assignment process..." -ForegroundColor Cyan
Write-Host ""


# -----------------------------
# Process CSV
# -----------------------------
$Results = foreach ($Item in $Assignments) {

    $SessionHostName = $Item.SessionHostName.Trim()
    $AssignedUser    = $Item.UserEmail.Trim()

    try {

        # Ensure correct AVD session host format
        if ($SessionHostName -notmatch "^$HostPoolName/") {
            $FullHostName = "$HostPoolName/$SessionHostName"
        }
        else {
            $FullHostName = $SessionHostName
        }


        # Assign user directly from CSV
        Update-AzWvdSessionHost `
            -ResourceGroupName $ResourceGroupName `
            -HostPoolName $HostPoolName `
            -Name $FullHostName `
            -AssignedUser $AssignedUser `
            -ErrorAction Stop |
            Out-Null


        $Status = "Success"
        $Message = "Assigned successfully"

    }
    catch {

        $Status = "Failed"
        $Message = $_.Exception.Message
    }


    # -----------------------------
    # Display Result
    # -----------------------------
    $TextColor = switch ($Status) {
        "Success" { "Green" }
        Default   { "Red" }
    }

    Write-Host `
        "[$Counter/$TotalRows] $SessionHostName -> $AssignedUser ($Status)" `
        -ForegroundColor $TextColor


    # -----------------------------
    # Result Object
    # -----------------------------
    [PSCustomObject]@{
        Sequence        = $Counter
        TimeStamp       = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        SessionHostName = $SessionHostName
        AssignedUser    = $AssignedUser
        Status          = $Status
        Message         = $Message
    }

    $Counter++
}


# -----------------------------
# Export Results
# -----------------------------
$Results |
    Export-Csv `
        -Path $OutputPath `
        -NoTypeInformation `
        -Encoding UTF8


# -----------------------------
# Summary
# -----------------------------
$SuccessCount = @($Results | Where-Object Status -eq "Success").Count
$FailedCount  = @($Results | Where-Object Status -eq "Failed").Count


Write-Host ""
Write-Host "================================================================================" `
    -ForegroundColor Cyan

Write-Host "Assignment process completed." `
    -ForegroundColor Green

Write-Host "Total    : $TotalRows"
Write-Host "Success  : $SuccessCount" -ForegroundColor Green
Write-Host "Failed   : $FailedCount" -ForegroundColor Red

Write-Host ""
Write-Host "Results exported to:" -ForegroundColor Cyan
Write-Host $OutputPath
Write-Host "================================================================================" `
    -ForegroundColor Cyan

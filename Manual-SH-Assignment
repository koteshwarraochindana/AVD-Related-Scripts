# ============================================================ #
# AVD Personal Host Assignment Script (Optimized & Fixed)     #
# ============================================================ #

# -----------------------------
# Environment Variables
# -----------------------------
$SubscriptionId = "56fb6a7f-8b65-4aba-90f0-b17a9dbb7b55"
$ResourceGroupName = "prd_scentral_avd_corp2_infra_rg"
$HostPoolName = "AVD-CAS2-CORP2-SC"
$CsvPath = "C:\Temp\Assignments.csv"

# -----------------------------
# Prerequisite Check
# -----------------------------
if (!(Get-Module -ListAvailable -Name Az.DesktopVirtualization, Az.Resources)) {
    Write-Host "Error: Required Azure PowerShell modules are missing." -ForegroundColor Red
    Return
}

if (!(Test-Path $CsvPath)) {
    Write-Host "Error: Input CSV file not found at $CsvPath" -ForegroundColor Red
    Return
}

# -----------------------------
# Connect to Azure
# -----------------------------
Write-Host ""
Write-Host "Clearing stale sessions and connecting to Azure..." -ForegroundColor Cyan

# Force clear any stuck or expired auth tokens
Clear-AzContext -Force -ErrorAction SilentlyContinue

# Trigger a fresh authentication prompt
Connect-AzAccount -WarningAction SilentlyContinue
Set-AzContext -SubscriptionId $SubscriptionId | Out-Null

# -----------------------------
# Process CSV
# -----------------------------
$Assignments = Import-Csv $CsvPath
$TotalRows = $Assignments.Count
$Counter = 1

Write-Host ""
Write-Host "Found $TotalRows input records in CSV file. Starting processing..." -ForegroundColor Cyan

# Assigning loop directly to variable prevents array rebuild slowness
$Results = foreach ($Item in $Assignments) {
    $SessionHostName = $Item.SessionHostName.Trim()
    $AssignedUser = $Item.AssignedUser.Trim()
    
    # Clean up the hostname by grabbing everything before the first period
    $ShortHostName = ($SessionHostName -split '\.')[0]

    # Combine the Host Pool Name with the clean, short computer name for Azure
    $FullHostName = "$HostPoolName/$ShortHostName"

    try {
        # Verify User Exists
        $User = Get-AzADUser -UserPrincipalName $AssignedUser -ErrorAction Stop

        # Get Session Host
        $SessionHost = Get-AzWvdSessionHost `
            -ResourceGroupName $ResourceGroupName `
            -HostPoolName $HostPoolName `
            -Name $FullHostName `
            -ErrorAction Stop

        # Check existing assignments
        if (![string]::IsNullOrWhiteSpace($SessionHost.AssignedUser)) {
            $Status = "Skipped"
            $Message = "Already assigned to $($SessionHost.AssignedUser)"
        } else {
            Update-AzWvdSessionHost `
                -ResourceGroupName $ResourceGroupName `
                -HostPoolName $HostPoolName `
                -Name $FullHostName `
                -AssignedUser $AssignedUser `
                -ErrorAction Stop | Out-Null
            $Status = "Success"
            $Message = "Assigned successfully"
        }
    } catch {
        $Status = "Failed"
        $Message = $_.Exception.Message
    }

    # Color assignment
    $TextColor = switch ($Status) {
        "Success" { "Green" }
        "Skipped" { "Yellow" }
        Default   { "Red" }
    }

    Write-Host "[$Counter/$TotalRows] $SessionHostName -> $AssignedUser ($Status)" -ForegroundColor $TextColor
    $Counter++

    # Output object directly to the $Results collection
    [PSCustomObject]@{
        Sequence        = $Counter - 1
        TimeStamp       = (Get-Date -Format "yyyy-MM-dd HH:mm:ss")
        SessionHostName = $SessionHostName
        AssignedUser    = $AssignedUser
        Status          = $Status
        Message         = $Message
    }
}

# -----------------------------
# Display Tabular Summary
# -----------------------------
Write-Host ""
Write-Host "========================================================================================" -ForegroundColor Cyan
Write-Host "Assignment process completed. Total processed: $TotalRows" -ForegroundColor Green
Write-Host "========================================================================================" -ForegroundColor Cyan
Write-Host ""

$Results | Format-Table -AutoSize

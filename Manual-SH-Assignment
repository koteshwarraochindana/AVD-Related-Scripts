# ============================================================
# AVD Personal Host Pool - Bulk Session Host Assignment
# ============================================================

# -----------------------------
# Configuration
# -----------------------------
$SubscriptionId    = "56fb6a7f-8b65-4aba-90f0-b17a9dbb7b55"
$ResourceGroupName = "prd_scentral_avd_corp2_infra_rg"
$HostPoolName      = "AVD-CAS2-CORP2-SC"
$CsvPath           = "C:\Temp\Assignments.csv"

# Output file
$OutputPath = "C:\Temp\AVD_Assignment_Results.csv"

# -----------------------------
# Connect to Azure
# -----------------------------
Write-Host ""
Write-Host "Connecting to Azure..." -ForegroundColor Cyan

try {
    Connect-AzAccount -ErrorAction Stop | Out-Null
    Set-AzContext -SubscriptionId $SubscriptionId -ErrorAction Stop | Out-Null
}
catch {
    Write-Host "Azure connection failed: $($_.Exception.Message)" -ForegroundColor Red
    exit
}

Write-Host "Connected successfully." -ForegroundColor Green

# -----------------------------
# Validate CSV
# -----------------------------
if (-not (Test-Path $CsvPath)) {
    Write-Host "CSV file not found: $CsvPath" -ForegroundColor Red
    exit
}

$Assignments = Import-Csv -Path $CsvPath

if ($Assignments.Count -eq 0) {
    Write-Host "CSV contains no records." -ForegroundColor Yellow
    exit
}

# -----------------------------
# Validate required columns
# -----------------------------
$RequiredColumns = @(
    "SessionHostName",
    "UserEmail"
)

foreach ($Column in $RequiredColumns) {

    if ($Assignments[0].PSObject.Properties.Name -notcontains $Column) {

        Write-Host "Missing CSV column: $Column" -ForegroundColor Red
        Write-Host ""
        Write-Host "Expected CSV format:" -ForegroundColor Yellow
        Write-Host "SessionHostName,UserEmail" -ForegroundColor Yellow
        Write-Host "avdsh001,user1@contoso.com" -ForegroundColor Yellow

        exit
    }
}

# -----------------------------
# Get Host Pool Session Hosts
# -----------------------------
Write-Host ""
Write-Host "Retrieving session hosts from host pool..." -ForegroundColor Cyan

try {

    $SessionHosts = Get-AzWvdSessionHost `
        -ResourceGroupName $ResourceGroupName `
        -HostPoolName $HostPoolName `
        -ErrorAction Stop

}
catch {

    Write-Host "Unable to retrieve session hosts." -ForegroundColor Red
    Write-Host $_.Exception.Message -ForegroundColor Red
    exit
}

Write-Host "Found $($SessionHosts.Count) session hosts." -ForegroundColor Green

# -----------------------------
# Process Assignments
# -----------------------------
$Results = @()

$Total = $Assignments.Count
$Count = 0

Write-Host ""
Write-Host "Starting assignments..." -ForegroundColor Cyan
Write-Host "============================================================"

foreach ($Assignment in $Assignments) {

    $Count++

    $SessionHostInput = $Assignment.SessionHostName.Trim()
    $UserEmail        = $Assignment.UserEmail.Trim()

    # Remove FQDN if supplied
    $ShortHostName = ($SessionHostInput -split "\.")[0]

    Write-Host ""
    Write-Host "[$Count/$Total] Processing $ShortHostName -> $UserEmail" `
        -ForegroundColor Cyan

    # --------------------------------
    # Validate input
    # --------------------------------
    if ([string]::IsNullOrWhiteSpace($ShortHostName)) {

        $Results += [PSCustomObject]@{
            SessionHost = $SessionHostInput
            UserEmail   = $UserEmail
            OldUser     = ""
            NewUser     = ""
            Status      = "Failed"
            Message     = "Session host name is empty"
        }

        continue
    }

    if ([string]::IsNullOrWhiteSpace($UserEmail)) {

        $Results += [PSCustomObject]@{
            SessionHost = $SessionHostInput
            UserEmail   = $UserEmail
            OldUser     = ""
            NewUser     = ""
            Status      = "Failed"
            Message     = "User email is empty"
        }

        continue
    }

    # --------------------------------
    # Find Session Host
    # --------------------------------
    $TargetHost = $SessionHosts | Where-Object {

        # Azure normally returns:
        # hostpool/sessionhostname

        $ReturnedHostName = ($_.Name -split "/")[-1]

        $ReturnedHostName -ieq $ShortHostName

    }

    if (-not $TargetHost) {

        Write-Host "Session host not found." -ForegroundColor Red

        $Results += [PSCustomObject]@{
            SessionHost = $ShortHostName
            UserEmail   = $UserEmail
            OldUser     = ""
            NewUser     = ""
            Status      = "Failed"
            Message     = "Session host not found in host pool"
        }

        continue
    }

    # --------------------------------
    # Current Assignment
    # --------------------------------
    $CurrentUser = $TargetHost.AssignedUser

    # --------------------------------
    # Already assigned to same user
    # --------------------------------
    if ($CurrentUser -and ($CurrentUser -ieq $UserEmail)) {

        Write-Host "Already assigned to $UserEmail" -ForegroundColor Yellow

        $Results += [PSCustomObject]@{
            SessionHost = $ShortHostName
            UserEmail   = $UserEmail
            OldUser     = $CurrentUser
            NewUser     = $CurrentUser
            Status      = "Skipped"
            Message     = "Session host is already assigned to this user"
        }

        continue
    }

    # --------------------------------
    # Already assigned to another user
    # --------------------------------
    if ($CurrentUser) {

        Write-Host "Currently assigned to: $CurrentUser" `
            -ForegroundColor Yellow

        Write-Host "Changing assignment to: $UserEmail" `
            -ForegroundColor Yellow
    }

    # --------------------------------
    # Verify User
    # --------------------------------
    try {

        $User = Get-AzADUser `
            -UserPrincipalName $UserEmail `
            -ErrorAction Stop

    }
    catch {

        Write-Host "User not found: $UserEmail" -ForegroundColor Red

        $Results += [PSCustomObject]@{
            SessionHost = $ShortHostName
            UserEmail   = $UserEmail
            OldUser     = $CurrentUser
            NewUser     = ""
            Status      = "Failed"
            Message     = "User was not found in Microsoft Entra ID"
        }

        continue
    }

    # --------------------------------
    # Build Azure Session Host Name
    # --------------------------------
    $SessionHostResourceName = "$HostPoolName/$ShortHostName"

    # --------------------------------
    # Assign User
    # --------------------------------
    try {

        Update-AzWvdSessionHost `
            -ResourceGroupName $ResourceGroupName `
            -HostPoolName $HostPoolName `
            -Name $SessionHostResourceName `
            -AssignedUser $UserEmail `
            -ErrorAction Stop | Out-Null

        Write-Host "Assignment successful." -ForegroundColor Green

        $Results += [PSCustomObject]@{
            SessionHost = $ShortHostName
            UserEmail   = $UserEmail
            OldUser     = $CurrentUser
            NewUser     = $UserEmail
            Status      = "Success"
            Message     = "Session host assigned successfully"
        }

    }
    catch {

        Write-Host "Assignment failed." -ForegroundColor Red
        Write-Host $_.Exception.Message -ForegroundColor Red

        $Results += [PSCustomObject]@{
            SessionHost = $ShortHostName
            UserEmail   = $UserEmail
            OldUser     = $CurrentUser
            NewUser     = ""
            Status      = "Failed"
            Message     = $_.Exception.Message
        }
    }
}

# -----------------------------
# Export Results
# -----------------------------
Write-Host ""
Write-Host "============================================================"
Write-Host "Assignment Process Completed" -ForegroundColor Green
Write-Host "============================================================"

$Results |
    Export-Csv `
        -Path $OutputPath `
        -NoTypeInformation `
        -Encoding UTF8

Write-Host ""
Write-Host "Results saved to:" -ForegroundColor Cyan
Write-Host $OutputPath -ForegroundColor White

# -----------------------------
# Summary
# -----------------------------
$SuccessCount = ($Results | Where-Object Status -eq "Success").Count
$SkippedCount = ($Results | Where-Object Status -eq "Skipped").Count
$FailedCount  = ($Results | Where-Object Status -eq "Failed").Count

Write-Host ""
Write-Host "---------------- SUMMARY ----------------" -ForegroundColor Cyan
Write-Host "Total     : $Total"
Write-Host "Success   : $SuccessCount" -ForegroundColor Green
Write-Host "Skipped   : $SkippedCount" -ForegroundColor Yellow
Write-Host "Failed    : $FailedCount" -ForegroundColor Red
Write-Host "------------------------------------------"

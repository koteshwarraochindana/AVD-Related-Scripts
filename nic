
# ==============================================================
# GHOSTED NETWORK ADAPTER INVENTORY - AZURE VM RUN COMMAND
# Execution Method : Invoke-AzVMRunCommand
# PowerShell       : 5.1 Compatible
# Operation        : READ ONLY
# ==============================================================

$CsvPath    = "C:\Temp\avd_hosts.csv"
$OutputPath = "C:\Temp\GhostedNIC_Inventory_Results.csv"

$ErrorActionPreference = "Stop"

Write-Host ""
Write-Host "======================================================" -ForegroundColor Cyan
Write-Host "       GHOSTED NETWORK ADAPTER INVENTORY" -ForegroundColor Cyan
Write-Host "       AZURE VM RUN COMMAND" -ForegroundColor Cyan
Write-Host "======================================================" -ForegroundColor Cyan

# --------------------------------------------------------------
# 1. Validate input
# --------------------------------------------------------------

if (!(Test-Path $CsvPath)) {
    throw "CSV file not found: $CsvPath"
}

$VMList = Import-Csv -Path $CsvPath

if (!$VMList -or $VMList.Count -eq 0) {
    throw "CSV contains no VM records."
}

$RequiredColumns = @("VMName", "ResourceGroupName", "SubscriptionId")

foreach ($Column in $RequiredColumns) {
    if ($Column -notin $VMList[0].PSObject.Properties.Name) {
        throw "Missing required CSV column: $Column"
    }
}

$VMList = $VMList | Where-Object {
    ![string]::IsNullOrWhiteSpace($_.VMName) -and
    ![string]::IsNullOrWhiteSpace($_.ResourceGroupName) -and
    ![string]::IsNullOrWhiteSpace($_.SubscriptionId)
}

if (!$VMList -or $VMList.Count -eq 0) {
    throw "No valid VM records found in CSV."
}

Write-Host "CSV Records           : $($VMList.Count)"

# --------------------------------------------------------------
# 2. Connect to Azure
# --------------------------------------------------------------

Write-Host ""
Write-Host "Checking Azure authentication..." -ForegroundColor Yellow

try {
    $Context = Get-AzContext

    if (!$Context) {
        Connect-AzAccount | Out-Null
    }

    Write-Host "Azure authentication successful." -ForegroundColor Green
}
catch {
    throw "Azure authentication failed: $($_.Exception.Message)"
}

# --------------------------------------------------------------
# 3. Remote PowerShell script
# --------------------------------------------------------------

$RemoteScript = @'
$ErrorActionPreference = "Stop"

try {
    $Devices = @(Get-PnpDevice -Class Net -ErrorAction SilentlyContinue)

    $Ghosted = @(
        $Devices | Where-Object {
            $_.Status -eq "Unknown"
        }
    )

    $Result = [PSCustomObject]@{
        VMName            = $env:COMPUTERNAME
        TotalNetworkDevices = $Devices.Count
        GhostedNICCount   = $Ghosted.Count
        GhostedNICDetails = @(
            $Ghosted | ForEach-Object {
                [PSCustomObject]@{
                    FriendlyName = $_.FriendlyName
                    InstanceId   = $_.InstanceId
                    Status       = $_.Status
                }
            }
        )
        ScanStatus = "Success"
    }

    Write-Output ("GHOSTED_NIC_RESULT:" + ($Result | ConvertTo-Json -Depth 5 -Compress))
}
catch {
    $Result = [PSCustomObject]@{
        VMName      = $env:COMPUTERNAME
        ScanStatus  = "Enumeration Failed"
        Error       = $_.Exception.Message
    }

    Write-Output ("GHOSTED_NIC_RESULT:" + ($Result | ConvertTo-Json -Compress))
}
'@

# --------------------------------------------------------------
# 4. Execute Azure Run Command against each VM
# --------------------------------------------------------------

$Results = @()
$Counter = 0

foreach ($VM in $VMList) {

    $Counter++

    $VMName = $VM.VMName.Trim()
    $RG     = $VM.ResourceGroupName.Trim()
    $SubId  = $VM.SubscriptionId.Trim()

    Write-Host ""
    Write-Host "[$Counter/$($VMList.Count)] Scanning VM: $VMName" -ForegroundColor Cyan
    Write-Host "Resource Group: $RG"

    try {
        # Set subscription context
        Set-AzContext -SubscriptionId $SubId -ErrorAction Stop | Out-Null

        # Execute using Azure VM Run Command
        $Response = Invoke-AzVMRunCommand `
            -ResourceGroupName $RG `
            -VMName $VMName `
            -CommandId "RunPowerShellScript" `
            -ScriptString $RemoteScript `
            -ErrorAction Stop

        # Extract remote result
        $Message = ($Response.Value | ForEach-Object {
            $_.Message
        }) -join "`n"

        if ($Message -match '(?m)GHOSTED_NIC_RESULT:(\{[^\r\n]*\})') {

            $RemoteResult = $Matches[1] | ConvertFrom-Json

            $Results += [PSCustomObject]@{
                VMName              = $VMName
                ResourceGroupName   = $RG
                SubscriptionId      = $SubId
                TotalNetworkDevices = $RemoteResult.TotalNetworkDevices
                GhostedNICCount     = $RemoteResult.GhostedNICCount
                GhostedNICDetails   = (
                    $RemoteResult.GhostedNICDetails |
                    ForEach-Object { $_.FriendlyName }
                ) -join "; "
                ScanStatus          = $RemoteResult.ScanStatus
                Error               = $RemoteResult.Error
            }

            if ($RemoteResult.ScanStatus -eq "Success") {
                Write-Host "Scan successful. Ghosted NICs: $($RemoteResult.GhostedNICCount)" -ForegroundColor Green
            }
            else {
                Write-Host "Enumeration failed: $($RemoteResult.Error)" -ForegroundColor Red
            }
        }
        else {
            throw "Could not extract inventory results from Azure Run Command response."
        }
    }
    catch {
        $ErrorMessage = $_.Exception.Message

        Write-Host "Run Command failed: $ErrorMessage" -ForegroundColor Red

        $Results += [PSCustomObject]@{
            VMName              = $VMName
            ResourceGroupName   = $RG
            SubscriptionId      = $SubId
            TotalNetworkDevices = $null
            GhostedNICCount     = $null
            GhostedNICDetails   = ""
            ScanStatus          = "Run Command Failed"
            Error               = $ErrorMessage
        }
    }
}

# --------------------------------------------------------------
# 5. Summary
# --------------------------------------------------------------

$Successful = @($Results | Where-Object { $_.ScanStatus -eq "Success" })
$Failed     = @($Results | Where-Object { $_.ScanStatus -ne "Success" })
$Affected   = @($Successful | Where-Object { $_.GhostedNICCount -gt 0 })

$TotalGhosted = 0

if ($Successful.Count -gt 0) {
    $TotalGhosted = ($Successful | Measure-Object -Property GhostedNICCount -Sum).Sum
}

Write-Host ""
Write-Host "======================================================" -ForegroundColor Cyan
Write-Host "                 INVENTORY SUMMARY" -ForegroundColor Cyan
Write-Host "======================================================" -ForegroundColor Cyan

Write-Host "VMs Listed in CSV       : $($VMList.Count)"
Write-Host "Successfully Scanned   : $($Successful.Count)" -ForegroundColor Green
Write-Host "Failed Scans            : $($Failed.Count)" -ForegroundColor Red
Write-Host "VMs With Ghosted NICs  : $($Affected.Count)" -ForegroundColor Yellow
Write-Host "Total Ghosted NICs     : $TotalGhosted"

# --------------------------------------------------------------
# 6. Display affected VMs
# --------------------------------------------------------------

Write-Host ""
Write-Host "======================================================" -ForegroundColor Cyan
Write-Host "              AFFECTED VIRTUAL MACHINES" -ForegroundColor Cyan
Write-Host "======================================================" -ForegroundColor Cyan

if ($Affected.Count -gt 0) {
    $Affected |
        Select-Object VMName, GhostedNICCount, GhostedNICDetails |
        Format-Table -AutoSize -Wrap
}
else {
    Write-Host "No ghosted network adapters found in successfully scanned VMs." -ForegroundColor Green
}

# --------------------------------------------------------------
# 7. Display failed VMs
# --------------------------------------------------------------

if ($Failed.Count -gt 0) {

    Write-Host ""
    Write-Host "======================================================" -ForegroundColor Red
    Write-Host "                    FAILED SCANS" -ForegroundColor Red
    Write-Host "======================================================" -ForegroundColor Red

    $Failed |
        Select-Object VMName, ScanStatus, Error |
        Format-Table -AutoSize -Wrap
}

# --------------------------------------------------------------
# 8. Export results
# --------------------------------------------------------------

$Results | Export-Csv -Path $OutputPath -NoTypeInformation -Force

Write-Host ""
Write-Host "Full inventory exported to: $OutputPath" -ForegroundColor Green
Write-Host "Inventory completed." -ForegroundColor Green

# 1. Verify Azure login
if (-not (Get-AzContext)) {
    Connect-AzAccount
}

# 2. Collect all currently running VMs across every accessible subscription
Write-Host "Fetching running VMs across all subscriptions..." -ForegroundColor Cyan
$subscriptions = Get-AzSubscription
$computers = @()

foreach ($sub in $subscriptions) {
    Set-AzContext -SubscriptionId $sub.Id -ErrorAction SilentlyContinue | Out-Null
    $runningVMs = (Get-AzVM -Status | Where-Object { $_.PowerState -eq "VM running" }).Name
    
    if ($runningVMs) {
        $computers += $runningVMs
    }
}

# Remove any duplicate names just in case
$computers = $computers | Select-Object -Unique

if (-not $computers) {
    Write-Warning "No running VMs were found across your subscriptions."
    return
}

Write-Host "Scanning $($computers.Count) running VMs across $($subscriptions.Count) subscription(s)..." -ForegroundColor Cyan

# 3. Scan all running VMs in parallel via WinRM (Read-Only)
$results = Invoke-Command -ComputerName $computers -ThrottleLimit 50 -ErrorAction SilentlyContinue -ScriptBlock {
    [PSCustomObject]@{
        VMName      = $env:COMPUTERNAME
        GhostedNICs = (Get-PnpDevice -Class Net -Status Unknown -ErrorAction SilentlyContinue).Count
    }
}

# 4. Calculate and display environment-wide totals
$totalGhosted = ($results | Measure-Object -Property GhostedNICs -Sum).Sum
$affectedVMs  = ($results | Where-Object { $_.GhostedNICs -gt 0 }).Count

Write-Host "`n================ ENVIRONMENT SUMMARY ================" -ForegroundColor Cyan
Write-Host "Subscriptions Checked  : $($subscriptions.Count)" -ForegroundColor White
Write-Host "Online VMs Scanned     : $($results.Count)" -ForegroundColor White
Write-Host "VMs With Ghosted NICs  : $affectedVMs" -ForegroundColor Yellow
Write-Host "Total Ghosted NICs     : $totalGhosted" -ForegroundColor Red
Write-Host "=====================================================" -ForegroundColor Cyan

# 5. Display top 25 VMs with the highest ghosted NIC count
$results | Where-Object { $_.GhostedNICs -gt 0 } |
    Sort-Object -Property GhostedNICs -Descending |
    Select-Object -First 25 VMName, GhostedNICs |
    Format-Table -AutoSize

# Update path to your input CSV file
$CsvPath = "C:\Temp\avd_hosts.csv"

if (-not (Test-Path $CsvPath)) {
    Write-Error "CSV file not found at $CsvPath"
    return
}

$vmList = Import-Csv -Path $CsvPath
$computers = $vmList.VMName | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -Unique

Write-Host "Scanning $($computers.Count) targeted VMs from CSV via WinRM (Read-Only)..." -ForegroundColor Cyan

# Scan only the VMs listed in your CSV in parallel
$scanResults = Invoke-Command -ComputerName $computers -ThrottleLimit 50 -ErrorAction SilentlyContinue -ScriptBlock {
    [PSCustomObject]@{
        VMName      = $env:COMPUTERNAME
        GhostedNICs = (Get-PnpDevice -Class Net -Status Unknown -ErrorAction SilentlyContinue).Count
    }
}

# Map SubscriptionId and ResourceGroupName back to the scan results for display
$finalReport = foreach ($row in $scanResults) {
    $csvMeta = $vmList | Where-Object { $_.VMName -eq $row.VMName } | Select-Object -First 1
    [PSCustomObject]@{
        VMName            = $row.VMName
        GhostedNICs       = $row.GhostedNICs
        ResourceGroupName = $csvMeta.ResourceGroupName
        SubscriptionId    = $csvMeta.SubscriptionId
    }
}

# Display totals directly in the console (no output files created)
$totalGhosted = ($finalReport | Measure-Object -Property GhostedNICs -Sum).Sum
$affectedVMs  = ($finalReport | Where-Object { $_.GhostedNICs -gt 0 }).Count

Write-Host "`n================ TARGETED CSV SUMMARY ================" -ForegroundColor Cyan
Write-Host "VMs Listed in CSV      : $($computers.Count)" -ForegroundColor White
Write-Host "Online VMs Scanned     : $($finalReport.Count)" -ForegroundColor White
Write-Host "VMs With Ghosted NICs  : $affectedVMs" -ForegroundColor Yellow
Write-Host "Total Ghosted NICs     : $totalGhosted" -ForegroundColor Red
Write-Host "======================================================" -ForegroundColor Cyan

$finalReport | Where-Object { $_.GhostedNICs -gt 0 } |
    Sort-Object -Property GhostedNICs -Descending |
    Format-Table VMName, GhostedNICs, ResourceGroupName, SubscriptionId -AutoSize

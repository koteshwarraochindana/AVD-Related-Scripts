
# ============================================================
# TARGETED AZURE VM GHOSTED NETWORK ADAPTER SCAN
# CSV INPUT + WINRM
# PowerShell 5.1 Compatible
# READ-ONLY
# ============================================================

# ------------------------------------------------------------
# CONFIGURATION
# ------------------------------------------------------------

$CsvPath = "C:\Temp\avd_hosts.csv"
$ThrottleLimit = 50

# ------------------------------------------------------------
# STEP 1: VALIDATE CSV
# ------------------------------------------------------------

if (-not (Test-Path -LiteralPath $CsvPath)) {
    Write-Host "ERROR: CSV file not found: $CsvPath" -ForegroundColor Red
    return
}

try {
    $VMList = @(Import-Csv -LiteralPath $CsvPath -ErrorAction Stop)
}
catch {
    Write-Host "ERROR: Unable to read CSV: $_" -ForegroundColor Red
    return
}

if ($VMList.Count -eq 0) {
    Write-Host "ERROR: CSV contains no VM records." -ForegroundColor Red
    return
}

$RequiredColumns = @(
    "VMName",
    "ResourceGroupName",
    "SubscriptionId"
)

$ActualColumns = @($VMList[0].PSObject.Properties.Name)

$MissingColumns = @(
    $RequiredColumns | Where-Object { $_ -notin $ActualColumns }
)

if ($MissingColumns.Count -gt 0) {
    Write-Host "ERROR: Missing CSV columns: $($MissingColumns -join ', ')" -ForegroundColor Red
    return
}

# ------------------------------------------------------------
# STEP 2: PREPARE VM TARGETS
# ------------------------------------------------------------

$ValidRows = @(
    $VMList | Where-Object {
        -not [string]::IsNullOrWhiteSpace($_.VMName)
    }
)

if ($ValidRows.Count -eq 0) {
    Write-Host "ERROR: No valid VM names found in CSV." -ForegroundColor Red
    return
}

# Create case-insensitive metadata lookup.

$MetadataLookup = @{}

foreach ($Row in $ValidRows) {

    $Key = $Row.VMName.Trim().ToLowerInvariant()

    if (-not $MetadataLookup.ContainsKey($Key)) {

        $MetadataLookup[$Key] = $Row

    }
    else {

        Write-Warning "Duplicate VM name in CSV: $($Row.VMName). Using first matching record."

    }
}

$Computers = @(
    $ValidRows |
        ForEach-Object { $_.VMName.Trim() } |
        Sort-Object -Unique
)

Write-Host "`n======================================================" -ForegroundColor Cyan
Write-Host "       GHOSTED NETWORK ADAPTER INVENTORY" -ForegroundColor Cyan
Write-Host "======================================================" -ForegroundColor Cyan

Write-Host "CSV Records           : $($VMList.Count)" -ForegroundColor White
Write-Host "Valid VM Records      : $($ValidRows.Count)" -ForegroundColor White
Write-Host "Unique VM Targets     : $($Computers.Count)" -ForegroundColor White
Write-Host "WinRM Throttle Limit  : $ThrottleLimit" -ForegroundColor White

# ------------------------------------------------------------
# STEP 3: SCAN TARGET VMS USING WINRM
# ------------------------------------------------------------

Write-Host "`nStarting remote scan..." -ForegroundColor Cyan

$RemoteErrors = @()

$ScanResults = @(
    Invoke-Command `
        -ComputerName $Computers `
        -ThrottleLimit $ThrottleLimit `
        -ErrorAction SilentlyContinue `
        -ErrorVariable +RemoteErrors `
        -ScriptBlock {

            try {

                $GhostedNICs = @(
                    Get-PnpDevice -Class Net -ErrorAction Stop |
                        Where-Object {
                            $_.Status -eq "Unknown"
                        }
                )

                [PSCustomObject]@{
                    VMName      = $env:COMPUTERNAME
                    GhostedNICs = $GhostedNICs.Count
                    ScanStatus  = "Success"
                    ScanError   = ""
                }

            }
            catch {

                [PSCustomObject]@{
                    VMName      = $env:COMPUTERNAME
                    GhostedNICs = -1
                    ScanStatus  = "Device Enumeration Failed"
                    ScanError   = $_.Exception.Message
                }

            }

        }
)

# ------------------------------------------------------------
# STEP 4: MAP RESULTS TO CSV METADATA
# ------------------------------------------------------------

$ResultLookup = @{}

foreach ($Result in $ScanResults) {

    # PSComputerName is added by Invoke-Command and identifies
    # the remote target used for the connection.

    $TargetName = [string]$Result.PSComputerName

    if ([string]::IsNullOrWhiteSpace($TargetName)) {
        $TargetName = [string]$Result.VMName
    }

    $Key = $TargetName.Trim().ToLowerInvariant()

    $ResultLookup[$Key] = $Result

}

# Include unreachable VMs instead of silently excluding them.

$FinalReport = foreach ($Computer in $Computers) {

    $Key = $Computer.Trim().ToLowerInvariant()

    $Metadata = $MetadataLookup[$Key]

    if ($ResultLookup.ContainsKey($Key)) {

        $Result = $ResultLookup[$Key]

        [PSCustomObject]@{
            VMName            = $Computer
            GhostedNICs       = $Result.GhostedNICs
            ScanStatus        = $Result.ScanStatus
            ResourceGroupName = $Metadata.ResourceGroupName
            SubscriptionId    = $Metadata.SubscriptionId
            ScanError         = $Result.ScanError
        }

    }
    else {

        [PSCustomObject]@{
            VMName            = $Computer
            GhostedNICs       = $null
            ScanStatus        = "Unreachable / No Response"
            ResourceGroupName = $Metadata.ResourceGroupName
            SubscriptionId    = $Metadata.SubscriptionId
            ScanError         = "No successful WinRM response received."
        }

    }

}

# ------------------------------------------------------------
# STEP 5: CALCULATE SUMMARY
# ------------------------------------------------------------

$SuccessfulVMs = @(
    $FinalReport | Where-Object {
        $_.ScanStatus -eq "Success"
    }
)

$EnumerationFailures = @(
    $FinalReport | Where-Object {
        $_.ScanStatus -eq "Device Enumeration Failed"
    }
)

$UnreachableVMs = @(
    $FinalReport | Where-Object {
        $_.ScanStatus -eq "Unreachable / No Response"
    }
)

$AffectedVMs = @(
    $SuccessfulVMs | Where-Object {
        $_.GhostedNICs -gt 0
    }
)

$TotalGhosted = (
    $SuccessfulVMs |
        Measure-Object -Property GhostedNICs -Sum
).Sum

if ($null -eq $TotalGhosted) {
    $TotalGhosted = 0
}

# ------------------------------------------------------------
# STEP 6: DISPLAY ENVIRONMENT SUMMARY
# ------------------------------------------------------------

Write-Host "`n======================================================" -ForegroundColor Cyan
Write-Host "           TARGETED CSV SCAN SUMMARY" -ForegroundColor Cyan
Write-Host "======================================================" -ForegroundColor Cyan

Write-Host "VMs Listed in CSV       : $($Computers.Count)" -ForegroundColor White
Write-Host "Successfully Scanned   : $($SuccessfulVMs.Count)" -ForegroundColor Green
Write-Host "Unreachable VMs        : $($UnreachableVMs.Count)" -ForegroundColor Yellow
Write-Host "Enumeration Failures   : $($EnumerationFailures.Count)" -ForegroundColor Yellow
Write-Host "VMs With Ghosted NICs  : $($AffectedVMs.Count)" -ForegroundColor Yellow
Write-Host "Total Ghosted NICs     : $TotalGhosted" -ForegroundColor Red

Write-Host "======================================================" -ForegroundColor Cyan

# ------------------------------------------------------------
# STEP 7: DISPLAY TOP 25 AFFECTED VMS
# ------------------------------------------------------------

Write-Host "`nTOP 25 VMS WITH GHOSTED NETWORK ADAPTERS" -ForegroundColor Cyan

if ($AffectedVMs.Count -gt 0) {

    $AffectedVMs |
        Sort-Object GhostedNICs -Descending |
        Select-Object -First 25 VMName,
            GhostedNICs,
            ResourceGroupName,
            SubscriptionId |
        Format-Table -AutoSize

}
else {

    Write-Host "No ghosted NICs detected on successfully scanned VMs." -ForegroundColor Green

}

# ------------------------------------------------------------
# STEP 8: DISPLAY FAILED / UNREACHABLE VMS
# ------------------------------------------------------------

$FailedVMs = @(
    $FinalReport | Where-Object {
        $_.ScanStatus -ne "Success"
    }
)

if ($FailedVMs.Count -gt 0) {

    Write-Host "`nFAILED OR UNREACHABLE VM SCANS" -ForegroundColor Yellow

    $FailedVMs |
        Select-Object VMName,
            ScanStatus,
            ResourceGroupName,
            SubscriptionId,
            ScanError |
        Format-Table -AutoSize -Wrap

}

# ------------------------------------------------------------
# STEP 9: COMPLETION
# ------------------------------------------------------------

Write-Host "`n======================================================" -ForegroundColor Cyan
Write-Host "SCAN COMPLETED" -ForegroundColor Green
Write-Host "No Azure or VM configuration changes performed." -ForegroundColor Green
Write-Host "======================================================" -ForegroundColor Cyan

# ============================================================
# END OF SCRIPT
# ============================================================


# ============================================================
# AZURE AVD / VM GHOSTED NETWORK ADAPTER INVENTORY
# Azure CLI + WinRM | READ ONLY
# PowerShell 5.1 Compatible
# ============================================================

$TargetSubscriptions = @(
    "f9c819dc-4e16-4a04-8487-a734dcd880e1",
    "c59f3913-9612-4704-94f8-4a1d4f695b2f",
    "750da1a4-85cc-489e-b629-e512e0989c16",
    "56fb6a7f-8b65-4aba-90f0-b17a9dbb7b55",
    "df7de03e-1d71-4adf-8fd1-bd5791326a26",
    "0ecf5d7c-dbde-4eaf-8fb4-df512ccd5d3e",
    "752e53bf-6605-464f-ab75-bcead037561e",
    "ffabf3d6-ec1e-4626-b146-ec289cfe71ab",
    "3db8f6c1-6208-4799-b3b9-a931bb78ff10",
    "236d25ee-6a67-4d1e-b8a2-d18340cab27a",
    "5412eea3-1603-414b-9d0f-5c21a191c8f3",
    "20760d19-cc7b-4363-a17e-8a4ab8b6e9e5",
    "bf9eecc9-7f67-46e2-b3f8-268da59f1299",
    "7160cf79-3964-41af-8168-05a588c5f99b",
    "9ff6edd3-6b39-4d33-8776-56703398260c",
    "c4b71001-3b61-4bd7-af51-df7bfc0d9f1f"
)

$ThrottleLimit = 50
$Results = @()
$RemoteErrors = @()
$TargetVMs = @()

# ------------------------------------------------------------
# STEP 1: VERIFY AZURE CLI
# ------------------------------------------------------------

Write-Host "`nChecking Azure CLI authentication..." -ForegroundColor Cyan

try {
    $Account = az account show --output json 2>$null |
        ConvertFrom-Json

    if (-not $Account) {
        throw "Azure CLI authentication not available."
    }
}
catch {
    Write-Host "ERROR: Azure CLI login required. Run az login." -ForegroundColor Red
    return
}

# ------------------------------------------------------------
# STEP 2: DISCOVER RUNNING WINDOWS VMS
# ------------------------------------------------------------

Write-Host "`nDiscovering running Windows VMs across $($TargetSubscriptions.Count) subscriptions..." -ForegroundColor Cyan

foreach ($SubId in $TargetSubscriptions) {

    Write-Host "Checking subscription: $SubId" -ForegroundColor Gray

    try {
        $VMData = az vm list `
            --subscription $SubId `
            --show-details `
            --query "[?powerState=='VM running' && storageProfile.osDisk.osType=='Windows'].name" `
            --output json 2>$null

        if ($LASTEXITCODE -ne 0) {
            Write-Warning "Failed to retrieve VMs from subscription: $SubId"
            continue
        }

        $VMNames = @($VMData | ConvertFrom-Json)

        foreach ($VMName in $VMNames) {

            if ($VMName) {
                $TargetVMs += [PSCustomObject]@{
                    VMName        = $VMName
                    Subscription  = $SubId
                }
            }
        }
    }
    catch {
        Write-Warning "Subscription discovery error: $SubId - $_"
    }
}

# Preserve duplicate VM names across subscriptions.
$TargetVMs = @($TargetVMs)

Write-Host "`nTotal Running Windows VM Records: $($TargetVMs.Count)" -ForegroundColor Green

if ($TargetVMs.Count -eq 0) {
    Write-Host "No running Windows VMs found." -ForegroundColor Yellow
    return
}

# ------------------------------------------------------------
# STEP 3: PREPARE REMOTE SCAN
# ------------------------------------------------------------

# WinRM targets are hostnames.
# Duplicate hostnames are scanned only once because WinRM
# cannot reliably distinguish identical DNS names.

$Computers = @(
    $TargetVMs |
        Select-Object -ExpandProperty VMName -Unique
)

Write-Host "`nScanning $($Computers.Count) unique VM hostnames using WinRM..." -ForegroundColor Cyan

# ------------------------------------------------------------
# STEP 4: CHECK GHOSTED NETWORK ADAPTERS
# ------------------------------------------------------------

$Results = @(
    Invoke-Command `
        -ComputerName $Computers `
        -ThrottleLimit $ThrottleLimit `
        -ErrorAction SilentlyContinue `
        -ErrorVariable +RemoteErrors `
        -ScriptBlock {

            $GhostedNICs = @(
                Get-PnpDevice -Class Net -ErrorAction SilentlyContinue |
                    Where-Object {
                        $_.Status -eq 'Unknown'
                    }
            )

            [PSCustomObject]@{
                VMName      = $env:COMPUTERNAME
                GhostedNICs = $GhostedNICs.Count
            }
        }
)

# ------------------------------------------------------------
# STEP 5: CALCULATE SUMMARY
# ------------------------------------------------------------

$TotalVMs       = $Computers.Count
$ScannedVMs     = $Results.Count
$UnreachableVMs = $TotalVMs - $ScannedVMs

$AffectedVMs = @(
    $Results | Where-Object { $_.GhostedNICs -gt 0 }
)

$TotalGhosted = (
    $Results | Measure-Object -Property GhostedNICs -Sum
).Sum

if ($null -eq $TotalGhosted) {
    $TotalGhosted = 0
}

# ------------------------------------------------------------
# STEP 6: DISPLAY ENVIRONMENT SUMMARY
# ------------------------------------------------------------

Write-Host "`n"
Write-Host "======================================================" -ForegroundColor Cyan
Write-Host "         GHOSTED NETWORK ADAPTER REPORT" -ForegroundColor Cyan
Write-Host "======================================================" -ForegroundColor Cyan

Write-Host "Subscriptions Checked    : $($TargetSubscriptions.Count)" -ForegroundColor White
Write-Host "Running Windows VM Count: $TotalVMs" -ForegroundColor White
Write-Host "Successfully Scanned     : $ScannedVMs" -ForegroundColor Green
Write-Host "Unreachable VMs          : $UnreachableVMs" -ForegroundColor Yellow
Write-Host "VMs With Ghosted NICs    : $($AffectedVMs.Count)" -ForegroundColor Yellow
Write-Host "Total Ghosted NICs       : $TotalGhosted" -ForegroundColor Red

Write-Host "======================================================" -ForegroundColor Cyan

# ------------------------------------------------------------
# STEP 7: DISPLAY TOP 25 AFFECTED VMS
# ------------------------------------------------------------

Write-Host "`nTOP 25 VMs WITH GHOSTED NETWORK ADAPTERS" -ForegroundColor Cyan

$AffectedVMs |
    Sort-Object -Property GhostedNICs -Descending |
    Select-Object -First 25 VMName, GhostedNICs |
    Format-Table -AutoSize

# ------------------------------------------------------------
# STEP 8: DISPLAY REMOTING FAILURES
# ------------------------------------------------------------

if ($RemoteErrors.Count -gt 0) {

    Write-Host "`nWINRM / REMOTING ERRORS" -ForegroundColor Yellow

    $RemoteErrors |
        Select-Object -First 20 |
        ForEach-Object {
            Write-Host $_.ToString() -ForegroundColor DarkYellow
        }
}

Write-Host "`nScan completed." -ForegroundColor Green

# ============================================================
# END OF REPORT
# ============================================================

# Get local Hostname
$Hostname = $env:COMPUTERNAME

# 🤖 Resilient detection of the currently logged-in user session (Handles Active AND Disconnected 'Disc' states)
$UserSession = qwinsta | ForEach-Object {
    $Line = $_.Trim()
    if ($Line -match '^(?<session>[\w\-]+)?\s+(?<user>[a-zA-Z0-9_\-]+)\s+\d+\s+(?<state>Active|Disc)') {
        $FoundUser = $Matches['user'].Trim()
        $FoundState = $Matches['state'].Trim()
        if ($FoundUser -notin @('SYSTEM', 'NETWORK', 'SERVICE', 'USERNAME')) {
            # Create a custom tracker object to pass downstream
            [PSCustomObject]@{
                Username = $FoundUser
                State    = if ($FoundState -eq 'Disc') { 'Disconnected' } else { 'Active' }
            }
        }
    }
} | Select-Object -First 1

$User = $UserSession.Username
$SessionState = $UserSession.State

# --- FALLBACK PROTECTION ---
# If no active or disconnected user session is found right now, exit safely with the VM State block
if ([string]::IsNullOrWhiteSpace($User)) {
    $BootTime = (Get-CimInstance Win32_OperatingSystem).LastBootUpTime
    $UptimeSpan = (Get-Date) - $BootTime
    $UptimeDisplay = "{0} Hours, {1} Minutes" -f [math]::Floor($UptimeSpan.TotalHours), $UptimeSpan.Minutes
    
    # Calculate True Boot Time
    $Event6005 = Get-WinEvent -FilterHashtable @{LogName='System'; Id=6005; StartTime=$BootTime.AddMinutes(-1)} -MaxEvents 1 -ErrorAction SilentlyContinue
    $BootTimeDisplay = if ($Event6005) { "$([math]::Round(($Event6005.TimeCreated - $BootTime).TotalSeconds, 0)) Seconds" } else { 'Unknown' }

    Write-Host ""
    Write-Host '============================================================' -ForegroundColor Cyan
    Write-Host 'CURRENT VM STATUS' -ForegroundColor Cyan
    Write-Host '============================================================' -ForegroundColor Cyan
    Write-Host "  Hostname           : $Hostname"
    Write-Host "  Last Boot Time     : $BootTime"
    Write-Host "  VM Boot Time Taken : $BootTimeDisplay"
    Write-Host "  Uptime             : $UptimeDisplay"
    Write-Host ""
    Write-Host '[✓] CONFIRMED: No active or disconnected AVD sessions detected on this machine.' -ForegroundColor Green
    Write-Host '============================================================' -ForegroundColor Cyan
    Exit 0
}

# --- PROCESS ACTIVE/DISCONNECTED USER EVENT LOG ENTRY ---
$BootTime = (Get-CimInstance Win32_OperatingSystem).LastBootUpTime
$UptimeSpan = (Get-Date) - $BootTime
$UptimeDisplay = "{0} Hours, {1} Minutes" -f [math]::Floor($UptimeSpan.TotalHours), $UptimeSpan.Minutes

# Calculate VM Boot Performance time (Event 6005)
$Event6005 = Get-WinEvent -FilterHashtable @{
    LogName   = 'System'
    Id        = 6005
    StartTime = $BootTime.AddMinutes(-1)
} -MaxEvents 1 -ErrorAction SilentlyContinue

$BootTimeDisplay = if ($Event6005) { "$([math]::Round(($Event6005.TimeCreated - $BootTime).TotalSeconds, 0)) Seconds" } else { 'Log Missing' }

Write-Host ""
Write-Host '============================================================' -ForegroundColor Cyan
Write-Host "AVD AUDIT REPORT FOR DETECTED USER: $User ($SessionState)" -ForegroundColor Yellow
Write-Host '============================================================' -ForegroundColor Cyan

# Collect Events for the auto-discovered user
$Events = Get-WinEvent -FilterHashtable @{
    LogName   = 'Microsoft-Windows-TerminalServices-LocalSessionManager/Operational'
    StartTime = $BootTime
    Id        = 21, 22, 41, 42
} -ErrorAction SilentlyContinue | Where-Object { $_.Message -match $User } | Sort-Object TimeCreated

$StartTime = $null
$LogonTime = $null
$SummaryGenerated = $false

foreach ($Event in $Events) {
    switch ($Event.Id) {
        41 { $StartTime = $Event.TimeCreated }
        21 { $LogonTime = $Event.TimeCreated }
        22 {
            if ($StartTime -and $LogonTime -and ($StartTime.Date -eq $Event.TimeCreated.Date)) {
                $SummaryGenerated = $true
                $AuthenticationSec = [math]::Round(($LogonTime - $StartTime).TotalSeconds, 0)
                $DesktopLoadSec     = [math]::Round(($Event.TimeCreated - $LogonTime).TotalSeconds, 0)
                $TotalLoginSec      = [math]::Round(($Event.TimeCreated - $StartTime).TotalSeconds, 0)
                $MinutesSinceBoot   = [math]::Round(($StartTime - $BootTime).TotalMinutes, 1)

                if ($MinutesSinceBoot -lt 5) { $VMState = 'VM likely started due to user connection' }
                elseif ($MinutesSinceBoot -lt 15) { $VMState = 'VM recently started before user login' }
                else { $VMState = 'VM already available before user login' }

                ([PSCustomObject]@{
                    Hostname          = $Hostname
                    TargetUser        = $User
                    SessionState      = $SessionState
                    VMLastBoot        = $BootTime
                    VM_BootTimeTaken  = $BootTimeDisplay
                    VMState           = $VMState
                    LoginStarted      = $StartTime
                    LogonSucceeded    = $LogonTime
                    DesktopReady      = $Event.TimeCreated
                    AuthenticationSec = $AuthenticationSec
                    DesktopLoadSec    = $DesktopLoadSec
                    TotalLoginSec     = $TotalLoginSec
                }) | Format-List
                Write-Host '------------------------------------------------------------'
                $StartTime = $null; $LogonTime = $null
            }
        }
    }
}

if (-not $SummaryGenerated) {
    Write-Host 'CURRENT VM STATUS:' -ForegroundColor Cyan
    Write-Host "  Hostname           : $Hostname"
    Write-Host "  Target User        : $User"
    Write-Host "  Current State      : $SessionState"
    Write-Host "  Last Boot Time     : $BootTime"
    Write-Host "  VM Boot Time Taken : $BootTimeDisplay"
    Write-Host "  Uptime             : $UptimeDisplay"
    Write-Host ""
    Write-Host "[-] NOTICE: User '$User' is listed as $SessionState, but a complete matching logon footprint (Events 41->21->22) does not exist inside this specific boot cycle." -ForegroundColor Yellow
    Write-Host '============================================================' -ForegroundColor Cyan
}

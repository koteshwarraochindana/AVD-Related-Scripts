Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
[System.Windows.Forms.Application]::EnableVisualStyles()

# Suppress Azure PowerShell survey prompts and breaking-change banners in ISE
Update-AzConfig -DisplaySurveyMessage $false -DisplayBreakingChangeWarning $false -AppliesTo Az -Scope Process -ErrorAction SilentlyContinue | Out-Null

# ===========================
# 1. DATA COLLECTION
# ===========================
$inputCsv = "\\smb.waunas23f.hcscint.net\infrastructure\MSP_VTT\AVD-Related-Scripts\ManuallyDeleteAVD\VM_List.csv"

Write-Host "Reading CSV file: $inputCsv" -ForegroundColor Cyan

if (-not (Test-Path $inputCsv)) {
    Write-Host "ERROR: CSV file not found at $inputCsv" -ForegroundColor Red
    return
}

# Import CSV and clean any accidental spaces in column headers
$rawCsv = Import-Csv -Path $inputCsv
$cleanedRows = @(foreach ($r in $rawCsv) {
    $cleanObj = [ordered]@{}
    foreach ($prop in $r.PSObject.Properties) {
        $cleanObj[$prop.Name.Trim()] = if ($null -ne $prop.Value) { $prop.Value.Trim() } else { "" }
    }
    [PSCustomObject]$cleanObj
})

$vmList = @($cleanedRows | Where-Object { 
    -not [string]::IsNullOrWhiteSpace($_.VMName) -and -not [string]::IsNullOrWhiteSpace($_.SubscriptionId) 
})

if ($vmList.Count -eq 0) {
    Write-Host "ERROR: No valid rows found. Ensure CSV headers are 'VMName' and 'SubscriptionId'." -ForegroundColor Red
    [System.Windows.Forms.MessageBox]::Show(
        "No valid VM entries were found in:`n$inputCsv`n`nPlease verify the CSV is not empty and has 'VMName' and 'SubscriptionId' headers.",
        "CSV Empty or Invalid",
        [System.Windows.Forms.MessageBoxButtons]::OK,
        [System.Windows.Forms.MessageBoxIcon]::Error
    ) | Out-Null
    return
}

Write-Host "Loaded $($vmList.Count) VM(s) from CSV. Opening confirmation window..." -ForegroundColor Yellow

# ===========================
# 2. SINGLE CUSTOM CONFIRMATION POPUP
# ===========================
$form = New-Object System.Windows.Forms.Form
$form.Text = "Confirm Permanent AVD VM Deletion"
$form.Size = New-Object System.Drawing.Size(760, 460)
$form.StartPosition = "CenterScreen"
$form.FormBorderStyle = "FixedDialog"
$form.MaximizeBox = $false
$form.MinimizeBox = $false
$form.TopMost = $true
$form.Add_Shown({ $form.Activate() })

# Top Summary Label
$lblHeader = New-Object System.Windows.Forms.Label
$lblHeader.Text = "Total VMs found in CSV for deletion: $($vmList.Count)`nReview the VM Name, Resource Group, and Subscription ID below before proceeding:"
$lblHeader.Font = New-Object System.Drawing.Font("Segoe UI", 10, [System.Drawing.FontStyle]::Bold)
$lblHeader.ForeColor = [System.Drawing.Color]::DarkRed
$lblHeader.Location = New-Object System.Drawing.Point(15, 15)
$lblHeader.Size = New-Object System.Drawing.Size(710, 45)
$form.Controls.Add($lblHeader)

# DataGridView Table
$grid = New-Object System.Windows.Forms.DataGridView
$grid.Location = New-Object System.Drawing.Point(15, 68)
$grid.Size = New-Object System.Drawing.Size(715, 290)
$grid.ReadOnly = $true
$grid.AllowUserToAddRows = $false
$grid.AllowUserToDeleteRows = $false
$grid.RowHeadersVisible = $false
$grid.AutoSizeColumnsMode = "Fill"
$grid.SelectionMode = "FullRowSelect"

$grid.Columns.Add("VMName", "VM Name") | Out-Null
$grid.Columns.Add("ResourceGroup", "Resource Group") | Out-Null
$grid.Columns.Add("SubscriptionId", "Subscription ID") | Out-Null

foreach ($row in $vmList) {
    $rgDisplay = if ($row.ResourceGroupName) { $row.ResourceGroupName } elseif ($row.ResourceGroup) { $row.ResourceGroup } else { "(Auto-Detect)" }
    $grid.Rows.Add($row.VMName, $rgDisplay, $row.SubscriptionId) | Out-Null
}
$form.Controls.Add($grid)

# Proceed / Delete Button
$btnYes = New-Object System.Windows.Forms.Button
$btnYes.Text = "Yes, Delete $($vmList.Count) VM(s)"
$btnYes.Font = New-Object System.Drawing.Font("Segoe UI", 9.5, [System.Drawing.FontStyle]::Bold)
$btnYes.BackColor = [System.Drawing.Color]::Firebrick
$btnYes.ForeColor = [System.Drawing.Color]::White
$btnYes.FlatStyle = "Flat"
$btnYes.Location = New-Object System.Drawing.Point(450, 372)
$btnYes.Size = New-Object System.Drawing.Size(165, 35)
$btnYes.DialogResult = [System.Windows.Forms.DialogResult]::Yes
$form.Controls.Add($btnYes)

# Cancel Button
$btnCancel = New-Object System.Windows.Forms.Button
$btnCancel.Text = "Cancel"
$btnCancel.Font = New-Object System.Drawing.Font("Segoe UI", 9.5)
$btnCancel.Location = New-Object System.Drawing.Point(625, 372)
$btnCancel.Size = New-Object System.Drawing.Size(105, 35)
$btnCancel.DialogResult = [System.Windows.Forms.DialogResult]::Cancel
$form.CancelButton = $btnCancel
$form.Controls.Add($btnCancel)

$dialogResult = $form.ShowDialog()
$form.Dispose()

if ($dialogResult -ne [System.Windows.Forms.DialogResult]::Yes) {
    Write-Host "Operation cancelled by user. No VMs were modified or deleted." -ForegroundColor Red
    return
}

# ===========================
# 3. AZURE LOGIN
# ===========================
$firstSubId = ($vmList | Select-Object -First 1).SubscriptionId
Write-Host "`nAuthenticating to Azure..." -ForegroundColor Cyan
Connect-AzAccount -Subscription $firstSubId -ErrorAction Stop | Out-Null

Write-Host "`n--- Starting Deletion Process for $($vmList.Count) VMs ---" -ForegroundColor White

# ===========================
# 4. PROCESSING BY SUBSCRIPTION (FAST DIRECT LOOKUP)
# ===========================
$groupedBySub = $vmList | Group-Object -Property SubscriptionId

$results = foreach ($subGroup in $groupedBySub) {
    $subId = $subGroup.Name
    
    if ((Get-AzContext).Subscription.Id -ne $subId) {
        Write-Host "`nSwitching to Subscription: $subId ($($subGroup.Count) VMs)" -ForegroundColor Magenta
        try {
            Set-AzContext -SubscriptionId $subId -ErrorAction Stop | Out-Null
        } catch {
            Write-Host "Failed to switch to Subscription $subId : $($_.Exception.Message)" -ForegroundColor Red
            foreach ($row in $subGroup.Group) {
                [PSCustomObject]@{
                    SubscriptionId = $subId
                    VMName         = $row.VMName
                    ResourceGroup  = "N/A"
                    ActionTaken    = "Skipped (Subscription Access Error)"
                }
            }
            continue
        }
    } else {
        Write-Host "`nProcessing Subscription: $subId ($($subGroup.Count) VMs)" -ForegroundColor Magenta
    }

    foreach ($row in $subGroup.Group) {
        $vmName = $row.VMName
        $csvRg = if ($row.ResourceGroupName) { $row.ResourceGroupName } elseif ($row.ResourceGroup) { $row.ResourceGroup } else { $null }
        
        $rgLabel = if ($csvRg) { " | RG: $csvRg" } else { "" }
        Write-Host "`n--------------------------------------------------" -ForegroundColor Gray
        Write-Host "VM: $vmName$rgLabel" -ForegroundColor Cyan

        # Query ONLY this exact VM directly
        if ($csvRg) {
            $foundVm = Get-AzVM -ResourceGroupName $csvRg -Name $vmName -ErrorAction SilentlyContinue
        } else {
            $foundVm = Get-AzVM -Name $vmName -ErrorAction SilentlyContinue | Select-Object -First 1
        }

        if (-not $foundVm) {
            Write-Host "VM - $vmName - [NOT FOUND]" -ForegroundColor Red
            [PSCustomObject]@{ 
                SubscriptionId = $subId
                VMName         = $vmName
                ResourceGroup  = if ($csvRg) { $csvRg } else { "N/A" }
                ActionTaken    = "Skipped (Not Found)" 
            }
            continue
        }

        $rg = $foundVm.ResourceGroupName
        $actionStatus = "Success"

        try {
            $osDiskId = $foundVm.StorageProfile.OsDisk.ManagedDisk.Id
            $nicIds = $foundVm.NetworkProfile.NetworkInterfaces.Id

            # 1. Delete VM
            Remove-AzVM -ResourceGroupName $rg -Name $vmName -Force -ErrorAction Stop
            Write-Host "VM - $vmName - [DELETED]" -ForegroundColor Yellow

            # 2. Delete NICs
            foreach ($nicId in $nicIds) {
                $nicName = $nicId.Split('/')[-1]
                Remove-AzResource -ResourceId $nicId -Force -ErrorAction SilentlyContinue
                Write-Host "NIC - $nicName - [DELETED]" -ForegroundColor Yellow
            }

            # 3. Delete OS Disk
            if ($osDiskId) {
                $diskName = $osDiskId.Split('/')[-1]
                Remove-AzResource -ResourceId $osDiskId -Force -ErrorAction SilentlyContinue
                Write-Host "Disk - $diskName - [DELETED]" -ForegroundColor Yellow
            }

            $actionStatus = "VM, NIC, and Disk Deleted"
        } catch {
            Write-Host "Error processing $vmName : $($_.Exception.Message)" -ForegroundColor Red
            $actionStatus = "Error: $($_.Exception.Message)"
        }

        [PSCustomObject]@{
            SubscriptionId = $subId
            VMName         = $vmName
            ResourceGroup  = $rg
            ActionTaken    = $actionStatus
        }
    }
}

Write-Host "`n--------------------------------------------------" -ForegroundColor Gray

# ===========================
# 5. EXPORT REPORT & COMPLETION POPUP
# ===========================
$outputPath = "C:\Temp\VM_Deletion_Report.csv"
if (-not (Test-Path "C:\Temp")) { New-Item -ItemType Directory -Path "C:\Temp" -Force | Out-Null }

$results | Export-Csv -Path $outputPath -NoTypeInformation -Force
Write-Host "`nProcess Complete. Summary exported to $outputPath" -ForegroundColor Green

[System.Windows.Forms.MessageBox]::Show(
    "Deletion process complete for $($vmList.Count) VM(s).`n`nReport saved to:`n$outputPath",
    "AVD Cleanup Complete",
    [System.Windows.Forms.MessageBoxButtons]::OK,
    [System.Windows.Forms.MessageBoxIcon]::Information
) | Out-Null

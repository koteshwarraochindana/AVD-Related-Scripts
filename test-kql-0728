@echo off
title Azure PowerShell (VM Cleanup Modules) Offline Installer
color 0B
echo ============================================================================
echo   Installing Required Azure PowerShell Modules (Accounts, Compute, Resources)
echo   Source: \\smb.waunas23f.hcscint.net\infrastructure\MSP_VTT\AVD-Related-Scripts\AzOfflineModules
echo   Please do not close this window. This takes less than 1 minute.
echo ============================================================================
echo.

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ^
  "$Source = '\\smb.waunas23f.hcscint.net\infrastructure\MSP_VTT\AVD-Related-Scripts\AzOfflineModules';" ^
  "$Targets = @(\"$env:USERPROFILE\Documents\WindowsPowerShell\Modules\", \"$env:USERPROFILE\Documents\PowerShell\Modules\");" ^
  "foreach ($Target in $Targets) {" ^
  "    Write-Host \"Copying modules to $Target...\" -ForegroundColor Cyan;" ^
  "    New-Item -ItemType Directory -Path $Target -Force | Out-Null;" ^
  "    robocopy $Source $Target /E /MT:8 /R:2 /W:2 /NFL /NDL /NJH /NJS | Out-Null;" ^
  "}" ^
  "Write-Host \"`nConfiguring PowerShell ISE compatibility...\" -ForegroundColor Yellow;" ^
  "Update-AzConfig -EnableLoginByWam $false | Out-Null;" ^
  "Write-Host \"Verifying installation...\" -ForegroundColor Yellow;" ^
  "$Installed = Get-Module -ListAvailable -Name Az.Accounts, Az.Compute, Az.Resources;" ^
  "if ($Installed.Count -ge 3) {" ^
  "    Write-Host \"SUCCESS! Required Azure modules are installed and ISE is configured.\" -ForegroundColor Green;" ^
  "} else {" ^
  "    Write-Host \"WARNING: Could not verify all 3 modules. Check network share access.\" -ForegroundColor Red;" ^
  "}"

echo.
pause

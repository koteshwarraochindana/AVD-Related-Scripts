#Requires -Version 5.1
#Requires -Modules Az.Accounts, Az.Compute

<#
.SYNOPSIS
    Parallel ghosted network adapter cleanup using Azure VM Run Command.

.DESCRIPTION
    1. Inventories all VMs in the input CSV.
    2. Immediately launches cleanup jobs for VMs already running.
    3. Starts stopped/deallocated VMs while running-VM cleanup jobs continue.
    4. After all successful start requests finish, waits 5 minutes.
    5. Launches cleanup for successfully started VMs and VMs already starting.
    6. Waits for all cleanup jobs and exports one consolidated CSV.

.NOTES
    PowerShell 5.1 compatible.
    Uses Start-Job; each worker imports the saved Az context.
    Run initially against a small test CSV.
#>

[CmdletBinding()]
param(
    [string]$OnlyVM = "",
    [switch]$RestorePowerState,
    [switch]$Force
)

# ======================== CONFIGURATION ========================

$CsvPath           = "C:\Temp\Ghost\Remove-nics\avd_hosts1.csv"
$CleanupScriptPath = "C:\Temp\Ghost\Windows_GhostedNIC_Removal.ps1"
$OutputPath        = "C:\Temp\Ghost\Remove-nics\GhostedNIC_Cleanup_Results.csv"

$MaxParallelJobs   = 20
$BootWaitSeconds   = 30
$AgentTimeoutMin   = 10
$AgentPollSeconds  = 15

$ErrorActionPreference = "Stop"

$TempScript  = Join-Path $env:TEMP "GhostedNIC_Cleanup_Remote.ps1"
$ContextPath = Join-Path $env:TEMP ("GhostedNIC_AzContext_{0}.json" -f [guid]::NewGuid().ToString("N"))

$AllResults = New-Object System.Collections.ArrayList

Write-Host ""
Write-Host "======================================================" -ForegroundColor Cyan
Write-Host "       PARALLEL GHOSTED NIC CLEANUP"
Write-Host "       AZURE VM RUN COMMAND"
Write-Host "======================================================" -ForegroundColor Cyan

# ======================== VALIDATE INPUT ========================

if (!(Test-Path -LiteralPath $CsvPath)) {
    throw "CSV file not found: $CsvPath"
}

if (!(Test-Path -LiteralPath $CleanupScriptPath)) {
    throw "Microsoft cleanup script not found: $CleanupScriptPath"
}

$VMList = @(Import-Csv -LiteralPath $CsvPath)

if ($VMList.Count -eq 0) {
    throw "CSV contains no VM records."
}

$RequiredColumns = @("VMName", "ResourceGroupName", "SubscriptionId")
foreach ($Column in $RequiredColumns) {
    if ($Column -notin $VMList[0].PSObject.Properties.Name) {
        throw "Missing required CSV column: $Column"
    }
}

$VMList = @($VMList | Where-Object {
    ![string]::IsNullOrWhiteSpace($_.VMName) -and
    ![string]::IsNullOrWhiteSpace($_.ResourceGroupName) -and
    ![string]::IsNullOrWhiteSpace($_.SubscriptionId)
})

$VMList = @($VMList | Sort-Object SubscriptionId, ResourceGroupName, VMName -Unique)

if (![string]::IsNullOrWhiteSpace($OnlyVM)) {
    $VMList = @($VMList | Where-Object {
        $_.VMName.Trim() -eq $OnlyVM.Trim()
    })

    if ($VMList.Count -eq 0) {
        throw "VM '$OnlyVM' not found in CSV."
    }
}

Write-Host "Total VMs      : $($VMList.Count)"
Write-Host "Parallel limit : $MaxParallelJobs"
Write-Host "Boot wait      : $BootWaitSeconds seconds"
Write-Host ""

# ======================== CONFIRMATION ========================

if (!$Force) {
    Write-Host "WARNING: The Microsoft cleanup script may remove ALL non-present devices, not only NICs." -ForegroundColor Yellow
    Write-Host "Stopped/deallocated VMs will be started. Azure compute charges may apply." -ForegroundColor Yellow

    if ($RestorePowerState) {
        Write-Host "Successfully cleaned VMs started by this script will be deallocated afterward." -ForegroundColor Yellow
    }
    else {
        Write-Host "VMs started by this script will remain running." -ForegroundColor Yellow
    }

    $Answer = Read-Host "Type YES to continue"
    if ($Answer -cne "YES") {
        Write-Host "Cancelled. No changes made." -ForegroundColor Green
        return
    }
}

# ======================== AZURE AUTHENTICATION ========================

$Context = Get-AzContext
if (!$Context) {
    Connect-AzAccount | Out-Null
}

$Context = Get-AzContext
if (!$Context) {
    throw "Azure authentication failed."
}

Save-AzContext -Path $ContextPath -Force | Out-Null
Write-Host "Azure authentication successful." -ForegroundColor Green

# ======================== BUILD REMOTE SCRIPT ========================

$Header = @'
$ErrorActionPreference = "Continue"

try {
    $PreGhosts = @(Get-PnpDevice -Class Net -ErrorAction Stop |
        Where-Object { $_.Present -eq $false }).Count
}
catch { $PreGhosts = -1 }

try {
    $PreAdapters = @(Get-NetAdapter -ErrorAction Stop).Count
}
catch { $PreAdapters = -1 }
'@

$Footer = @'
try {
    $PostGhosts = @(Get-PnpDevice -Class Net -ErrorAction Stop |
        Where-Object { $_.Present -eq $false }).Count
}
catch { $PostGhosts = -1 }

try {
    $PostAdapters = @(Get-NetAdapter -ErrorAction Stop).Count
}
catch { $PostAdapters = -1 }

Write-Output ("GHOSTED_NIC_CLEANUP|Done|{0}|{1}|{2}|{3}|{4}" -f `
    $env:COMPUTERNAME,
    $PreGhosts,
    $PostGhosts,
    $PreAdapters,
    $PostAdapters)
'@

$MsScript = Get-Content -LiteralPath $CleanupScriptPath -Raw
$Combined = $Header + "`r`n" + $MsScript + "`r`n" + $Footer

[System.IO.File]::WriteAllText(
    $TempScript,
    $Combined,
    (New-Object System.Text.UTF8Encoding($false))
)

# ======================== JOB QUEUE FUNCTIONS ========================

function New-JobQueue {
    param(
        [array]$Items,
        [scriptblock]$Worker,
        [string]$Name,
        [bool]$Restore = $false
    )

    return @{
        Items       = @($Items)
        Next        = 0
        Active      = New-Object System.Collections.ArrayList
        Results     = New-Object System.Collections.ArrayList
        Worker      = $Worker
        Name        = $Name
        Restore     = $Restore
        ContextPath = $ContextPath
        ScriptPath  = $TempScript
    }
}

function Start-QueuedJobs {
    param(
        $Queue,
        [int]$Throttle
    )

    while (
        $Queue.Next -lt $Queue.Items.Count -and
        $Queue.Active.Count -lt $Throttle
    ) {
        $Item = $Queue.Items[$Queue.Next]
        $Queue.Next++

        $Job = Start-Job `
            -Name ([string]$Item.VMName) `
            -ScriptBlock $Queue.Worker `
            -ArgumentList $Item, $Queue.ContextPath, $Queue.ScriptPath, $Queue.Restore

        [void]$Queue.Active.Add($Job)
    }
}

function Receive-QueuedJobs {
    param($Queue)

    $Completed = @($Queue.Active | Where-Object {
        $_.State -in @("Completed", "Failed", "Stopped")
    })

    foreach ($Job in $Completed) {
        $JobOutput = @(Receive-Job -Job $Job -ErrorAction SilentlyContinue)

        if ($JobOutput.Count -gt 0) {
            foreach ($Entry in $JobOutput) {
                [void]$Queue.Results.Add($Entry)
            }
        }
        else {
            [void]$Queue.Results.Add([PSCustomObject]@{
                VMName            = $Job.Name
                ResourceGroupName = ""
                SubscriptionId    = ""
                PowerBefore       = "Unknown"
                StartedByScript   = $false
                PoweredOffAfter   = $false
                GhostedBefore     = $null
                GhostedAfter      = $null
                AdaptersBefore    = $null
                AdaptersAfter     = $null
                Minutes           = 0
                CleanupStatus     = "Background Job Failed"
                Error             = "Job returned no output. Job state: $($Job.State)"
            })
        }

        Remove-Job -Job $Job -Force -ErrorAction SilentlyContinue
        [void]$Queue.Active.Remove($Job)
    }
}

function Test-QueueComplete {
    param($Queue)

    return (
        $Queue.Next -ge $Queue.Items.Count -and
        $Queue.Active.Count -eq 0
    )
}

function Pump-Queues {
    param(
        [array]$Queues,
        [int]$Throttle
    )

    foreach ($Queue in $Queues) {
        Start-QueuedJobs -Queue $Queue -Throttle $Throttle
        Receive-QueuedJobs -Queue $Queue
    }
}

function Wait-QueueGroup {
    param(
        [array]$Queues,
        [int]$Throttle
    )

    while ($true) {
        Pump-Queues -Queues $Queues -Throttle $Throttle

        $Incomplete = @($Queues | Where-Object {
            !(Test-QueueComplete -Queue $_)
        })

        if ($Incomplete.Count -eq 0) {
            break
        }

        Start-Sleep -Seconds 2
    }
}

# ======================== INVENTORY WORKER ========================

$InventoryWorker = {
    param($VM, $ContextFile, $UnusedScript, $UnusedRestore)

    try {
        Import-Module Az.Accounts -ErrorAction Stop
        Import-Module Az.Compute -ErrorAction Stop
        Import-AzContext -Path $ContextFile -ErrorAction Stop | Out-Null

        Set-AzContext -SubscriptionId $VM.SubscriptionId -ErrorAction Stop | Out-Null

        $S = Get-AzVM `
            -ResourceGroupName $VM.ResourceGroupName `
            -Name $VM.VMName `
            -Status `
            -ErrorAction Stop

        $Code = ($S.Statuses |
            Where-Object { $_.Code -like "PowerState/*" } |
            Select-Object -First 1).Code

        $Power = if ($Code) { $Code -replace '^PowerState/', '' } else { "unknown" }

        [PSCustomObject]@{
            VMName            = $VM.VMName
            ResourceGroupName = $VM.ResourceGroupName
            SubscriptionId    = $VM.SubscriptionId
            PowerBefore       = $Power
            ResultStatus      = "Success"
            Error             = ""
        }
    }
    catch {
        [PSCustomObject]@{
            VMName            = $VM.VMName
            ResourceGroupName = $VM.ResourceGroupName
            SubscriptionId    = $VM.SubscriptionId
            PowerBefore       = "Unknown"
            ResultStatus      = "Inventory Failed"
            Error             = $_.Exception.Message
        }
    }
}

# ======================== PHASE 1: INVENTORY ========================

Write-Host ""
Write-Host "PHASE 1: INVENTORY - Checking VM power states in parallel" -ForegroundColor Cyan

$InventoryQueue = New-JobQueue -Items $VMList -Worker $InventoryWorker -Name "Inventory"
Wait-QueueGroup -Queues @($InventoryQueue) -Throttle $MaxParallelJobs

$Inventory = @($InventoryQueue.Results)

$RunningVMs = @($Inventory | Where-Object { $_.PowerBefore -eq "running" })
$StoppedVMs = @($Inventory | Where-Object { $_.PowerBefore -in @("stopped", "deallocated") })
$StartingVMs = @($Inventory | Where-Object { $_.PowerBefore -eq "starting" })
$SkippedVMs = @($Inventory | Where-Object {
    $_.PowerBefore -notin @("running", "stopped", "deallocated", "starting")
})

Write-Host ""
Write-Host "Running VMs   : $($RunningVMs.Count)" -ForegroundColor Green
Write-Host "Stopped VMs   : $($StoppedVMs.Count)" -ForegroundColor Yellow
Write-Host "Starting VMs  : $($StartingVMs.Count)" -ForegroundColor Yellow
Write-Host "Other/Unknown : $($SkippedVMs.Count)" -ForegroundColor Red

# ======================== CLEANUP WORKER ========================

$CleanupWorker = {
    param($VM, $ContextFile, $RemoteScript, $DoRestore)

    $Watch = [System.Diagnostics.Stopwatch]::StartNew()

    try {
        Import-Module Az.Accounts -ErrorAction Stop
        Import-Module Az.Compute -ErrorAction Stop
        Import-AzContext -Path $ContextFile -ErrorAction Stop | Out-Null

        Set-AzContext -SubscriptionId $VM.SubscriptionId -ErrorAction Stop | Out-Null

        # Wait for the VM to be running and the Azure VM Agent to be ready.
        $Deadline = (Get-Date).AddMinutes(10)
        $AgentReady = $false
        $PowerCode = $null

        while ((Get-Date) -lt $Deadline) {
            $S = Get-AzVM `
                -ResourceGroupName $VM.ResourceGroupName `
                -Name $VM.VMName `
                -Status `
                -ErrorAction Stop

            $PowerCode = ($S.Statuses |
                Where-Object { $_.Code -like "PowerState/*" } |
                Select-Object -First 1).Code

            $AgentReady = $false

            if ($S.VMAgent -and $S.VMAgent.Statuses) {
                $AgentReady = [bool](
                    $S.VMAgent.Statuses | Where-Object {
                        $_.DisplayStatus -match "Ready" -or
                        $_.Code -match "ProvisioningState/succeeded"
                    } | Select-Object -First 1
                )
            }

            if ($PowerCode -eq "PowerState/running" -and $AgentReady) {
                break
            }

            Start-Sleep -Seconds 15
        }

        if ($PowerCode -ne "PowerState/running" -or !$AgentReady) {
            throw "VM or guest agent did not become ready within 10 minutes."
        }

        $Response = Invoke-AzVMRunCommand `
            -ResourceGroupName $VM.ResourceGroupName `
            -VMName $VM.VMName `
            -CommandId "RunPowerShellScript" `
            -ScriptPath $RemoteScript `
            -ErrorAction Stop

        $Message = ($Response.Value | ForEach-Object { $_.Message }) -join "`n"

        $Marker = [regex]::Match(
            $Message,
            '(?m)GHOSTED_NIC_CLEANUP\|Done\|[^\r\n]+'
        )

        if (!$Marker.Success) {
            $Snippet = $Message
            if ($Snippet.Length -gt 1000) {
                $Snippet = $Snippet.Substring($Snippet.Length - 1000)
            }
            throw "Cleanup result marker missing. Output: $Snippet"
        }

        $P = $Marker.Value -split '\|'
        if ($P.Count -lt 7) {
            throw "Invalid cleanup result marker."
        }

        $GhostBefore    = [int]$P[3]
        $GhostAfter     = [int]$P[4]
        $AdaptersBefore = [int]$P[5]
        $AdaptersAfter  = [int]$P[6]

        $Status = "Success"

        if (
            $AdaptersBefore -ge 0 -and
            $AdaptersAfter -ge 0 -and
            $AdaptersAfter -lt $AdaptersBefore
        ) {
            $Status = "WARNING - Adapter count dropped"
        }

        $PoweredOff = $false
        $ErrorText = ""

        if ($VM.StartedByScript -and $DoRestore -and $Status -eq "Success") {
            try {
                Stop-AzVM `
                    -ResourceGroupName $VM.ResourceGroupName `
                    -Name $VM.VMName `
                    -Force `
                    -ErrorAction Stop | Out-Null

                $PoweredOff = $true
            }
            catch {
                $ErrorText = "Cleanup succeeded, but deallocation failed: " +
                    $_.Exception.Message
            }
        }

        [PSCustomObject]@{
            VMName            = $VM.VMName
            ResourceGroupName = $VM.ResourceGroupName
            SubscriptionId    = $VM.SubscriptionId
            PowerBefore       = $VM.PowerBefore
            StartedByScript   = $VM.StartedByScript
            PoweredOffAfter   = $PoweredOff
            GhostedBefore     = $GhostBefore
            GhostedAfter      = $GhostAfter
            AdaptersBefore    = $AdaptersBefore
            AdaptersAfter     = $AdaptersAfter
            Minutes           = [math]::Round($Watch.Elapsed.TotalMinutes, 2)
            CleanupStatus     = $Status
            Error             = $ErrorText
        }
    }
    catch {
        [PSCustomObject]@{
            VMName            = $VM.VMName
            ResourceGroupName = $VM.ResourceGroupName
            SubscriptionId    = $VM.SubscriptionId
            PowerBefore       = $VM.PowerBefore
            StartedByScript   = $VM.StartedByScript
            PoweredOffAfter   = $false
            GhostedBefore     = $null
            GhostedAfter      = $null
            AdaptersBefore    = $null
            AdaptersAfter     = $null
            Minutes           = [math]::Round($Watch.Elapsed.TotalMinutes, 2)
            CleanupStatus     = "Run Command Failed"
            Error             = $_.Exception.Message
        }
    }
}

# ======================== PHASE 2: LAUNCH RUNNING VM CLEANUP ========================

$RunningCleanupItems = @(
    foreach ($VM in $RunningVMs) {
        [PSCustomObject]@{
            VMName            = $VM.VMName
            ResourceGroupName = $VM.ResourceGroupName
            SubscriptionId    = $VM.SubscriptionId
            PowerBefore       = "running"
            StartedByScript   = $false
        }
    }
)

$RunningCleanupQueue = New-JobQueue `
    -Items $RunningCleanupItems `
    -Worker $CleanupWorker `
    -Name "RunningCleanup" `
    -Restore ([bool]$RestorePowerState)

Write-Host ""
Write-Host "PHASE 2: LAUNCHING CLEANUP ON ALREADY-RUNNING VMS" -ForegroundColor Cyan

Start-QueuedJobs -Queue $RunningCleanupQueue -Throttle $MaxParallelJobs

Write-Host "Initial running-VM cleanup jobs launched." -ForegroundColor Green

# ======================== START WORKER ========================

$StartWorker = {
    param($VM, $ContextFile, $UnusedScript, $UnusedRestore)

    try {
        Import-Module Az.Accounts -ErrorAction Stop
        Import-Module Az.Compute -ErrorAction Stop
        Import-AzContext -Path $ContextFile -ErrorAction Stop | Out-Null

        Set-AzContext -SubscriptionId $VM.SubscriptionId -ErrorAction Stop | Out-Null

        Start-AzVM `
            -ResourceGroupName $VM.ResourceGroupName `
            -Name $VM.VMName `
            -ErrorAction Stop | Out-Null

        [PSCustomObject]@{
            VMName            = $VM.VMName
            ResourceGroupName = $VM.ResourceGroupName
            SubscriptionId    = $VM.SubscriptionId
            StartStatus       = "Success"
            Error             = ""
        }
    }
    catch {
        [PSCustomObject]@{
            VMName            = $VM.VMName
            ResourceGroupName = $VM.ResourceGroupName
            SubscriptionId    = $VM.SubscriptionId
            StartStatus       = "Failed"
            Error             = $_.Exception.Message
        }
    }
}

# ======================== PHASE 3: START STOPPED VMS ========================

$StartQueue = New-JobQueue -Items $StoppedVMs -Worker $StartWorker -Name "StartVMs"

Write-Host ""
Write-Host "PHASE 3: STARTING ALL STOPPED/DEALLOCATED VMS" -ForegroundColor Cyan

# Keep both queues moving. Do NOT wait for running-VM cleanup to finish here.
while (!(Test-QueueComplete -Queue $StartQueue)) {
    Pump-Queues `
        -Queues @($RunningCleanupQueue, $StartQueue) `
        -Throttle $MaxParallelJobs

    Start-Sleep -Seconds 2
}

$StartResults = @($StartQueue.Results)

$StartedVMs = @($StartResults | Where-Object { $_.StartStatus -eq "Success" })
$StartFailedVMs = @($StartResults | Where-Object { $_.StartStatus -eq "Failed" })

Write-Host "Successfully started : $($StartedVMs.Count)" -ForegroundColor Green
Write-Host "Startup failures     : $($StartFailedVMs.Count)" -ForegroundColor Red

# ======================== PHASE 4: FIVE-MINUTE BOOT WAIT ========================

if ($StartedVMs.Count -gt 0) {
    Write-Host ""
    Write-Host "PHASE 4: WAITING 5 MINUTES FOR WINDOWS INITIALIZATION" -ForegroundColor Yellow

    $Deadline = (Get-Date).AddSeconds($BootWaitSeconds)

    while ((Get-Date) -lt $Deadline) {
        # Running-VM cleanup continues during the five-minute wait.
        Pump-Queues -Queues @($RunningCleanupQueue) -Throttle $MaxParallelJobs

        $Remaining = [math]::Ceiling(($Deadline - (Get-Date)).TotalSeconds)

        Write-Progress `
            -Activity "Windows startup wait" `
            -Status "$Remaining seconds remaining" `
            -PercentComplete ([math]::Max(0, [math]::Min(100, (($BootWaitSeconds - $Remaining) / $BootWaitSeconds * 100))))

        Start-Sleep -Seconds 2
    }

    Write-Progress -Activity "Windows startup wait" -Completed
}
else {
    Write-Host "No newly started VMs. Skipping five-minute wait." -ForegroundColor Yellow
}

# ======================== PHASE 5: CLEANUP NEWLY STARTED VMS ========================

$DelayedCleanupItems = @(
    foreach ($VM in $StartedVMs) {
        [PSCustomObject]@{
            VMName            = $VM.VMName
            ResourceGroupName = $VM.ResourceGroupName
            SubscriptionId    = $VM.SubscriptionId
            PowerBefore       = "stopped/deallocated"
            StartedByScript   = $true
        }
    }

    foreach ($VM in $StartingVMs) {
        [PSCustomObject]@{
            VMName            = $VM.VMName
            ResourceGroupName = $VM.ResourceGroupName
            SubscriptionId    = $VM.SubscriptionId
            PowerBefore       = "starting"
            StartedByScript   = $false
        }
    }
)

$DelayedCleanupQueue = New-JobQueue `
    -Items $DelayedCleanupItems `
    -Worker $CleanupWorker `
    -Name "DelayedCleanup" `
    -Restore ([bool]$RestorePowerState)

Write-Host ""
Write-Host "PHASE 5: CLEANUP ON NEWLY STARTED VMS" -ForegroundColor Cyan
Write-Host "Cleanup targets: $($DelayedCleanupItems.Count)"

# Wait for both the original running-VM queue and the newly started-VM queue.
Wait-QueueGroup `
    -Queues @($RunningCleanupQueue, $DelayedCleanupQueue) `
    -Throttle $MaxParallelJobs

# ======================== PHASE 6: CONSOLIDATE RESULTS ========================

foreach ($Result in $RunningCleanupQueue.Results) {
    [void]$AllResults.Add($Result)
}

foreach ($Result in $DelayedCleanupQueue.Results) {
    [void]$AllResults.Add($Result)
}

foreach ($VM in $Inventory | Where-Object { $_.ResultStatus -eq "Inventory Failed" }) {
    [void]$AllResults.Add([PSCustomObject]@{
        VMName            = $VM.VMName
        ResourceGroupName = $VM.ResourceGroupName
        SubscriptionId    = $VM.SubscriptionId
        PowerBefore       = "Unknown"
        StartedByScript   = $false
        PoweredOffAfter   = $false
        GhostedBefore     = $null
        GhostedAfter      = $null
        AdaptersBefore    = $null
        AdaptersAfter     = $null
        Minutes           = 0
        CleanupStatus     = "Inventory Failed"
        Error             = $VM.Error
    })
}

foreach ($VM in $SkippedVMs) {
    [void]$AllResults.Add([PSCustomObject]@{
        VMName            = $VM.VMName
        ResourceGroupName = $VM.ResourceGroupName
        SubscriptionId    = $VM.SubscriptionId
        PowerBefore       = $VM.PowerBefore
        StartedByScript   = $false
        PoweredOffAfter   = $false
        GhostedBefore     = $null
        GhostedAfter      = $null
        AdaptersBefore    = $null
        AdaptersAfter     = $null
        Minutes           = 0
        CleanupStatus     = "Skipped - Unsupported Power State"
        Error             = ""
    })
}

foreach ($VM in $StartFailedVMs) {
    [void]$AllResults.Add([PSCustomObject]@{
        VMName            = $VM.VMName
        ResourceGroupName = $VM.ResourceGroupName
        SubscriptionId    = $VM.SubscriptionId
        PowerBefore       = "stopped/deallocated"
        StartedByScript   = $false
        PoweredOffAfter   = $false
        GhostedBefore     = $null
        GhostedAfter      = $null
        AdaptersBefore    = $null
        AdaptersAfter     = $null
        Minutes           = 0
        CleanupStatus     = "VM Start Failed"
        Error             = $VM.Error
    })
}

# ======================== PHASE 7: EXPORT CSV ========================

$OutputDirectory = Split-Path $OutputPath -Parent

if (!(Test-Path -LiteralPath $OutputDirectory)) {
    New-Item -ItemType Directory -Path $OutputDirectory -Force | Out-Null
}

$AllResults |
    Sort-Object VMName |
    Export-Csv -LiteralPath $OutputPath -NoTypeInformation -Force

# ======================== PHASE 8: SUMMARY ========================

$Success = @($AllResults | Where-Object { $_.CleanupStatus -eq "Success" })
$Warnings = @($AllResults | Where-Object { $_.CleanupStatus -like "WARNING*" })

$Failed = @($AllResults | Where-Object {
    $_.CleanupStatus -in @(
        "Run Command Failed",
        "VM Start Failed",
        "Inventory Failed",
        "Background Job Failed"
    )
})

$Skipped = @($AllResults | Where-Object {
    $_.CleanupStatus -like "Skipped*"
})

$Started = @($AllResults | Where-Object { $_.StartedByScript })
$StillOn = @($Started | Where-Object { !$_.PoweredOffAfter })

Write-Host ""
Write-Host "======================================================" -ForegroundColor Cyan
Write-Host "                 FINAL CLEANUP SUMMARY" -ForegroundColor Cyan
Write-Host "======================================================" -ForegroundColor Cyan

Write-Host "Total CSV VMs          : $($VMList.Count)"
Write-Host "Running VMs initially  : $($RunningVMs.Count)"
Write-Host "Stopped VMs initially  : $($StoppedVMs.Count)"
Write-Host "Successfully started   : $($StartedVMs.Count)"
Write-Host "Cleanup succeeded      : $($Success.Count)" -ForegroundColor Green
Write-Host "Warnings               : $($Warnings.Count)" -ForegroundColor Yellow
Write-Host "Failed                 : $($Failed.Count)" -ForegroundColor Red
Write-Host "Skipped                : $($Skipped.Count)"
Write-Host "Started by script      : $($Started.Count)"
Write-Host "Started and still on   : $($StillOn.Count)" -ForegroundColor Yellow

Write-Host ""
Write-Host "DETAILED RESULTS" -ForegroundColor Cyan

$AllResults |
    Sort-Object VMName |
    Format-Table VMName, PowerBefore, StartedByScript,
        GhostedBefore, GhostedAfter, AdaptersBefore, AdaptersAfter,
        Minutes, CleanupStatus -AutoSize -Wrap

if ($Failed.Count -gt 0) {
    Write-Host ""
    Write-Host "FAILED VMS" -ForegroundColor Red
    $Failed | Select-Object VMName, CleanupStatus, Error | Format-Table -AutoSize -Wrap
}

Write-Host ""
Write-Host "CSV OUTPUT: $OutputPath" -ForegroundColor Green

# ======================== PHASE 9: CLEANUP TEMP FILES ========================

Remove-Item -LiteralPath $TempScript -Force -ErrorAction SilentlyContinue
Remove-Item -LiteralPath $ContextPath -Force -ErrorAction SilentlyContinue

Write-Host ""
Write-Host "Ghosted NIC cleanup execution completed." -ForegroundColor Green

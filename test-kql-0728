$User = "U579652"

# Get VM Boot Time
$BootTime = (Get-CimInstance Win32_OperatingSystem).LastBootUpTime

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "AVD LOGIN EVENT REFERENCE" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan

Write-Host "41 = User initiated AVD connection"
Write-Host "42 = Session assigned by broker"
Write-Host "21 = User authentication completed"
Write-Host "22 = Desktop ready"
Write-Host ""
Write-Host "Time to Desktop = Event 22 - Event 41"
Write-Host "Authentication = Event 21 - Event 41"
Write-Host "Desktop Load   = Event 22 - Event 21"

# Collect Events
$Events = Get-WinEvent -FilterHashtable @{
    LogName  = 'Microsoft-Windows-TerminalServices-LocalSessionManager/Operational'
    StartTime = (Get-Date).AddDays(-7)
} |
Where-Object {
    $_.Id -in 21,22,41,42 -and
    $_.Message -match $User
} |
Sort-Object TimeCreated

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "RAW EVENT TIMELINE" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan

$Events |
Select-Object `
    TimeCreated,
    Id,
    @{
        Name='Meaning'
        Expression={
            switch ($_.Id)
            {
                41 {'AVD Connection Started'}
                42 {'Session Assigned'}
                21 {'Logon Succeeded'}
                22 {'Desktop Ready'}
            }
        }
    } |
Format-Table -AutoSize

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "LOGIN SUMMARY" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan

$StartTime = $null
$LogonTime = $null

foreach ($Event in $Events)
{
    switch ($Event.Id)
    {
        41 {
            $StartTime = $Event.TimeCreated
        }

        21 {
            $LogonTime = $Event.TimeCreated
        }

        22 {

            if ($StartTime -and $LogonTime)
            {
                $AuthenticationSec = [math]::Round(
                    ($LogonTime - $StartTime).TotalSeconds,0
                )

                $DesktopLoadSec = [math]::Round(
                    ($Event.TimeCreated - $LogonTime).TotalSeconds,0
                )

                $TotalLoginSec = [math]::Round(
                    ($Event.TimeCreated - $StartTime).TotalSeconds,0
                )

                $MinutesSinceBoot = [math]::Round(
                    ($StartTime - $BootTime).TotalMinutes,1
                )

                if ($MinutesSinceBoot -lt 5)
                {
                    $VMState = "VM likely started due to user connection"
                }
                elseif ($MinutesSinceBoot -lt 15)
                {
                    $VMState = "VM recently started before user login"
                }
                else
                {
                    $VMState = "VM already available before user login"
                }

                [PSCustomObject]@{
                    VMLastBoot        = $BootTime
                    VMState           = $VMState
                    MinutesSinceBoot  = $MinutesSinceBoot
                    LoginStarted      = $StartTime
                    LogonSucceeded    = $LogonTime
                    DesktopReady      = $Event.TimeCreated
                    AuthenticationSec = $AuthenticationSec
             Desktop
                    TotalLoginSec     = $TotalLoginSec
                } | Format-List

                Write-Host "------------------------------------------------------------"

                $StartTime = $null
                $LogonTime = $null
            }
        }
    }
}

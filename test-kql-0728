# ===========================
# DATA COLLECTION & CONFIRMATION
# ===========================
$inputCsv = "\\smb.waunas23f.hcscint.net\infrastructure\MSP_VTT\AVD-Related-Scripts\ManuallyDeleteAVD\VM_List.csv"

# Wrap in @(...) so .Count always works accurately even if there is only 1 VM in the CSV
$vmList = @(Import-Csv -Path $inputCsv | Where-Object { 
    -not [string]::IsNullOrWhiteSpace($_.VMName) -and -not [string]::IsNullOrWhiteSpace($_.SubscriptionId) 
})

if ($vmList.Count -eq 0) {
    Write-Host "No valid VM entries found in $inputCsv. Exiting." -ForegroundColor Red
    return
}

# Show only the total count from the CSV
Write-Host "`n===================================================" -ForegroundColor Yellow
Write-Host "Total VMs found in CSV for deletion: $($vmList.Count)" -ForegroundColor Cyan
Write-Host "===================================================" -ForegroundColor Yellow

# Mandatory Confirmation Gate
$confirm = Read-Host "`nType YES to proceed with deletion, or press Enter to cancel"
if ($confirm -ne "YES") {
    Write-Host "Operation cancelled by user. No VMs were modified or deleted." -ForegroundColor Red
    return
}

# ===========================
# AZURE LOGIN
# ===========================
$firstSubId = $vmList[0].SubscriptionId.Trim()
Write-Host "`nAuthenticating to Azure..." -ForegroundColor Cyan
Connect-AzAccount -Subscription $firstSubId -ErrorAction Stop | Out-Null

Write-Host "`n--- Starting Deletion Process for $($vmList.Count) VMs ---" -ForegroundColor White

# ===========================
# PROCESSING BY SUBSCRIPTION
# ===========================
$groupedBySub = $vmList | Group-Object -Property { $_.SubscriptionId.Trim() }

$results = foreach ($subGroup in $groupedBySub) {
    $subId = $subGroup.Name
    Write-Host "`nSwitching to Subscription: $subId" -ForegroundColor Magenta
    
    try {
        Set-AzContext -SubscriptionId $subId -ErrorAction Stop | Out-Null
    } catch {
        Write-Host "Failed to switch to Subscription $subId : $($_.Exception.Message)" -ForegroundColor Red
        foreach ($row in $subGroup.Group) {
            [PSCustomObject]@{
                SubscriptionId = $subId
                VMName         = $row.VMName.Trim()
                ResourceGroup  = "N/A"
                ActionTaken    = "Skipped (Subscription Access Error)"
            }
        }
        continue
    }

    # Get all VMs in this subscription once for speed
    $allVmsInSub = Get-AzVM 

    foreach ($row in $subGroup.Group) {
        $vmName = $row.VMName.Trim()
        $foundVm = $allVmsInSub | Where-Object { $_.Name -eq $vmName }
        
        Write-Host "`n--------------------------------------------------" -ForegroundColor Gray
        Write-Host "VM: $vmName" -ForegroundColor Cyan

        if (-not $foundVm) {
            Write-Host "VM - $vmName - [NOT FOUND]" -ForegroundColor Red
            [PSCustomObject]@{ 
                SubscriptionId = $subId
                VMName         = $vmName
                ResourceGroup  = "N/A"
                ActionTaken    = "Skipped (Not Found)" 
            }
            continue
        }

        $rg = $foundVm.ResourceGroupName
        $actionStatus = "Success"

        try {
            # Capture IDs before VM is gone
            $osDiskId = $foundVm.StorageProfile.OsDisk.ManagedDisk.Id
            $nicIds = $foundVm.NetworkProfile.NetworkInterfaces.Id

            # 1. Delete VM
            Remove-AzVM -ResourceGroupName $rg -Name $vmName -Force -ErrorAction Stop
            Write-Host "VM - $vmName - [DELETED]" -ForegroundColor Yellow

            # 2. Delete NICs
            foreach ($nicId in $nicIds) {
                $nicName = $nicId.Split('/')[-1]
                Remove-AzResource -ResourceId $nicId -Force -ErrorAction SilentlyContinue
                Write-Host "NIC - $nicName - [DELETED]" -ForegroundColor Yellow
            }

            # 3. Delete OS Disk
            if ($osDiskId) {
                $diskName = $osDiskId.Split('/')[-1]
                Remove-AzResource -ResourceId $osDiskId -Force -ErrorAction SilentlyContinue
                Write-Host "Disk - $diskName - [DELETED]" -ForegroundColor Yellow
            }

            $actionStatus = "VM, NIC, and Disk Deleted"
        } catch {
            Write-Host "Error processing $vmName : $($_.Exception.Message)" -ForegroundColor Red
            $actionStatus = "Error: $($_.Exception.Message)"
        }

        [PSCustomObject]@{
            SubscriptionId = $subId
            VMName         = $vmName
            ResourceGroup  = $rg
            ActionTaken    = $actionStatus
        }
    }
}

Write-Host "`n--------------------------------------------------" -ForegroundColor Gray

# ===========================
# EXPORT REPORT
# ===========================
$outputPath = "C:\Temp\VM_Deletion_Report.csv"
if (-not (Test-Path "C:\Temp")) { New-Item -ItemType Directory -Path "C:\Temp" -Force | Out-Null }

$results | Export-Csv -Path $outputPath -NoTypeInformation -Force
Write-Host "`nProcess Complete. Summary exported to $outputPath" -ForegroundColor Green

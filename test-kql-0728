#Requires -Version 5.1
#Requires -Modules Az.Accounts, Az.Compute

[CmdletBinding()]
param(
    [string]$OnlyVM = ""
)

# ======================== CONFIGURATION ========================
$CsvPath    = "C:\Temp\Ghost\CleanUp\avd_hosts_cleanup.csv"
$MaxThreads = 50

$ErrorActionPreference = "Stop"

Write-Host ""
Write-Host "======================================================" -ForegroundColor Cyan
Write-Host "   PARALLEL GHOSTED NIC VERIFICATION CHECK"            -ForegroundColor Cyan
Write-Host "======================================================" -ForegroundColor Cyan

# ======================== VALIDATE INPUT ========================
if (!(Test-Path -LiteralPath $CsvPath)) { throw "CSV file not found: $CsvPath" }

$RawCsv = @(Import-Csv -LiteralPath $CsvPath)
if ($RawCsv.Count -eq 0) { throw "CSV contains no VM records." }

$CsvColumns = $RawCsv[0].PSObject.Properties.Name
foreach ($Column in @("VMName", "ResourceGroupName", "SubscriptionId")) {
    if ($Column -notin $CsvColumns) {
        throw "Missing required CSV column: $Column"
    }
}

$VMList = @(
    $RawCsv |
    Where-Object {
        ![string]::IsNullOrWhiteSpace($_.VMName) -and
        ![string]::IsNullOrWhiteSpace($_.ResourceGroupName) -and
        ![string]::IsNullOrWhiteSpace($_.SubscriptionId)
    } |
    ForEach-Object {
        [PSCustomObject]@{
            VMName            = $_.VMName.Trim()
            ResourceGroupName = $_.ResourceGroupName.Trim()
            SubscriptionId    = $_.SubscriptionId.Trim()
        }
    } |
    Group-Object { "$($_.SubscriptionId.ToLower())|$($_.ResourceGroupName.ToLower())|$($_.VMName.ToLower())" } |
    ForEach-Object { $_.Group[0] }
)

if (![string]::IsNullOrWhiteSpace($OnlyVM)) {
    $VMList = @($VMList | Where-Object { $_.VMName -eq $OnlyVM.Trim() })
    if ($VMList.Count -eq 0) { throw "VM '$OnlyVM' not found in CSV." }
}

Write-Host ("Total VMs       : {0}" -f $VMList.Count)
Write-Host ("Parallel threads: {0}" -f $MaxThreads)
Write-Host ""

# ======================== AZURE AUTHENTICATION ========================
Disable-AzContextAutosave -Scope Process | Out-Null
Write-Host "Starting Azure device-code authentication..." -ForegroundColor Cyan
$Login = Connect-AzAccount -UseDeviceAuthentication -ErrorAction Stop
if (!$Login) { throw "Connect-AzAccount did not return an authenticated context." }

$Context = Get-AzContext
if (!$Context) { throw "Get-AzContext returned no context." }
Write-Host ("Authenticated   : {0}" -f $Context.Account.Id) -ForegroundColor Green

# ======================== REMOTE CHECK PAYLOAD ========================
# Fast read-only check that counts remaining ghosted NICs and active adapters
$CheckScriptBlock = @'
$ErrorActionPreference = "SilentlyContinue"
$Ghosts   = @(Get-PnpDevice -Class Net | Where-Object { $_.Present -eq $false }).Count
$Adapters = @(Get-NetAdapter).Count
Write-Output ("VERIFY_NIC|{0}|{1}|{2}" -f $env:COMPUTERNAME, $Ghosts, $Adapters)
'@

# ======================== RUNSPACE POOL EXECUTION ========================
$SessionState = [System.Management.Automation.Runspaces.InitialSessionState]::CreateDefault()
$SessionState.ImportPSModule(@("Az.Accounts", "Az.Compute"))

$Pool = [runspacefactory]::CreateRunspacePool(1, $MaxThreads, $SessionState, $Host)
$Pool.Open()

$WorkerScript = {
    param($VMName, $ResourceGroupName, $SubscriptionId, $RemoteCode)
    try {
        Set-AzContext -SubscriptionId $SubscriptionId -Scope Process -ErrorAction Stop | Out-Null

        $Response = Invoke-AzVMRunCommand `
            -ResourceGroupName $ResourceGroupName `
            -VMName $VMName `
            -CommandId "RunPowerShellScript" `
            -ScriptString $RemoteCode `
            -ErrorAction Stop

        $Message = ($Response.Value | ForEach-Object { $_.Message }) -join "`n"
        $Marker  = [regex]::Match($Message, '(?m)VERIFY_NIC\|[^\r\n]+')

        if ($Marker.Success) {
            $Parts = $Marker.Value -split '\|'
            $GhostCount   = [int]$Parts[2]
            $AdapterCount = [int]$Parts[3]

            $State = if ($GhostCount -eq 0) { "Clean" } else { "Ghosts Remaining" }

            [PSCustomObject]@{
                VMName         = $VMName
                RemainingGhosts = $GhostCount
                ActiveAdapters = $AdapterCount
                Status         = $State
                Error          = ""
            }
        } else {
            throw "Unexpected output: $Message"
        }
    } catch {
        [PSCustomObject]@{
            VMName          = $VMName
            RemainingGhosts = $null
            ActiveAdapters  = $null
            Status          = "Check Failed"
            Error           = $_.Exception.Message
        }
    }
}

$Jobs  = New-Object System.Collections.Generic.List[object]
$Watch = [System.Diagnostics.Stopwatch]::StartNew()

Write-Host ""
Write-Host "Checking remaining ghosted NICs across VMs..." -ForegroundColor Cyan

foreach ($VM in $VMList) {
    $PS = [powershell]::Create()
    $PS.RunspacePool = $Pool
    [void]$PS.AddScript($WorkerScript)
    [void]$PS.AddArgument($VM.VMName)
    [void]$PS.AddArgument($VM.ResourceGroupName)
    [void]$PS.AddArgument($VM.SubscriptionId)
    [void]$PS.AddArgument($CheckScriptBlock)

    $Jobs.Add([PSCustomObject]@{
        VM     = $VM
        Pipe   = $PS
        Handle = $PS.BeginInvoke()
    })
}

$AllResults = New-Object System.Collections.Generic.List[object]
$TotalCount = $Jobs.Count

while ($Jobs.Count -gt 0) {
    $Completed = @($Jobs | Where-Object { $_.Handle.IsCompleted })
    foreach ($Item in $Completed) {
        try {
            $Output = $Item.Pipe.EndInvoke($Item.Handle)
            foreach ($Row in $Output) { $AllResults.Add($Row) }
        } catch {
            $AllResults.Add([PSCustomObject]@{
                VMName          = $Item.VM.VMName
                RemainingGhosts = $null
                ActiveAdapters  = $null
                Status          = "Check Failed"
                Error           = $_.Exception.Message
            })
        } finally {
            $Item.Pipe.Dispose()
            [void]$Jobs.Remove($Item)
        }
    }

    $DoneCount = $TotalCount - $Jobs.Count
    $Percent   = if ($TotalCount -gt 0) { [int](100 * $DoneCount / $TotalCount) } else { 100 }
    Write-Progress -Activity "Verifying Ghosted NIC Cleanup" `
        -Status ("Checked {0}/{1} | Remaining {2}" -f $DoneCount, $TotalCount, $Jobs.Count) `
        -PercentComplete $Percent

    if ($Jobs.Count -gt 0) { Start-Sleep -Milliseconds 250 }
}

Write-Progress -Activity "Verifying Ghosted NIC Cleanup" -Completed
$Pool.Close()
$Pool.Dispose()
$Watch.Stop()

# ======================== CONSOLE SUMMARY ========================
$Clean     = @($AllResults | Where-Object { $_.Status -eq "Clean" })
$Remaining = @($AllResults | Where-Object { $_.Status -eq "Ghosts Remaining" })
$Failed    = @($AllResults | Where-Object { $_.Status -eq "Check Failed" })

Write-Host ""
Write-Host "======================================================" -ForegroundColor Cyan
Write-Host "   VERIFICATION SUMMARY"                                 -ForegroundColor Cyan
Write-Host "======================================================" -ForegroundColor Cyan
Write-Host ("Total VMs        : {0}" -f $TotalCount)
Write-Host ("Clean (0 Ghosts) : {0}" -f $Clean.Count)     -ForegroundColor Green
Write-Host ("Ghosts Remaining : {0}" -f $Remaining.Count) -ForegroundColor Yellow
Write-Host ("Check Failed     : {0}" -f $Failed.Count)    -ForegroundColor Red
Write-Host ("Elapsed Time     : {0} seconds" -f [math]::Round($Watch.Elapsed.TotalSeconds, 1))
Write-Host ""

$AllResults | Sort-Object RemainingGhosts -Descending | Select-Object VMName, RemainingGhosts, ActiveAdapters, Status | Format-Table -AutoSize

if ($Failed.Count -gt 0) {
    Write-Host "FAILED CHECKS (VM may still be running Step 1 cleanup)" -ForegroundColor Red
    $Failed | Sort-Object VMName | Select-Object VMName, Error | Format-Table -AutoSize -Wrap
}

#Requires -Version 5.1
#Requires -Modules Az.Accounts, Az.Compute

<#
.SYNOPSIS
    Runs the Microsoft ghosted-device cleanup script on Azure VMs using Run Command.

.DESCRIPTION
    - Uses device-code authentication in the main PowerShell session.
    - Saves the authenticated Az context and validates that a separate PowerShell
      background job can import it before starting the VM cleanup workload.
    - Skips VM power-state inventory and does not start or stop VMs.
    - Runs up to 200 VM Run Command operations concurrently.
    - Exports one result row per VM to CSV.

.NOTES
    Windows PowerShell 5.1 compatible.
    Device-code authentication must be permitted by the organization's
    Conditional Access policies. If blocked, use an organization-approved
    certificate-based service principal instead.
    Run against a small test CSV before using the full production list.
#>

[CmdletBinding()]
param(
    [string]$OnlyVM = "",
    [switch]$Force
)

# ======================== CONFIGURATION ========================
$CsvPath           = "C:\Temp\Ghost\Remove-nics\avd_hosts1.csv"
$CleanupScriptPath = "C:\Temp\Ghost\Windows_GhostedNIC_Removal.ps1"
$OutputPath        = "C:\Temp\Ghost\Remove-nics\GhostedNIC_Cleanup_Results.csv"
$MaxParallelJobs   = 200

$ErrorActionPreference = "Stop"

$RunId       = [guid]::NewGuid().ToString("N")
$TempScript  = Join-Path $env:TEMP ("GhostedNIC_Remote_{0}.ps1" -f $RunId)
$ContextPath = Join-Path $env:TEMP ("GhostedNIC_AzContext_{0}.json" -f $RunId)
$PreflightJob = $null
$AllResults = @()

Write-Host ""
Write-Host "======================================================" -ForegroundColor Cyan
Write-Host "       PARALLEL GHOSTED NIC CLEANUP" -ForegroundColor Cyan
Write-Host "       AZURE VM RUN COMMAND" -ForegroundColor Cyan
Write-Host "======================================================" -ForegroundColor Cyan

try {
    # ======================== VALIDATE INPUT ========================
    if (!(Test-Path -LiteralPath $CsvPath)) {
        throw "CSV file not found: $CsvPath"
    }
    if (!(Test-Path -LiteralPath $CleanupScriptPath)) {
        throw "Microsoft cleanup script not found: $CleanupScriptPath"
    }

    $VMList = @(Import-Csv -LiteralPath $CsvPath)
    if ($VMList.Count -eq 0) {
        throw "CSV contains no VM records."
    }

    $RequiredColumns = @("VMName", "ResourceGroupName", "SubscriptionId")
    foreach ($Column in $RequiredColumns) {
        if ($Column -notin $VMList[0].PSObject.Properties.Name) {
            throw "Missing required CSV column: $Column"
        }
    }

    $VMList = @($VMList | Where-Object {
        ![string]::IsNullOrWhiteSpace($_.VMName) -and
        ![string]::IsNullOrWhiteSpace($_.ResourceGroupName) -and
        ![string]::IsNullOrWhiteSpace($_.SubscriptionId)
    } | ForEach-Object {
        [PSCustomObject]@{
            VMName            = $_.VMName.Trim()
            ResourceGroupName = $_.ResourceGroupName.Trim()
            SubscriptionId    = $_.SubscriptionId.Trim()
        }
    })

    $VMList = @($VMList | Sort-Object SubscriptionId, ResourceGroupName, VMName -Unique)

    if (![string]::IsNullOrWhiteSpace($OnlyVM)) {
        $VMList = @($VMList | Where-Object { $_.VMName -eq $OnlyVM.Trim() })
        if ($VMList.Count -eq 0) {
            throw "VM '$OnlyVM' not found in CSV."
        }
    }

    Write-Host ("Total VMs      : {0}" -f $VMList.Count)
    Write-Host ("Parallel limit : {0}" -f $MaxParallelJobs)
    Write-Host ""

    # ======================== CONFIRMATION ========================
    if (!$Force) {
        Write-Host "WARNING: Review the Microsoft cleanup script before production use." -ForegroundColor Yellow
        Write-Host "It may remove non-present devices beyond network adapters, depending on its contents." -ForegroundColor Yellow
        Write-Host "This script assumes all target VMs are already running." -ForegroundColor Yellow
        Write-Host "No VM power-state checks, starts, or stops will be performed." -ForegroundColor Yellow
        $Answer = Read-Host "Type YES to continue"
        if ($Answer -cne "YES") {
            Write-Host "Cancelled. No changes made." -ForegroundColor Green
            return
        }
    }

    # ======================== AZURE AUTHENTICATION ========================
    Write-Host "Starting Azure device-code authentication..." -ForegroundColor Cyan
    Write-Host "Complete the sign-in using the code and URL displayed below." -ForegroundColor Cyan

    # Explicit device-code flow avoids relying on an interactive browser popup
    # launched by Connect-AzAccount in this PowerShell session.
    $Login = Connect-AzAccount -UseDeviceAuthentication -ErrorAction Stop
    if (!$Login) {
        throw "Connect-AzAccount did not return an authenticated context."
    }

    $Context = Get-AzContext
    if (!$Context) {
        throw "Azure authentication completed but Get-AzContext returned no context."
    }

    Save-AzContext -Path $ContextPath -Force -ErrorAction Stop | Out-Null
    if (!(Test-Path -LiteralPath $ContextPath)) {
        throw "Azure context file was not created: $ContextPath"
    }

    Write-Host "Azure authentication successful." -ForegroundColor Green
    Write-Host ("Account : {0}" -f $Context.Account.Id)
    Write-Host ("Tenant  : {0}" -f $Context.Tenant.Id)

    # ======================== CHILD-PROCESS AUTH TEST ========================
    # Verify that a separate Start-Job process can import and use the saved
    # context before launching up to 200 cleanup jobs.
    $FirstSubscriptionId = $VMList[0].SubscriptionId
    Write-Host "Validating saved Azure context inside a background PowerShell process..." -ForegroundColor Cyan

    $PreflightJob = Start-Job -Name "AzContextPreflight" -ArgumentList $ContextPath, $FirstSubscriptionId -ScriptBlock {
        param($SavedContextPath, $SubscriptionId)
        try {
            Import-Module Az.Accounts -ErrorAction Stop
            Import-AzContext -Path $SavedContextPath -Scope Process -ErrorAction Stop | Out-Null
            Set-AzContext -SubscriptionId $SubscriptionId -Scope Process -ErrorAction Stop | Out-Null
            Get-AzSubscription -SubscriptionId $SubscriptionId -ErrorAction Stop | Out-Null
            [PSCustomObject]@{ Success = $true; Message = "Background job imported context and accessed subscription." }
        }
        catch {
            [PSCustomObject]@{ Success = $false; Message = $_.Exception.Message }
        }
    }

    $PreflightJob | Wait-Job | Out-Null
    $PreflightOutput = @(Receive-Job -Job $PreflightJob -ErrorAction SilentlyContinue)
    Remove-Job -Job $PreflightJob -Force -ErrorAction SilentlyContinue
    $PreflightJob = $null

    if ($PreflightOutput.Count -eq 0 -or !$PreflightOutput[0].Success) {
        $PreflightMessage = if ($PreflightOutput.Count -gt 0) { $PreflightOutput[0].Message } else { "Background preflight returned no output." }
        throw "Saved Azure authentication could not be used in a background job. No VM cleanup was launched. Details: $PreflightMessage"
    }
    Write-Host "Background authentication test passed." -ForegroundColor Green

    # ======================== BUILD REMOTE SCRIPT ========================
    $Header = @'
$ErrorActionPreference = "Continue"

try {
    $PreGhosts = @(Get-PnpDevice -Class Net -ErrorAction Stop |
        Where-Object { $_.Present -eq $false }).Count
}
catch { $PreGhosts = -1 }

try {
    $PreAdapters = @(Get-NetAdapter -ErrorAction Stop).Count
}
catch { $PreAdapters = -1 }
'@

    $Footer = @'
try {
    $PostGhosts = @(Get-PnpDevice -Class Net -ErrorAction Stop |
        Where-Object { $_.Present -eq $false }).Count
}
catch { $PostGhosts = -1 }

try {
    $PostAdapters = @(Get-NetAdapter -ErrorAction Stop).Count
}
catch { $PostAdapters = -1 }

Write-Output ("GHOSTED_NIC_CLEANUP|Done|{0}|{1}|{2}|{3}|{4}" -f `
    $env:COMPUTERNAME,
    $PreGhosts,
    $PostGhosts,
    $PreAdapters,
    $PostAdapters)
'@

    $MsScript = Get-Content -LiteralPath $CleanupScriptPath -Raw
    $Combined = $Header + "`r`n" + $MsScript + "`r`n" + $Footer
    [System.IO.File]::WriteAllText(
        $TempScript,
        $Combined,
        (New-Object System.Text.UTF8Encoding($false))
    )

    # ======================== WORKER ========================
    $CleanupWorker = {
        param($VM, $ContextFile, $RemoteScript)
        $Watch = [System.Diagnostics.Stopwatch]::StartNew()
        try {
            Import-Module Az.Accounts -ErrorAction Stop
            Import-Module Az.Compute -ErrorAction Stop
            Import-AzContext -Path $ContextFile -Scope Process -ErrorAction Stop | Out-Null
            Set-AzContext -SubscriptionId $VM.SubscriptionId -Scope Process -ErrorAction Stop | Out-Null

            $Response = Invoke-AzVMRunCommand `
                -ResourceGroupName $VM.ResourceGroupName `
                -VMName $VM.VMName `
                -CommandId "RunPowerShellScript" `
                -ScriptPath $RemoteScript `
                -ErrorAction Stop

            $Message = ($Response.Value | ForEach-Object { $_.Message }) -join "`n"
            $Marker = [regex]::Match($Message, '(?m)GHOSTED_NIC_CLEANUP\|Done\|[^\r\n]+')
            if (!$Marker.Success) {
                $Snippet = $Message
                if ($Snippet.Length -gt 1000) { $Snippet = $Snippet.Substring($Snippet.Length - 1000) }
                throw "Cleanup result marker missing. Output: $Snippet"
            }

            $P = $Marker.Value -split '\|'
            if ($P.Count -lt 7) { throw "Invalid cleanup result marker: $($Marker.Value)" }

            $GhostBefore    = [int]$P[3]
            $GhostAfter     = [int]$P[4]
            $AdaptersBefore = [int]$P[5]
            $AdaptersAfter  = [int]$P[6]
            $Status = "Success"
            if ($AdaptersBefore -ge 0 -and $AdaptersAfter -ge 0 -and $AdaptersAfter -lt $AdaptersBefore) {
                $Status = "WARNING - Adapter count dropped"
            }

            [PSCustomObject]@{
                VMName            = $VM.VMName
                ResourceGroupName = $VM.ResourceGroupName
                SubscriptionId    = $VM.SubscriptionId
                PowerBefore       = "AssumedRunning"
                GhostedBefore     = $GhostBefore
                GhostedAfter      = $GhostAfter
                AdaptersBefore    = $AdaptersBefore
                AdaptersAfter     = $AdaptersAfter
                Minutes           = [math]::Round($Watch.Elapsed.TotalMinutes, 2)
                CleanupStatus     = $Status
                Error             = ""
            }
        }
        catch {
            [PSCustomObject]@{
                VMName            = $VM.VMName
                ResourceGroupName = $VM.ResourceGroupName
                SubscriptionId    = $VM.SubscriptionId
                PowerBefore       = "AssumedRunning"
                GhostedBefore     = $null
                GhostedAfter      = $null
                AdaptersBefore    = $null
                AdaptersAfter     = $null
                Minutes           = [math]::Round($Watch.Elapsed.TotalMinutes, 2)
                CleanupStatus     = "Run Command Failed"
                Error             = $_.Exception.Message
            }
        }
    }

    # ======================== PARALLEL QUEUE ========================
    $Queue = [PSCustomObject]@{
        Items       = @($VMList)
        Next        = 0
        Active      = New-Object System.Collections.ArrayList
        Results     = New-Object System.Collections.ArrayList
        Completed   = 0
    }

    Write-Host ""
    Write-Host "Starting direct VM Run Command execution..." -ForegroundColor Cyan
    Write-Host ("Targets          : {0}" -f $Queue.Items.Count)
    Write-Host ("Max parallel jobs: {0}" -f $MaxParallelJobs)
    Write-Host "Power-state inventory: SKIPPED" -ForegroundColor Green
    Write-Host "VM start/stop actions: DISABLED" -ForegroundColor Green
    Write-Host ""

    while ($Queue.Next -lt $Queue.Items.Count -or $Queue.Active.Count -gt 0) {
        # Fill available worker slots up to the global concurrency limit.
        while ($Queue.Next -lt $Queue.Items.Count -and $Queue.Active.Count -lt $MaxParallelJobs) {
            $Item = $Queue.Items[$Queue.Next]
            $Queue.Next++
            $Job = Start-Job -Name ([string]$Item.VMName) -ScriptBlock $CleanupWorker `
                -ArgumentList $Item, $ContextPath, $TempScript
            [void]$Queue.Active.Add($Job)
        }

        $FinishedJobs = @($Queue.Active | Where-Object { $_.State -in @("Completed", "Failed", "Stopped") })
        foreach ($Job in $FinishedJobs) {
            $JobOutput = @(Receive-Job -Job $Job -ErrorAction SilentlyContinue)
            if ($JobOutput.Count -gt 0) {
                foreach ($Entry in $JobOutput) { [void]$Queue.Results.Add($Entry) }
            }
            else {
                [void]$Queue.Results.Add([PSCustomObject]@{
                    VMName            = $Job.Name
                    ResourceGroupName = ""
                    SubscriptionId    = ""
                    PowerBefore       = "AssumedRunning"
                    GhostedBefore     = $null
                    GhostedAfter      = $null
                    AdaptersBefore    = $null
                    AdaptersAfter     = $null
                    Minutes           = 0
                    CleanupStatus     = "Background Job Failed"
                    Error             = "Job returned no output. State: $($Job.State)"
                })
            }
            Remove-Job -Job $Job -Force -ErrorAction SilentlyContinue
            [void]$Queue.Active.Remove($Job)
            $Queue.Completed++
        }

        $ActiveCount = $Queue.Active.Count
        $StartedCount = $Queue.Next
        $CompletedCount = $Queue.Completed
        $Percent = if ($Queue.Items.Count -gt 0) { [int](100 * $CompletedCount / $Queue.Items.Count) } else { 100 }
        Write-Progress -Activity "Azure VM ghosted-NIC cleanup" `
            -Status ("Started {0}/{1} | Active {2} | Completed {3}/{1}" -f $StartedCount, $Queue.Items.Count, $ActiveCount, $CompletedCount) `
            -PercentComplete $Percent

        if ($Queue.Active.Count -gt 0) { Start-Sleep -Seconds 2 }
    }
    Write-Progress -Activity "Azure VM ghosted-NIC cleanup" -Completed

    $AllResults = @($Queue.Results)

    # ======================== EXPORT RESULTS ========================
    $OutputDirectory = Split-Path $OutputPath -Parent
    if (!(Test-Path -LiteralPath $OutputDirectory)) {
        New-Item -ItemType Directory -Path $OutputDirectory -Force | Out-Null
    }

    $AllResults | Sort-Object VMName | Export-Csv -LiteralPath $OutputPath -NoTypeInformation -Force

    $Success  = @($AllResults | Where-Object { $_.CleanupStatus -eq "Success" })
    $Warnings = @($AllResults | Where-Object { $_.CleanupStatus -like "WARNING*" })
    $Failed   = @($AllResults | Where-Object { $_.CleanupStatus -in @("Run Command Failed", "Background Job Failed") })

    Write-Host ""
    Write-Host "======================================================" -ForegroundColor Cyan
    Write-Host "             FINAL CLEANUP SUMMARY" -ForegroundColor Cyan
    Write-Host "======================================================" -ForegroundColor Cyan
    Write-Host ("Total CSV VMs       : {0}" -f $VMList.Count)
    Write-Host ("Cleanup succeeded   : {0}" -f $Success.Count) -ForegroundColor Green
    Write-Host ("Warnings            : {0}" -f $Warnings.Count) -ForegroundColor Yellow
    Write-Host ("Failed              : {0}" -f $Failed.Count) -ForegroundColor Red
    Write-Host ""

    $AllResults | Sort-Object VMName | Format-Table VMName, GhostedBefore, GhostedAfter, AdaptersBefore, AdaptersAfter, Minutes, CleanupStatus -AutoSize -Wrap
    if ($Failed.Count -gt 0) {
        Write-Host "FAILED VMS" -ForegroundColor Red
        $Failed | Select-Object VMName, CleanupStatus, Error | Format-Table -AutoSize -Wrap
    }

    Write-Host ""
    Write-Host ("CSV OUTPUT: {0}" -f $OutputPath) -ForegroundColor Green
    Write-Host "Ghosted NIC cleanup execution completed." -ForegroundColor Green
}
finally {
    if ($PreflightJob) {
        Remove-Job -Job $PreflightJob -Force -ErrorAction SilentlyContinue
    }
    Remove-Item -LiteralPath $TempScript -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath $ContextPath -Force -ErrorAction SilentlyContinue
}

$agent = Get-Service -Name WindowsAzureGuestAgent `
    -ErrorAction SilentlyContinue

if ($agent) {

    Write-Host "Current Agent Status: $($agent.Status)"

    Restart-Service -Name WindowsAzureGuestAgent `
        -Force

    Start-Sleep -Seconds 10

    Get-Service -Name WindowsAzureGuestAgent |
        Select-Object Name, Status
}
else {
    Write-Host "Azure VM Agent service not found."
}

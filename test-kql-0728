# Define the query parameters for the Application Error log
\$Filter = @{
    LogName = 'Application'
    ID      = 1000
}

# Fetch the crash events matching our application or module names
Crashes = Get-WinEvent -FilterHashtable Filter -ErrorAction SilentlyContinue | 
    Where-Object { \(_.Message -match "pcsws.exe" -or \)_.Message -match "PCSTQ.dll" }

if (\$Crashes) {
    Write-Host "Found ((Crashes.Count)) crash events related to pcsws.exe / PCSTQ.dll.`n" -ForegroundColor Green
    
    foreach (Event in Crashes) {
        Write-Host "======================================================================" -ForegroundColor Cyan
        Write-Host "CRASH TIMESTAMP : (Event.TimeCreated)" -ForegroundColor Yellow
        Write-Host "PROCESS ID      : (Event.ProcessId)"
        Write-Host "======================================================================"
        
        # Output the clean textual message details from Event Viewer
        Write-Host \$Event.Message
        
        # Extract the underlying XML structural layout data
        Write-Host "`n--- Raw XML Log Data Elements ---" -ForegroundColor Gray
        $Xml = [xml]$Event.ToXml()
        foreach ($Data in $Xml.Event.EventData.Data) {
            if ($Data.Name -and $Data.'#text') {
                Write-Host "  $($Data.Name) : $($Data.'#text')" -ForegroundColor White
            }
        }
        Write-Host "`n"
    }
} else {
    Write-Host "No pcsws.exe or PCSTQ.dll Event 1000 crash instances were found in the log." -ForegroundColor Red
}

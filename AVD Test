Import-Module ActiveDirectory

$GroupName = "MSAZURE_PROD_AVD_CORP2_CAS2_SC"
$UserFile  = "C:\Temp\UsersToRemove.txt"
$LogFile   = "C:\Temp\DryRunResults.csv"

$Users = Get-Content $UserFile
$Results = @()

foreach ($User in $Users) {

    try {

        # If value contains @, treat it as UPN/email
        if ($User -match "@") {
            $ADUser = Get-ADUser -Filter "UserPrincipalName -eq '$User'" -Properties UserPrincipalName -ErrorAction Stop
        }
        else {
            $ADUser = Get-ADUser -Identity $User -ErrorAction Stop
        }

        if (Get-ADGroupMember $GroupName -Recursive | Where-Object { $_.SamAccountName -eq $ADUser.SamAccountName }) {

            Write-Host "[DRY RUN] Would remove: $($ADUser.SamAccountName)" -ForegroundColor Cyan

            $Results += [PSCustomObject]@{
                InputValue     = $User
                SamAccountName = $ADUser.SamAccountName
                Status         = "Would Remove"
            }
        }
        else {

            $Results += [PSCustomObject]@{
                InputValue     = $User
                SamAccountName = $ADUser.SamAccountName
                Status         = "Not Found in Group"
            }
        }
    }
    catch {

        $Results += [PSCustomObject]@{
            InputValue     = $User
            SamAccountName = ""
            Status         = "User Not Found"
        }
    }
}

$Results | Export-Csv $LogFile -NoTypeInformation

Write-Host "Dry run completed. Results exported to $LogFile" -ForegroundColor Green

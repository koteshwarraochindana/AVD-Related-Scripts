
# ============================================================
# AVD SLOW LOGIN DIAGNOSTICS - READ ONLY
# Target user: u312963
# ============================================================

$User = "u312963"
$StartTime = [datetime]"2026-10-19 07:45:00"
$EndTime   = [datetime]"2026-10-19 08:15:00"

$LogsToCheck = @(
    "Application",
    "System",
    "Security",
    "Microsoft-Windows-User Profile Service/Operational",
    "Microsoft-Windows-GroupPolicy/Operational",
    "Microsoft-Windows-AppModel-State/Admin",
    "Microsoft-FSLogix-Apps/Admin",
    "Microsoft-FSLogix-Apps/Operational"
)

Write-Output "============================================================"
Write-Output "AVD SLOW LOGIN DIAGNOSTICS"
Write-Output "Computer : $env:COMPUTERNAME"
Write-Output "User     : $User"
Write-Output "Window   : $StartTime to $EndTime"
Write-Output "============================================================"

foreach ($LogName in $LogsToCheck) {

    $LogInfo = Get-WinEvent -ListLog $LogName -ErrorAction SilentlyContinue

    if (-not $LogInfo) {
        continue
    }

    Write-Output ""
    Write-Output "----- LOG: $LogName -----"

    $Events = Get-WinEvent -FilterHashtable @{
        LogName   = $LogName
        StartTime = $StartTime
        EndTime   = $EndTime
    } -MaxEvents 500 -ErrorAction SilentlyContinue |
        Sort-Object TimeCreated

    $Matches = @(
        $Events | Where-Object {
            $_.Level -in @(1, 2, 3) -or
            $_.Message -match [regex]::Escape($User) -or
            $_.ProviderName -match "FSLogix|GroupPolicy|User Profile|AppModel|Winlogon|Kerberos|LsaSrv|DNS"
        }
    )

    if ($Matches.Count -eq 0) {
        Write-Output "No matching warning, error, or relevant events found."
        continue
    }

    foreach ($Event in $Matches) {

        $Message = ($Event.Message -replace "`r?`n", " ").Trim()

        if ($Message.Length -gt 900) {
            $Message = $Message.Substring(0, 900) + "..."
        }

        Write-Output ("Time     : {0}" -f $Event.TimeCreated.ToString("yyyy-MM-dd HH:mm:ss"))
        Write-Output ("Provider : {0}" -f $Event.ProviderName)
        Write-Output ("Event ID : {0}" -f $Event.Id)
        Write-Output ("Level    : {0}" -f $Event.LevelDisplayName)
        Write-Output ("Message  : {0}" -f $Message)
        Write-Output "------------------------------------------------------------"
    }
}

# FSLogix text logs
$FSLogixPath = "C:\ProgramData\FSLogix\Logs"

Write-Output ""
Write-Output "===== FSLOGIX TEXT LOG SEARCH ====="

if (Test-Path $FSLogixPath) {

    Get-ChildItem $FSLogixPath -Recurse -File -ErrorAction SilentlyContinue |
        Where-Object {
            $_.LastWriteTime -ge $StartTime.AddHours(-1) -and
            $_.LastWriteTime -le $EndTime.AddHours(1) -and
            $_.Extension -in @(".log", ".txt")
        } |
        ForEach-Object {
            Select-String -Path $_.FullName `
                -Pattern $User, "error", "failed", "timeout", "attach", "loadProfile" `
                -SimpleMatch:$false -ErrorAction SilentlyContinue |
                Select-Object -First 30 |
                ForEach-Object {
                    Write-Output ("{0}: {1}" -f $_.Path, $_.Line.Trim())
                }
        }
}
else {
    Write-Output "FSLogix log directory not found."
}

Write-Output ""
Write-Output "===== DIAGNOSTICS COMPLETED ====="

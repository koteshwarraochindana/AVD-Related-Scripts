# ============================================================
# AVD Personal Desktop Migration Tool
# Same Host Pool - Domain Swap
#
# adhcscint.net <--> prd.hcscad.net
# ============================================================

# ------------------------------------------------------------
# CONFIGURATION
# ------------------------------------------------------------

$SubscriptionId    = "0ecf5d7c-dbde-4eaf-8fb4-df512ccd5d3e"
$ResourceGroupName = "PRD_NCentral_AVD_Corp4_Infra_RG"
$HostPoolName      = "AVD-CAS-CORP4-NC"

# Target domains for the swap
$OldDomain         = "adhcscint.net"
$NewDomain         = "prd.hcscad.net"

# ------------------------------------------------------------
# CONNECT AZURE
# ------------------------------------------------------------

Write-Host ""
Write-Host "Connecting to Azure..." -ForegroundColor Cyan

try {
    Set-AzContext -SubscriptionId $SubscriptionId -ErrorAction Stop | Out-Null
}
catch {
    Write-Host "Please run Connect-AzAccount first." -ForegroundColor Red
    return
}

# ------------------------------------------------------------
# USER INPUT
# ------------------------------------------------------------

Write-Host ""
$UserEmail = Read-Host "Enter Current User Email (e.g., user@$OldDomain)"

# Validate email format quickly
if ($UserEmail -notlike "*@*") {
    Write-Host "Invalid email format." -ForegroundColor Red
    return
}

# ------------------------------------------------------------
# GET SESSION HOSTS
# ------------------------------------------------------------

Write-Host ""
Write-Host "Loading session hosts..." -ForegroundColor Cyan

try {
    $AllHosts = Get-AzWvdSessionHost `
        -ResourceGroupName $ResourceGroupName `
        -HostPoolName $HostPoolName `
        -ErrorAction Stop
}
catch {
    Write-Host ""
    Write-Host "Failed to retrieve session hosts." -ForegroundColor Red
    Write-Host $_.Exception.Message -ForegroundColor Yellow
    return
}

# ------------------------------------------------------------
# FIND CURRENT ASSIGNMENT
# ------------------------------------------------------------

Write-Host ""
Write-Host "Searching for assigned desktop..." -ForegroundColor Cyan

# Find the host currently assigned to the target user
$AssignedHost = $AllHosts | Where-Object { $_.AssignedUser -eq $UserEmail }

if ($null -eq $AssignedHost) {
    Write-Host "No personal desktop found for user: $UserEmail" -ForegroundColor Red
    return
}

# Extract just the short name of the session host
$HostShortName = $AssignedHost.Name.Split('/')[-1]
Write-Host "Found Desktop: $HostShortName" -ForegroundColor Green

# ------------------------------------------------------------
# CALCULATE NEW UPN / SWAP DOMAIN
# ------------------------------------------------------------

# Generate the new email by replacing the old domain name
$NewUserEmail = $UserEmail.Replace($OldDomain, $NewDomain)

Write-Host ""
Write-Host "Ready to swap assignment:" -ForegroundColor Yellow
Write-Host "  From: $UserEmail" -ForegroundColor White
Write-Host "  To:   $NewUserEmail" -ForegroundColor White
Write-Host ""

$Confirm = Read-Host "Proceed with domain swap? (Y/N)"
if ($Confirm -ne "Y" -and $Confirm -ne "y") {
    Write-Host "Migration canceled." -ForegroundColor Red
    return
}

# ------------------------------------------------------------
# UPDATE ASSIGNMENT
# ------------------------------------------------------------

Write-Host ""
Write-Host "Updating AVD assignment..." -ForegroundColor Cyan

try {
    # Update the assigned user on the session host
    Update-AzWvdSessionHost `
        -ResourceGroupName $ResourceGroupName `
        -HostPoolName $HostPoolName `
        -Name $HostShortName `
        -AssignedUser $NewUserEmail `
        -ErrorAction Stop | Out-Null

    Write-Host "Success! Desktop $HostShortName has been migrated to $NewUserEmail." -ForegroundColor Green
}
catch {
    Write-Host "Failed to update session host assignment." -ForegroundColor Red
    Write-Host $_.Exception.Message -ForegroundColor Yellow
}

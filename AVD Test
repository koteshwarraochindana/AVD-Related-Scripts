Import-Module ActiveDirectory

$GroupName = "MSAZURE_PROD_AVD_CORP2_CAS2_SC"
$UserFile  = "C:\Temp\UsersToRemove.txt"

# Make sure the file exists first
if (-not (Test-Path $UserFile)) {
    Write-Error "Cannot find the file at $UserFile"
    return
}

$Users = Get-Content $UserFile

# Fetch group members using the safer -RecursiveMatch filter
try {
    Write-Host "Fetching group object..." -ForegroundColor Yellow
    $GroupDN = (Get-ADGroup -Identity $GroupName).DistinguishedName
    
    Write-Host "Safely scanning nested group members..." -ForegroundColor Yellow
    # This bypasses the Get-ADGroupMember bug completely
    $GroupMembers = Get-ADUser -Filter "memberOf -RecursiveMatch '$GroupDN'" | Select-Object -ExpandProperty SamAccountName
} catch {
    Write-Error "Could not read group '$GroupName'. Check your connection to the Domain Controller."
    return
}

# Create a list to hold the report data
$Results = [System.Collections.Generic.List[PSCustomObject]]::new()

Write-Host "Processing users. Please wait..." -ForegroundColor Yellow

foreach ($User in $Users) {
    try {
        if ($User -match "@") {
            $ADUser = Get-ADUser -Filter "UserPrincipalName -eq '$User'" -Properties UserPrincipalName -ErrorAction Stop
        } else {
            $ADUser = Get-ADUser -Identity $User -ErrorAction Stop
        }

        if ($GroupMembers -contains $ADUser.SamAccountName) {
            $Results.Add([PSCustomObject]@{
                InputValue     = $User
                SamAccountName = $ADUser.SamAccountName
                Status         = "Would Remove"
            })
        } else {
            $Results.Add([PSCustomObject]@{
                InputValue     = $User
                SamAccountName = $ADUser.SamAccountName
                Status         = "Not Found in Group"
            })
        }
    } 
    catch {
        $Results.Add([PSCustomObject]@{
            InputValue     = $User
            SamAccountName = "N/A"
            Status         = "User Not Found in AD"
        })
    }
}

# Print the final report right to the console window
Write-Host "`n======================= DRY RUN SUMMARY REPORT =======================" -ForegroundColor Green
$Results | Format-Table -AutoSize


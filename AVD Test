# ============================================================
# AVD Personal Desktop Migration Tool
# Same Host Pool - Domain Swap
#
# adhcscint.net <--> prd.hcscad.net
# ============================================================

# ------------------------------------------------------------
# CONFIGURATION
# ------------------------------------------------------------

$SubscriptionId    = "0ecf5d7c-dbde-4eaf-8fb4-df512ccd5d3e"
$ResourceGroupName = "PRD_NCentral_AVD_Corp4_Infra_RG"
$HostPoolName      = "AVD-CAS-CORP4-NC"

# ------------------------------------------------------------
# CONNECT AZURE
# ------------------------------------------------------------

Write-Host ""
Write-Host "Connecting to Azure..." -ForegroundColor Cyan

try {
    Set-AzContext -SubscriptionId $SubscriptionId -ErrorAction Stop | Out-Null
}
catch {
    Write-Host "Please run Connect-AzAccount first." -ForegroundColor Red
    return
}

# ------------------------------------------------------------
# USER INPUT
# ------------------------------------------------------------

Write-Host ""
$UserEmail = Read-Host "Enter User Email"

try {
    $ADUser = Get-AzADUser `
        -UserPrincipalName $UserEmail `
        -ErrorAction Stop
}
catch {
    Write-Host ""
    Write-Host "User not found." -ForegroundColor Red
    return
}

# ------------------------------------------------------------
# GET SESSION HOSTS
# ------------------------------------------------------------

Write-Host ""
Write-Host "Loading session hosts..." -ForegroundColor Cyan

try {

    $AllHosts = Get-AzWvdSessionHost `
        -ResourceGroupName $ResourceGroupName `
        -HostPoolName $HostPoolName `
        -ErrorAction Stop

}
catch {

    Write-Host ""
    Write-Host "Failed to retrieve session hosts." -ForegroundColor Red
    Write-Host $_.Exception.Message -ForegroundColor Yellow
    return
}

# ------------------------------------------------------------
# FIND CURRENT ASSIGNMENT
# ------------------------------------------------------------

$CurrentHost = $AllHosts | Where-Object {
    $_.AssignedUser -and
    $_.AssignedUser.ToLower() -eq $UserEmail.ToLower()
}

if (-not $CurrentHost) {

    Write-Host ""
    Write-Host "User has no current AVD assignment." -ForegroundColor Yellow
    return
}

$CurrentHostName = $CurrentHost.Name.Split("/")[-1]

# ------------------------------------------------------------
# DETERMINE DOMAIN
# ------------------------------------------------------------

if ($CurrentHostName.ToLower().Contains("adhcscint.net")) {

    $CurrentDomain = "adhcscint.net"
    $TargetDomain  = "prd.hcscad.net"

}
elseif ($CurrentHostName.ToLower().Contains("prd.hcscad.net")) {

    $CurrentDomain = "prd.hcscad.net"
    $TargetDomain  = "adhcscint.net"

}
else {

    Write-Host ""
    Write-Host "Unable to determine domain." -ForegroundColor Red
    Write-Host "Current Host : $CurrentHostName"
    return
}

# ------------------------------------------------------------
# FIND AVAILABLE TARGET HOSTS
# ------------------------------------------------------------

$AvailableHosts = $AllHosts | Where-Object {

    :IsNullOrWhiteSpace($_.AssignedUser) -and
    $_.Name.ToLower().Contains($TargetDomain.ToLower())
}

$AvailableCount = @($AvailableHosts).Count

if ($AvailableCount -eq 0) {

    Write-Host ""
    Write-Host "No available hosts found in $TargetDomain" -ForegroundColor Red
    return
}

$TopHosts = $AvailableHosts |
    Sort-Object Name |
    Select-Object -First 3

# ------------------------------------------------------------
# DISPLAY USER INFO
# ------------------------------------------------------------

Write-Host ""
Write-Host "=============================================================" -ForegroundColor Cyan
Write-Host "USER INFORMATION"
Write-Host "=============================================================" -ForegroundColor Cyan
Write-Host ""
Write-Host "User Name       : $($ADUser.DisplayName)"
Write-Host "User Email      : $UserEmail"
Write-Host ""
Write-Host "Current Host    : $CurrentHostName"
Write-Host "Current Domain  : $CurrentDomain"
Write-Host "Target Domain   : $TargetDomain"
Write-Host ""
Write-Host "Available Hosts : $AvailableCount"
Write-Host ""
Write-Host "Top Available Hosts"
Write-Host "-------------------"

$Counter = 1

foreach ($SessionHost in $TopHosts) {

    $Name = $SessionHost.Name.Split('/')[-1]

    Write-Host "$Counter. $Name"

    $Counter++
}

# ------------------------------------------------------------
# SELECT HOST
# ------------------------------------------------------------

Write-Host ""

$Selection = Read-Host "Select machine (1-$($TopHosts.Count))"

if (
    ($Selection -notmatch '^\d+$') -or
    ([int]$Selection -lt 1) -or
    ([int]$Selection -gt $TopHosts.Count)
) {
    Write-Host "Invalid selection." -ForegroundColor Red
    return
}

$TargetHost     = $TopHosts[[int]$Selection - 1]
$TargetHostName = $TargetHost.Name.Split('/')[-1]

# ------------------------------------------------------------
# REVIEW
# ------------------------------------------------------------

Write-Host ""
Write-Host "=============================================================" -ForegroundColor Yellow
Write-Host "REVIEW CHANGES"
Write-Host "=============================================================" -ForegroundColor Yellow
Write-Host ""
Write-Host "User         : $UserEmail"
Write-Host "Current Host : $CurrentHostName"
Write-Host "Target Host  : $TargetHostName"
Write-Host ""

$Confirm = Read-Host "Type YES to continue"

if ($Confirm -ne "YES") {

    Write-Host ""
    Write-Host "Operation cancelled." -ForegroundColor Yellow
    return
}

# ------------------------------------------------------------
# VERIFY TARGET HOST
# ------------------------------------------------------------

$LatestTarget = Get-AzWvdSessionHost `
    -ResourceGroupName $ResourceGroupName `
    -HostPoolName $HostPoolName `
    -Name $TargetHostName

if ($LatestTarget.AssignedUser) {

    Write-Host ""
    Write-Host "Target host is no longer available." -ForegroundColor Red
    return
}

# ------------------------------------------------------------
# REMOVE EXISTING ASSIGNMENT
# ------------------------------------------------------------

Write-Host ""
Write-Host "Removing current assignment..." -ForegroundColor Cyan

try {

    Update-AzWvdSessionHost `
        -ResourceGroupName $ResourceGroupName `
        -HostPoolName $HostPoolName `
        -Name $CurrentHostName `
        -AssignedUser "" `
        -Force `
        -ErrorAction Stop | Out-Null

    Write-Host "SUCCESS" -ForegroundColor Green

}
catch {

    Write-Host ""
    Write-Host "Failed to remove assignment." -ForegroundColor Red
    Write-Host $_.Exception.Message
    return
}

# ------------------------------------------------------------
# ASSIGN NEW HOST
# ------------------------------------------------------------

Write-Host ""
Write-Host "Assigning target host..." -ForegroundColor Cyan

try {

    Update-AzWvdSessionHost `
        -ResourceGroupName $ResourceGroupName `
        -HostPoolName $HostPoolName `
        -Name $TargetHostName `
        -AssignedUser $UserEmail `
        -ErrorAction Stop | Out-Null

    Write-Host "SUCCESS" -ForegroundColor Green

}
catch {

    Write-Host ""
    Write-Host "Assignment failed." -ForegroundColor Red
    Write-Host $_.Exception.Message

    return
}

# ------------------------------------------------------------
# SUMMARY
# ------------------------------------------------------------

Write-Host ""
Write-Host "=============================================================" -ForegroundColor Green
Write-Host "MIGRATION COMPLETED"
Write-Host "=============================================================" -ForegroundColor Green
Write-Host ""
Write-Host "User            : $UserEmail"
Write-Host "Old Host        : $CurrentHostName"
Write-Host "New Host        : $TargetHostName"
Write-Host "Current Domain  : $CurrentDomain"
Write-Host "Target Domain   : $TargetDomain"
Write-Host "Available Hosts : $AvailableCount"
Write-Host "Completed       : $(Get-Date)"
Write-Host ""

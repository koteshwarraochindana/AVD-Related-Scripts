
# ============================================================
# AVD SINGLE-SESSION SLOW LOGIN DIAGNOSTICS
# No FSLogix dependency - READ ONLY
# ============================================================

$User = "u312963"

# Confirm VM time zone before interpreting these timestamps.
$StartTime = Get-Date "10/19/2026 07:45:00"
$EndTime   = Get-Date "10/19/2026 08:20:00"

$Logs = @(
    "Application",
    "System",
    "Security",
    "Microsoft-Windows-User Profile Service/Operational",
    "Microsoft-Windows-GroupPolicy/Operational",
    "Microsoft-Windows-Winlogon/Operational",
    "Microsoft-Windows-TerminalServices-LocalSessionManager/Operational"
)

Write-Output "============================================================"
Write-Output "AVD SINGLE-SESSION LOGIN DIAGNOSTICS"
Write-Output "Computer : $env:COMPUTERNAME"
Write-Output "User     : $User"
Write-Output "From     : $StartTime"
Write-Output "To       : $EndTime"
Write-Output "============================================================"

foreach ($Log in $Logs) {

    $LogInfo = Get-WinEvent -ListLog $Log -ErrorAction SilentlyContinue

    if (-not $LogInfo) {
        Write-Output ""
        Write-Output "Log unavailable: $Log"
        continue
    }

    Write-Output ""
    Write-Output "===== $Log ====="

    $Events = Get-WinEvent -FilterHashtable @{
        LogName   = $Log
        StartTime = $StartTime
        EndTime   = $EndTime
    } -MaxEvents 500 -ErrorAction SilentlyContinue |
        Sort-Object TimeCreated

    $FilteredEvents = $Events | Where-Object {
        $_.Level -in @(1, 2, 3) -or
        $_.Message -match [regex]::Escape($User) -or
        $_.ProviderName -match 'Winlogon|User Profile|GroupPolicy|Kerberos|LsaSrv|Netlogon|DNS'
    }

    if (-not $FilteredEvents) {
        Write-Output "No matching events found."
        continue
    }

    foreach ($Event in $FilteredEvents) {

        $Message = ($Event.Message -replace '\s+', ' ').Trim()

        if ($Message.Length -gt 700) {
            $Message = $Message.Substring(0, 700) + "..."
        }

        Write-Output ("Time     : {0}" -f $Event.TimeCreated.ToString("yyyy-MM-dd HH:mm:ss"))
        Write-Output ("Provider : {0}" -f $Event.ProviderName)
        Write-Output ("Event ID : {0}" -f $Event.Id)
        Write-Output ("Level    : {0}" -f $Event.LevelDisplayName)
        Write-Output ("Message  : {0}" -f $Message)
        Write-Output "------------------------------------------------------------"
    }
}

Write-Output ""
Write-Output "===== DOMAIN AND DNS CHECKS ====="

try {
    $Domain = (Get-CimInstance Win32_ComputerSystem).Domain
    Write-Output "Domain: $Domain"

    if ((Get-CimInstance Win32_ComputerSystem).PartOfDomain) {
        Write-Output "Domain controller discovery:"
        nltest /dsgetdc:$Domain 2>&1

        Write-Output "Secure channel:"
        nltest /sc_verify:$Domain 2>&1
    }
    else {
        Write-Output "Machine is not domain joined."
    }

    Write-Output "Configured DNS servers:"
    Get-DnsClientServerAddress -AddressFamily IPv4 |
        Where-Object { $_.ServerAddresses } |
        Format-Table InterfaceAlias, ServerAddresses -AutoSize |
        Out-String |
        Write-Output
}
catch {
    Write-Output "Domain/DNS check failed: $($_.Exception.Message)"
}

Write-Output ""
Write-Output "===== DIAGNOSTICS COMPLETED ====="

# ============================================================
# AVD SLOW LOGIN ANALYSIS REPORT - LAST 72 HOURS
# ============================================================

$HoursBack = 72
$StartTime = (Get-Date).AddHours(-$HoursBack)
$ComputerName = $env:COMPUTERNAME

Write-Host ""
Write-Host "====================================================="
Write-Host "AVD SLOW LOGIN ANALYSIS"
Write-Host "HOST : $ComputerName"
Write-Host "LOOKBACK : $HoursBack Hours"
Write-Host "====================================================="
Write-Host ""

# ------------------------------------------------------------
# Collect Terminal Services Events
# ------------------------------------------------------------

$TSEvents = Get-WinEvent -FilterHashtable @{
    LogName = "Microsoft-Windows-TerminalServices-LocalSessionManager/Operational"
    StartTime = $StartTime
    Id = 21,22,24,25,41
} -ErrorAction SilentlyContinue | Sort-Object TimeCreated

$Sessions = @()
$CurrentSession = $null

foreach ($Event in $TSEvents)
{
    switch ($Event.Id)
    {
        41 {
            $CurrentSession = [ordered]@{
                SessionStart = $Event.TimeCreated
                AuthSuccess  = $null
                DesktopReady = $null
            }
        }

        21 {
            if ($CurrentSession)
            {
                $CurrentSession.AuthSuccess = $Event.TimeCreated
            }
        }

        22 {
            if ($CurrentSession -and
                $CurrentSession.SessionStart -and
                $CurrentSession.AuthSuccess)
            {
                $CurrentSession.DesktopReady = $Event.TimeCreated

                $AuthSec =
                    [math]::Round(
                        ($CurrentSession.AuthSuccess -
                         $CurrentSession.SessionStart).TotalSeconds,0)

                $DesktopSec =
                    [math]::Round(
                        ($CurrentSession.DesktopReady -
                         $CurrentSession.AuthSuccess).TotalSeconds,0)

                $TotalSec =
                    [math]::Round(
                        ($CurrentSession.DesktopReady -
                         $CurrentSession.SessionStart).TotalSeconds,0)

                $Sessions += [PSCustomObject]@{
                    Hostname          = $ComputerName
                    LoginStart        = $CurrentSession.SessionStart
                    AuthenticationSec = $AuthSec
                    DesktopLoadSec    = $DesktopSec
                    TotalLoginSec     = $TotalSec
                    Severity =
                        if($TotalSec -gt 120){"CRITICAL"}
                        elseif($TotalSec -gt 60){"HIGH"}
                        elseif($TotalSec -gt 30){"WARNING"}
                        else{"NORMAL"}
                }

                $CurrentSession = $null
            }
        }
    }
}

# ------------------------------------------------------------
# Diagnostics Performance (Winlogon Delays)
# ------------------------------------------------------------

$DiagEvents = Get-WinEvent -FilterHashtable @{
    LogName = "Microsoft-Windows-Diagnostics-Performance/Operational"
    StartTime = $StartTime
} -ErrorAction SilentlyContinue |
Where-Object {
    $_.Id -in 100,101,200,400,500
}

# ------------------------------------------------------------
# Group Policy Events
# ------------------------------------------------------------

$GPEvents = Get-WinEvent -FilterHashtable @{
    LogName = "Microsoft-Windows-GroupPolicy/Operational"
    StartTime = $StartTime
} -ErrorAction SilentlyContinue |
Select-Object TimeCreated,Id,LevelDisplayName

# ------------------------------------------------------------
# FSLogix Events
# ------------------------------------------------------------

$FSLogixEvents = Get-WinEvent -LogName `
    "Microsoft-FSLogix-Apps/Operational" `
    -ErrorAction SilentlyContinue |
Where-Object {
    $_.TimeCreated -ge $StartTime
}

# ------------------------------------------------------------
# Winlogon Events
# ------------------------------------------------------------

$WinlogonEvents = Get-WinEvent -FilterHashtable @{
    LogName = "Microsoft-Windows-Winlogon/Operational"
    StartTime = $StartTime
} -ErrorAction SilentlyContinue

# ------------------------------------------------------------
# Summary
# ------------------------------------------------------------

Write-Host ""
Write-Host "========== LOGIN PERFORMANCE ==========" -ForegroundColor Cyan

$Sessions |
Sort-Object LoginStart |
Format-Table -AutoSize

Write-Host ""
Write-Host "========== SLOW LOGINS (>30 SEC) ==========" -ForegroundColor Yellow

$Sessions |
Where-Object {$_.TotalLoginSec -gt 30} |
Sort-Object TotalLoginSec -Descending |
Format-Table -AutoSize

Write-Host ""
Write-Host "========== SUMMARY ==========" -ForegroundColor Green

$total = $Sessions.Count
$slow = ($Sessions | Where-Object {$_.TotalLoginSec -gt 30}).Count
$critical = ($Sessions | Where-Object {$_.TotalLoginSec -gt 120}).Count

Write-Host "Total Login Attempts : $total"
Write-Host "Slow Logins (>30s)   : $slow"
Write-Host "Critical (>120s)     : $critical"
Write-Host "FSLogix Events       : $($FSLogixEvents.Count)"
Write-Host "Winlogon Events      : $($WinlogonEvents.Count)"
Write-Host "GPO Events           : $($GPEvents.Count)"
Write-Host "Diag Events          : $($DiagEvents.Count)"

# ------------------------------------------------------------
# Export Files
# ------------------------------------------------------------

$Folder = "C:\Temp"

if (!(Test-Path $Folder))
{
    New-Item -Path $Folder -ItemType Directory -Force | Out-Null
}

$Sessions |
Export-Csv "$Folder\AVD_LoginAnalysis.csv" `
-NoTypeInformation

$FSLogixEvents |
Select TimeCreated,Id,LevelDisplayName,Message |
Export-Csv "$Folder\AVD_FSLogix.csv" `
-NoTypeInformation

$GPEvents |
Export-Csv "$Folder\AVD_GPO.csv" `
-NoTypeInformation

$WinlogonEvents |
Select TimeCreated,Id,Message |
VD_Winlogon.csv" `
-NoTypeInformation

Write-Host ""
Write-Host "CSV Files Saved To:"
Write-Host "$Folder"
Write-Host ""

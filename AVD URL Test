# Get local Hostname
$Hostname = $env:COMPUTERNAME

# Last 72 Hours
$StartDate = (Get-Date).AddHours(-72)

# Define the target local timezone for conversion (CST / CDT)
$LocalTimeZone = [System.TimeZoneInfo]::FindSystemTimeZoneById("Central Standard Time")

function Convert-ToLocalTime($UtcTime) {
    if ($null -eq $UtcTime) { return $null }
    return [System.TimeZoneInfo]::ConvertTime($UtcTime, $LocalTimeZone)
}

# Detect current local user sessions
$AVDSessions = Get-CimInstance -ClassName Win32_LogonSession | ForEach-Object {
    $SessionId = $_.LogonId

    if ($_.LogonType -in @(2,10)) {

        $UserQuery = Get-CimInstance -Query "Associators of {Win32_LogonSession.LogonId='$SessionId'} Where AssocClass=Win32_LoggedOnUser" -ErrorAction SilentlyContinue

        if ($UserQuery -and $UserQuery.Name -notin @('SYSTEM','NETWORK SERVICE','LOCAL SERVICE','Administrator')) {

            $QState = qwinsta $UserQuery.Name 2>$null | ForEach-Object {
                if ($_ -match 'Active') { 'Active' }
                elseif ($_ -match 'Disc') { 'Disconnected' }
            } | Select-Object -First 1

            [PSCustomObject]@{
                Username = $UserQuery.Name
                State    = if ($QState) { $QState } else { 'Disconnected' }
            }
        }
    }
} | Where-Object { $null -ne $_ } |
    Group-Object Username |
    ForEach-Object { $_.Group }

$UserSession  = $AVDSessions | Select-Object -First 1
$User         = $UserSession.Username
$SessionState = $UserSession.State

# ------------------------------------------------------------
# FALLBACK IF NO USER FOUND
# ------------------------------------------------------------

if ([string]::IsNullOrWhiteSpace($User)) {

    $BootTime = (Get-CimInstance Win32_OperatingSystem).LastBootUpTime
    $LocalBootTime = Convert-ToLocalTime $BootTime

    $FormattedBootTime = (Get-Date $LocalBootTime -Format "MM/dd/yyyy h:mm:ss tt") + " (CST)"

    $UptimeSpan = (Get-Date) - $BootTime

    $UptimeDisplay = "{0} Hours, {1} Minutes" -f `
        [math]::Floor($UptimeSpan.TotalHours),
        $UptimeSpan.Minutes

    $Event6005 = Get-WinEvent -FilterHashtable @{
        LogName='System'
        Id=6005
        StartTime=$BootTime.AddMinutes(-1)
    } -MaxEvents 1 -ErrorAction SilentlyContinue

    $BootTimeDisplay = if ($Event6005) {
        "$([math]::Round(($Event6005.TimeCreated - $BootTime).TotalSeconds,0)) Seconds"
    }
    else {
        "Unknown"
    }

    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Cyan
    Write-Host "CURRENT VM STATUS" -ForegroundColor Cyan
    Write-Host "============================================================" -ForegroundColor Cyan
    Write-Host "  Hostname           : $Hostname"
    Write-Host "  Last Boot Time     : $FormattedBootTime"
    Write-Host "  VM Boot Time Taken : $BootTimeDisplay"
    Write-Host "  Uptime             : $UptimeDisplay"
    Write-Host ""
    Write-Host "[✓] CONFIRMED: No active or disconnected AVD sessions detected on this machine." -ForegroundColor Green
    Write-Host "============================================================" -ForegroundColor Cyan

    exit 0
}

# ------------------------------------------------------------
# VM STATUS
# ------------------------------------------------------------

$BootTime = (Get-CimInstance Win32_OperatingSystem).LastBootUpTime
$LocalBootTime = Convert-ToLocalTime $BootTime

$FormattedBootTime = (Get-Date $LocalBootTime -Format "MM/dd/yyyy h:mm:ss tt") + " (CST)"

$UptimeSpan = (Get-Date) - $BootTime

$UptimeDisplay = "{0} Hours, {1} Minutes" -f `
    [math]::Floor($UptimeSpan.TotalHours),
    $UptimeSpan.Minutes

$Event6005 = Get-WinEvent -FilterHashtable @{
    LogName='System'
    Id=6005
    StartTime=$BootTime.AddMinutes(-1)
} -MaxEvents 1 -ErrorAction SilentlyContinue

$BootTimeDisplay = if ($Event6005) {
    "$([math]::Round(($Event6005.TimeCreated - $BootTime).TotalSeconds,0)) Seconds"
}
else {
    "Log Missing"
}

# ------------------------------------------------------------
# LAST DISCONNECT EVENT (WITHIN 72 HOURS)
# ------------------------------------------------------------

$DisconnectEvent = Get-WinEvent -FilterHashtable @{
    LogName='Microsoft-Windows-TerminalServices-LocalSessionManager/Operational'
    Id=24
    StartTime=$StartDate
} -ErrorAction SilentlyContinue |
Where-Object { $_.Message -match $User } |
Sort-Object TimeCreated -Descending |
Select-Object -First 1

if ($SessionState -eq 'Disconnected' -and $DisconnectEvent) {

    $DisconnectTime = $DisconnectEvent.TimeCreated

    $LocalDisconnectTime =
        (Convert-ToLocalTime $DisconnectTime).ToString() + " (CST)"

    $IdleSpan = (Get-Date) - $DisconnectTime

    $IdleDisplay = "{0} Hours, {1} Minutes" -f `
        [math]::Floor($IdleSpan.TotalHours),
        $IdleSpan.Minutes
}
else {
    $LocalDisconnectTime = "N/A (User is currently Active)"
    $IdleDisplay = "N/A"
}

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "AVD AUDIT REPORT FOR DETECTED USER: $User ($SessionState) - LAST 72 HOURS" -ForegroundColor Yellow
Write-Host "============================================================" -ForegroundColor Cyan

# ------------------------------------------------------------
# DISPLAY CURRENT VM STATUS
# ------------------------------------------------------------

Write-Host ""
Write-Host "CURRENT VM STATUS:" -ForegroundColor Cyan
Write-Host "  Hostname           : $Hostname"
Write-Host "  Target User        : $User"
Write-Host "  Last Boot Time     : $FormattedBootTime"
Write-Host "  VM Boot Time Taken : $BootTimeDisplay"
Write-Host "  Current State      : $SessionState"
Write-Host "  Disconnected At    : $LocalDisconnectTime"
Write-Host "  Total Idle Time    : $IdleDisplay"
Write-Host "  Uptime             : $UptimeDisplay"

# ------------------------------------------------------------
# LOGIN EVENTS - LAST 72 HOURS
# ------------------------------------------------------------

$Events = Get-WinEvent -FilterHashtable @{
    LogName='Microsoft-Windows-TerminalServices-LocalSessionManager/Operational'
    StartTime=$StartDate
    Id=21,22,41,42
} -ErrorAction SilentlyContinue |
Where-Object { $_.Message -match $User } |
Sort-Object TimeCreated

$StartTime = $null
$LogonTime = $null
$SummaryGenerated = $false

foreach ($Event in $Events            $StartTime = $Event.TimeCreated
        }

        21 {
            $LogonTime = $Event.TimeCreated
        }

        22 {

            if ($StartTime -and $LogonTime -and ($StartTime.Date -eq $Event.TimeCreated.Date)) {

                $SummaryGenerated = $true

                $AuthenticationSec = :Round(
                    ($LogonTime - $StartTime).TotalSeconds,0
                )

                $DesktopLoadSec = :Round(
                    ($Event.TimeCreated - $LogonTime).TotalSeconds,0
                )

                $TotalLoginSec = :Round(
                    ($Event.TimeCreated - $StartTime).TotalSeconds,0
                )

                if ($TotalLoginSec -gt 120) {
                    $Severity = "CRITICAL"
                }
                elseif ($TotalLoginSec -gt 60) {
                    $Severity = "HIGH"
                }
                elseif ($TotalLoginSec -gt 30) {
                    $Severity = "WARNING"
                }
                else {
                    $Severity = "NORMAL"
                }

                Write-Host ""
                Write-Host "------------------------------------------------------------"
                Write-Host "Login Event"
                Write-Host "------------------------------------------------------------"

                Write-Host "  Login Started      : $((Convert-ToLocalTime $StartTime).ToString()) (CST)"
                Write-Host "  Logon Succeeded    : $((Convert-ToLocalTime $LogonTime).ToString()) (CST)"
                Write-Host "  Desktop Ready      : $((Convert-ToLocalTime $Event.TimeCreated).ToString()) (CST)"
                Write-Host "  AuthenticationSec  : $AuthenticationSec"
                Write-Host "  DesktopLoadSec     : $DesktopLoadSec"
                Write-Host "  TotalLoginSec      : $TotalLoginSec"
                Write-Host "  Severity           : $Severity"

                $StartTime = $null
                $LogonTime = $null
            }
        }
    }
}

if (-not $SummaryGenerated) {

    Write-Host ""
    Write-Host "No matching login events found for user '$User' during the last 72 hours." -ForegroundColor Yellow
}

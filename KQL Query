# ==================================================================================== #
# AVD Restart Investigation Script - Production Version (PS 5.1 & 7+ Compatible)       #
# ==================================================================================== #

$DaysToCheck = 7
$CSTZone = [System.TimeZoneInfo]::FindSystemTimeZoneById("Central Standard Time")
$Hostname = $env:COMPUTERNAME

Write-Host "====================================================" -ForegroundColor Green
Write-Host " Generating AVD Reboot Report for Host: $Hostname " -ForegroundColor Green
Write-Host " Timezone Target: Central Standard Time (CST)       " -ForegroundColor Green
Write-Host " Investigation Window: 5 Hours Prior to Each Reboot " -ForegroundColor Green
Write-Host "====================================================" -ForegroundColor Green
Write-Host ""

for ($i = 0; $i -lt $DaysToCheck; $i++) {
    
    $TargetDayCST = ([System.TimeZoneInfo]::ConvertTime((Get-Date), $CSTZone)).AddDays(-$i).Date
    $TargetDayName = $TargetDayCST.ToString("dddd")
    $TargetDateString = $TargetDayCST.ToString("MM/dd/yyyy")
    
    Write-Host "----------------------------------------------------" -ForegroundColor Gray
    Write-Host " PROCESSING: $TargetDayName ($TargetDateString)" -ForegroundColor Yellow
    Write-Host "----------------------------------------------------" -ForegroundColor Gray

    $DayStartUTC = [System.TimeZoneInfo]::ConvertTime($TargetDayCST, $CSTZone).ToUniversalTime()
    $DayEndUTC   = $DayStartUTC.AddDays(1)

    # 1. Fetch reboot events
    $RestartEvents = @(Get-WinEvent -FilterHashtable @{
        LogName   = 'System'
        Id        = 1074, 6008, 41
        StartTime = $DayStartUTC
    } -ErrorAction SilentlyContinue | Where-Object { $_.TimeCreated -lt $DayEndUTC } | Sort-Object TimeCreated -Descending)

    if ($RestartEvents.Count -eq 0) {
        Write-Host " -> No restart events recorded on this day.`n" -ForegroundColor Gray
        continue
    }

    # 2. Process each reboot
    foreach ($RestartEvent in $RestartEvents) {
        $RestartTime    = $RestartEvent.TimeCreated
        $RestartTimeCST = [System.TimeZoneInfo]::ConvertTime($RestartTime, $CSTZone)

        $RestartType = switch ($RestartEvent.Id) {
            1074 { "Planned Restart" }
            41   { "System Crash / Power Failure" }
            6008 { "Unexpected Shutdown" }
            default { "Unknown" }
        }

        # 3. Gather session activity 5 hours before reboot
        $StartTimeLimit = $RestartTime.AddHours(-5)
        $SessionEvents = @(Get-WinEvent -FilterHashtable @{
            LogName   = 'Microsoft-Windows-TerminalServices-LocalSessionManager/Operational'
            Id        = 21, 24, 25, 39, 40
            StartTime = $StartTimeLimit
        } -ErrorAction SilentlyContinue | Where-Object { $_.TimeCreated -le $RestartTime } | Sort-Object TimeCreated)

        # 4. Determine last user activity details
        $LastSessionEvent = $SessionEvents | Where-Object { $_.Message -match "User:\s*([^\s,]+)" } | Select-Object -Last 1
        $UserState        = "No Activity Found"
        $UserName         = "N/A"
        $NarrativeText    = ""

        if ($LastSessionEvent) {
            $UserState = switch ($LastSessionEvent.Id) {
                21 { "Active (Logged In)" }
                24 { "Disconnected" }
                25 { "Reconnected / Active" }
                39 { "Disconnected By System" }
                40 { "Connection Handshake" }
            }
            if ($LastSessionEvent.Message -match "User:\s*([^\s,]+)") {
                $RawUser = $Matches[1]
                $UserName = if ($RawUser -match "\\(.*)") { $Matches[1] } else { $RawUser }
            }

            # 5. Calculate exact duration gaps for the summary text
            $LastUserTimeCST = [System.TimeZoneInfo]::ConvertTime($LastSessionEvent.TimeCreated, $CSTZone)
            $TimeDiff = $RestartTimeCST - $LastUserTimeCST
            
            $DurationString = ""
            if ($TimeDiff.Hours -gt 0) {
                $DurationString += "$($TimeDiff.Hours) hour" + ($TimeDiff.Hours -gt 1 ? "s" : "") + " and "
            }
            $DurationString += "$($TimeDiff.Minutes) minute" + ($TimeDiff.Minutes -gt 1 ? "s" : "") + " later"

            $ActionVerb = switch ($LastSessionEvent.Id) {
                21 { "logged in" }
                24 { "disconnected" }
                25 { "reconnected" }
                39 { "was disconnected by the system" }
                40 { "disconnected (handshake)" }
                default { "had activity" }
            }

            $NarrativeText = "• On $TargetDayName, user ($UserName) $ActionVerb at $($LastUserTimeCST.ToString('hh:mm tt')), but the reboot didn't happen until $($RestartTimeCST.ToString('hh:mm tt')) ($DurationString)."
        } else {
            $NarrativeText = "• On $TargetDayName, a reboot happened at $($RestartTimeCST.ToString('hh:mm tt')), but no user activity was recorded in the 5 hours prior."
        }

        # 6. Safe String Parsing for Initiator and Comments (replaces ternary operators)
        $InitiatedBy = "N/A"
        $Comment     = "N/A"

        if ($RestartEvent.Message -match "on behalf of user (.*?) for") {
            $InitiatedBy = $Matches[1].Trim()
        }
        if ($RestartEvent.Message -match "Comment:\s*(.*)") {
            $Comment = $Matches[1].Trim()
        }

        # Display the Daily Summary Block
        $Summary = [PSCustomObject]@{
            "Event ID"        = $RestartEvent.Id
            "Restart Type"    = $RestartType
            "Time (CST)"      = $RestartTimeCST.ToString("hh:mm:ss tt")
            "Last Active Usr" = $UserName
            "Session State"   = $UserState
            "Initiated By"    = $InitiatedBy
            "Shutdown Comment"= $Comment
        }
        $Summary | Format-List
        
        # Output the easy-to-read narrative highlight block
        Write-Host "💡 EXECUTIVE ANALYSIS SUMMARY:" -ForegroundColor Yellow
        Write-Host $NarrativeText -ForegroundColor White
        Write-Host ""

        # 7. Display the localized pre-reboot timeline
        if ($SessionEvents.Count -gt 0) {
            Write-Host "   >>> Pre-Restart Session Activity (5-Hour Window):" -ForegroundColor Cyan
            
            $TimelineTable = New-Object System.Collections.Generic.List[PSCustomObject]
            
            foreach ($Event in $SessionEvents) {
                $LineUser = "N/A"
                if ($Event.Message -match "User:\s*([^\s,]+)") {
                    $RawLineUser = $Matches[1]
                    $LineUser = if ($RawLineUser -match "\\(.*)") { $Matches[1] } else { $RawLineUser }
                }
                
                $Reason = "N/A"
                if ($Event.Message -match "reason code\s+([0-9]+)") {
                    $Code = $Matches[1]
                    $Reason = switch ($Code) {
                        0  { "Normal Logoff/Disconnect" }
                        5  { "Network Timeout/Closed Client" }
                        11 { "Idle Timeout GPO" }
                        12 { "Disconnected Session Timeout GPO" }
                        default { "Code $Code" }
                    }
                }
                
                $ActionName = switch ($Event.Id) {
                    21 { "Logon" }
                    24 { "Disconnect" }
                    25 { "Reconnect" }
                    39 { "Sys-Disconnect" }
                    40 { "Handshake" }
                }

                $TimelineTable.Add([PSCustomObject]@{
                    "Time (CST)"        = [System.TimeZoneInfo]::ConvertTime($Event.TimeCreated, $CSTZone).ToString("hh:mm:ss tt")
                    "EventID"           = $Event.Id
                    "User"              = $LineUser
                    "Action"            = $ActionName
                    "Disconnect Reason" = $Reason
                })
            }
            
            $TimelineTable | Format-Table -AutoSize
        }
    }
    Write-Host ""
}

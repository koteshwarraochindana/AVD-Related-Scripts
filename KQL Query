$profiles = Get-ChildItem "C:\Users" -Directory | 
Where-Object { 
    $_.Name -notin @("Public","Default","Default User","All Users") 
} 
$results = foreach ($p in $profiles) { 
    [PSCustomObject]@{ 
        ProfileName  = $p.Name 
        CreationTime = $p.CreationTime 
        LastWriteTime = $p.LastWriteTime 
    } 
} 
$results | Sort-Object CreationTime | Format-Table -AutoSize 
"Total User Profiles: $($profiles.Count)"

# Authenticate once using device code before starting the loop
Connect-AzAccount -UseDeviceAuthentication

# Define CSV Path (Update this path to where your CSV is saved)
$csvFilePath = "C:\path\to\your\vms.csv"
$vmsData = Import-Csv -Path $csvFilePath

Write-Output "Loaded $($vmsData.Count) target machines for OS disk expansion."

foreach ($row in $vmsData) {
    $subId   = $row.SubscriptionId
    $rgName  = $row.ResourceGroupName
    $vmName  = $row.VMName
    $sizeGB  = [int]$row.NewSizeGB

    Write-Output "============================================================"
    Write-Output "Processing machine: $vmName [RG: $rgName]"
    Write-Output "============================================================"

    try {
        # Check current context to avoid redundant subscription switches
        $currentContext = Get-AzContext
        if ($currentContext.Subscription.Id -ne $subId) {
            Write-Output "[$vmName] Switching Azure context to Subscription ID: $subId..."
            Set-AzContext -SubscriptionId $subId -ErrorAction Stop
        }

        # Fetch live VM data to check the current disk size configuration
        $vm = Get-AzVM -ResourceGroupName $rgName -Name $vmName -ErrorAction Stop
        $currentDiskSize = $vm.StorageProfile.OsDisk.DiskSizeGB

        # --- NEW CONDITIONAL LOGIC ---
        if ($currentDiskSize -ge $sizeGB) {
            Write-Output "[$vmName] Azure OS disk size is already $currentDiskSize GB. Skipping Azure hardware modification..."
            
            # Verify if the VM is running. If it's stopped, we need to start it to run the guest script.
            $status = (Get-AzVM -ResourceGroupName $rgName -Name $vmName -Status).Statuses.DisplayStatus
            if ($status -notcontains "VM running") {
                Write-Output "[$vmName] VM is not running (Current: $status). Powering up to run expansion..."
                Start-AzVM -ResourceGroupName $rgName -Name $vmName -ErrorAction Stop
                while ($true) {
                    if ((Get-AzVM -ResourceGroupName $rgName -Name $vmName -Status).Statuses.DisplayStatus -contains "VM running") { break }
                    Start-Sleep -Seconds 15
                }
                Start-Sleep -Seconds 30
            }
        } else {
            # Execute standard resize workflow if the disk size needs increasing in Azure
            Write-Output "[$vmName] Current disk size ($currentDiskSize GB) is less than target ($sizeGB GB). Proceeding with resize..."

            # Step 1: Deallocate the VM
            Write-Output "[$vmName] Requesting deallocation (Shutting down VM)..."
            Stop-AzVM -ResourceGroupName $rgName -Name $vmName -Force -NoWait -ErrorAction Stop

            while ($true) {
                $status = (Get-AzVM -ResourceGroupName $rgName -Name $vmName -Status).Statuses.DisplayStatus
                if ($status -contains "VM deallocated") { break }
                Start-Sleep -Seconds 15
            }

            # Step 2: Update Azure Storage profile metadata
            Write-Output "[$vmName] Increasing Azure OS disk configuration to $sizeGB GB..."
            $vm.StorageProfile.OsDisk.DiskSizeGB = $sizeGB
            Update-AzVM -ResourceGroupName $rgName -VM $vm -ErrorAction Stop

            # Step 3: Start the VM back up
            Write-Output "[$vmName] Booting machine back up..."
            Start-AzVM -ResourceGroupName $rgName -Name $vmName -ErrorAction Stop

            while ($true) {
                $status = (Get-AzVM -ResourceGroupName $rgName -Name $vmName -Status).Statuses.DisplayStatus
                if ($status -contains "VM running") { break }
                Start-Sleep -Seconds 15
            }
            Start-Sleep -Seconds 30
        }

        # Step 4: Run the In-Guest Volume Extension (Always runs to ensure partition is extended)
        Write-Output "[$vmName] Injecting partition adjustment logic into Windows guest OS..."
        
        $guestScriptBlock = @'
        Update-HostStorageCache
        $RecoveryPartition = Get-Partition -DiskNumber 0 | Where-Object Type -eq 'Recovery'
        if ($RecoveryPartition) {
            $RecoveryPartition | Remove-Partition -Confirm:$false -ErrorAction SilentlyContinue
        }
        Update-HostStorageCache
        $supportedSize = Get-PartitionSupportedSize -DriveLetter C
        Resize-Partition -DriveLetter C -Size $supportedSize.SizeMax
'@

        $commandResult = Invoke-AzVMRunCommand -ResourceGroupName $rgName -VMName $vmName -CommandId 'RunPowerShellScript' -ScriptString $guestScriptBlock -ErrorAction Stop
        Write-Output "[$vmName] Windows Response: $($commandResult.Value.Message)"
        Write-Output "[$vmName] Process finalized successfully."

    }
    catch {
        Write-Error "CRITICAL FAILURE on machine $vmName : $_"
    }
}

Write-Output "============================================================"
Write-Output "Batch process completed."
Write-Output "============================================================"

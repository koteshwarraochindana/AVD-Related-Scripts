$Path = "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services"

Write-Host "`n=== RDS SESSION TIMEOUT POLICY ===" -ForegroundColor Cyan

if (Test-Path $Path) {
    Get-ItemProperty -Path $Path |
    Select-Object MaxIdleTime, MaxDisconnectionTime,
                  MaxConnectionTime, fResetBroken |
    Format-List
}
else {
    Write-Host "No RDS policy registry key found."
}

Write-Host "`n=== APPLIED GROUP POLICIES ===" -ForegroundColor Cyan

gpresult /scope computer /r

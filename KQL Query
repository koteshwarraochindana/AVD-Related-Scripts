# Authenticate once using device code before starting the loop
Connect-AzAccount -UseDeviceAuthentication

# Define CSV Path (Update this path to where your CSV is saved)
$csvFilePath = "C:\path\to\your\vms.csv"
$vmsData = Import-Csv -Path $csvFilePath

$totalVMs = $vmsData.Count
$currentIndex = 0

Write-Host "============================================================" -ForegroundColor Cyan
Write-Host " STARTING OS DISK EXPANSION PROCESS FOR $totalVMs TARGET MACHINES" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan

foreach ($row in $vmsData) {
    $currentIndex++
    $subId   = $row.SubscriptionId
    $rgName  = $row.ResourceGroupName
    $vmName  = $row.VMName
    $sizeGB  = [int]$row.NewSizeGB

    Write-Host "`n"
    Write-Host "==========================================================================================" -ForegroundColor Gray
    Write-Host " [$currentIndex / $totalVMs] TARGET HOST: $vmName " -ForegroundColor Black -BackgroundColor Cyan
    Write-Host " Resource Group: $rgName" -ForegroundColor Gray
    Write-Host "==========================================================================================" -ForegroundColor Gray

    try {
        # Check current context to avoid redundant subscription switches
        $currentContext = Get-AzContext
        if ($currentContext.Subscription.Id -ne $subId) {
            Write-Host "[$vmName] Switching Azure context to Subscription ID: $subId..." -ForegroundColor Yellow
            Set-AzContext -SubscriptionId $subId -ErrorAction Stop | Out-Null
        }

        # Fetch live VM data to check the current disk size configuration
        $vm = Get-AzVM -ResourceGroupName $rgName -Name $vmName -ErrorAction Stop
        $currentDiskSize = $vm.StorageProfile.OsDisk.DiskSizeGB

        if ($currentDiskSize -ge $sizeGB) {
            Write-Host "[$vmName] Azure OS disk size is already $currentDiskSize GB. Skipping Azure hardware modification..." -ForegroundColor Green
            
            # Verify if the VM is running. If it's stopped, we need to start it to run the guest script.
            $status = (Get-AzVM -ResourceGroupName $rgName -Name $vmName -Status).Statuses.DisplayStatus
            if ($status -notcontains "VM running") {
                Write-Host "[$vmName] VM is not running (Current: $status). Powering up to run expansion..." -ForegroundColor Yellow
                Start-AzVM -ResourceGroupName $rgName -Name $vmName -ErrorAction Stop | Out-Null
                while ($true) {
                    if ((Get-AzVM -ResourceGroupName $rgName -Name $vmName -Status).Statuses.DisplayStatus -contains "VM running") { break }
                    Start-Sleep -Seconds 15
                }
                Start-Sleep -Seconds 30
            }
        } else {
            Write-Host "[$vmName] Current disk size ($currentDiskSize GB) is less than target ($sizeGB GB). Proceeding with resize..." -ForegroundColor Yellow

            # Step 1: Deallocate the VM
            Write-Host "[$vmName] Requesting deallocation (Shutting down VM)..." -ForegroundColor Yellow
            Stop-AzVM -ResourceGroupName $rgName -Name $vmName -Force -NoWait -ErrorAction Stop | Out-Null

            while ($true) {
                $status = (Get-AzVM -ResourceGroupName $rgName -Name $vmName -Status).Statuses.DisplayStatus
                if ($status -contains "VM deallocated") { break }
                Start-Sleep -Seconds 15
            }

            # Step 2: Update Azure Storage profile metadata
            Write-Host "[$vmName] Increasing Azure OS disk configuration to $sizeGB GB..." -ForegroundColor Yellow
            $vm.StorageProfile.OsDisk.DiskSizeGB = $sizeGB
            Update-AzVM -ResourceGroupName $rgName -VM $vm -ErrorAction Stop | Out-Null

            # Step 3: Start the VM back up
            Write-Host "[$vmName] Booting machine back up..." -ForegroundColor Yellow
            Start-AzVM -ResourceGroupName $rgName -Name $vmName -ErrorAction Stop | Out-Null

            while ($true) {
                $status = (Get-AzVM -ResourceGroupName $rgName -Name $vmName -Status).Statuses.DisplayStatus
                if ($status -contains "VM running") { break }
                Start-Sleep -Seconds 15
            }
            Start-Sleep -Seconds 30
        }

        # Step 4: Run the In-Guest Volume Extension with Storage Timing Fixes
        Write-Host "[$vmName] Injecting partition adjustment logic into Windows guest OS..." -ForegroundColor Yellow
        
        $guestScriptBlock = @'
        # 1. Force Windows storage layer to refresh and see the new unallocated space
        Update-HostStorageCache

        # 2. Find and remove the stubborn Recovery Partition blocking the C: partition expansion
        $RecoveryPartition = Get-Partition -DiskNumber 0 | Where-Object Type -eq 'Recovery'
        if ($RecoveryPartition) {
            $RecoveryPartition | Remove-Partition -Confirm:$false -ErrorAction SilentlyContinue
            # CRITICAL TIMING FIX: Give Windows storage subsystem 5 seconds to commit partition changes
            Start-Sleep -Seconds 5
        }

        # 3. Refresh disk layout after removal to merge unallocated pools
        Update-HostStorageCache
        Start-Sleep -Seconds 2

        # 4. Grab maximum available safe boundary for the C partition and resize it
        $supportedSize = Get-PartitionSupportedSize -DriveLetter C
        Resize-Partition -DriveLetter C -Size $supportedSize.SizeMax
'@

        $commandResult = Invoke-AzVMRunCommand -ResourceGroupName $rgName -VMName $vmName -CommandId 'RunPowerShellScript' -ScriptString $guestScriptBlock -ErrorAction Stop
        
        Write-Host "[$vmName] Windows Response: $($commandResult.Value.Message)" -ForegroundColor White
        Write-Host "[$vmName] Process finalized successfully." -ForegroundColor Green

    }
    catch {
        Write-Host "CRITICAL FAILURE on machine $vmName : $_" -ForegroundColor Red
    }
}

Write-Host "`n============================================================" -ForegroundColor Cyan
Write-Host " Batch process completed for all listed CSV hosts." -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan

# ==========================================================
# AVD IDLE TIMER INVESTIGATION
# Read-only event collection
# ==========================================================

$StartTime = (Get-Date).AddHours(-24)
$Output = "C:\Windows\Temp\AVD_IdleTimer_Events.txt"

$Logs = @(
    "System",
    "Security",
    "Microsoft-Windows-GroupPolicy/Operational",
    "Microsoft-Windows-TerminalServices-LocalSessionManager/Operational",
    "Microsoft-Windows-TerminalServices-RemoteConnectionManager/Operational",
    "Microsoft-Windows-TaskScheduler/Operational"
)

"AVD IDLE TIMER INVESTIGATION" | Out-File $Output
"Computer: $env:COMPUTERNAME" | Out-File $Output -Append
"Start: $StartTime" | Out-File $Output -Append

foreach ($Log in $Logs) {

    "`n==================================================" |
        Out-File $Output -Append

    "LOG: $Log" | Out-File $Output -Append

    "==================================================" |
        Out-File $Output -Append

    try {
        $Events = Get-WinEvent -FilterHashtable @{
            LogName   = $Log
            StartTime = $StartTime
        } -ErrorAction Stop

        foreach ($Event in $Events) {

            $Message = $Event.Message -replace "`r?`n", " "

            "$($Event.TimeCreated) | ID: $($Event.Id) | Provider: $($Event.ProviderName) | $Message" |
                Out-File $Output -Append
        }
    }
    catch {
        "Unable to read log or no events: $_" |
            Out-File $Output -Append
    }
}

Write-Host "`nReport generated: $Output" -ForegroundColor Green

$rdInfraPath = "C:\Program Files\Microsoft RDInfra"

# Locate the newest RDAgent version folder containing WVDAgentUrlTool.exe
$tool = Get-ChildItem -Path $rdInfraPath -Filter "WVDAgentUrlTool.exe" -Recurse -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

if ($tool) {
    Write-Output "Running tool from: $($tool.DirectoryName)"
    Write-Output "--------------------------------------------------"
    
    # Change directory so the tool finds WVDAgentUrlTool.config in the same folder
    Set-Location -Path $tool.DirectoryName
    & ".\WVDAgentUrlTool.exe"
} else {
    Write-Error "WVDAgentUrlTool.exe was not found in $rdInfraPath."
}

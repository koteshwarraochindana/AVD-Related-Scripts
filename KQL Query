Write-Host "`n========== DISK DETAILS ==========" -ForegroundColor Cyan

Get-Disk |
    Format-List Number, FriendlyName, PartitionStyle, OperationalStatus,
                HealthStatus, Size, LargestFreeExtent, IsBoot, IsSystem

Write-Host "`n========== PARTITION LAYOUT ==========" -ForegroundColor Cyan

Get-Partition -DiskNumber 0 |
    Sort-Object Offset |
    Format-Table PartitionNumber, DriveLetter, Type, GptType,
                 @{N="SizeGB";E={[math]::Round($_.Size / 1GB,2)}},
                 @{N="OffsetGB";E={[math]::Round($_.Offset / 1GB,2)}} -AutoSize

Write-Host "`n========== VOLUME DETAILS ==========" -ForegroundColor Cyan

Get-Volume |
    Format-Table DriveLetter, FileSystemLabel, FileSystem,
                 @{N="SizeGB";E={[math]::Round($_.Size / 1GB,2)}},
                 @{N="FreeGB";E={[math]::Round($_.SizeRemaining / 1GB,2)}} -AutoSize

Write-Host "`n========== C: EXTENSION TEST ==========" -ForegroundColor Cyan

try {
    Get-PartitionSupportedSize -DriveLetter C -ErrorAction Stop |
        Format-List *
}
catch {
    Write-Host "Get-PartitionSupportedSize FAILED" -ForegroundColor Red
    Write-Host "Exception: $($_.Exception.ToString())"
    Write-Host "Inner exception: $($_.Exception.InnerException)"
}

Write-Host "`n========== WINRE STATUS ==========" -ForegroundColor Cyan

reagentc /info

Write-Host "`n========== STORAGE MODULE ==========" -ForegroundColor Cyan

Get-Module Storage -ListAvailable |
    Select-Object Name, Version, Path

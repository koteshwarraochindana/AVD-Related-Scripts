```powershell
# ============================================================
# AVD Historical Domain Controller / Logon Investigation
# Read-only - October 19, 2026
# Run PowerShell as Administrator on the affected session host
# Output: C:\Temp\AVD_DC_Investigation.csv
# ============================================================

$Start = [datetime]'2026-10-19 07:50:00'
$End   = [datetime]'2026-10-19 08:15:00'
$Out   = 'C:\Temp\AVD_DC_Investigation.csv'

New-Item -Path 'C:\Temp' -ItemType Directory -Force |
    Out-Null

$Results = @()

# Search historical events from relevant logs.
$Logs = @(
    'System',
    'Security',
    'Microsoft-Windows-GroupPolicy/Operational'
)

foreach ($Log in $Logs) {
    try {
        $Events = Get-WinEvent -FilterHashtable @{
            LogName   = $Log
            StartTime = $Start
            EndTime   = $End
        } -ErrorAction Stop

        foreach ($Event in $Events) {
            $Message = $Event.Message

            # Retain events relevant to DC discovery, authentication,
            # Group Policy, DNS, Kerberos, and domain logon.
            if (
                $Log -eq 'Microsoft-Windows-GroupPolicy/Operational' -or
                $Event.ProviderName -match
                    'NETLOGON|GroupPolicy|Kerberos|DNS|LsaSrv|Security' -or
                $Message -match
                    'domain controller|DC name|SYSVOL|Kerberos|KDC|LDAP|secure channel|logon server'
            ) {
                $Results += [PSCustomObject]@{
                    TimeCreated  = $Event.TimeCreated
                    LogName      = $Log
                    Provider     = $Event.ProviderName
                    EventID      = $Event.Id
                    RecordID     = $Event.RecordId
                    Message      = $Message
                }
            }
        }
    }
    catch {
        Write-Warning "Could not read $Log : $($_.Exception.Message)"
    }
}

# Export historical findings.
$Results |
    Sort-Object TimeCreated |
    Export-Csv -Path $Out -NoTypeInformation -Encoding UTF8

Write-Host "Events found: $($Results.Count)"
Write-Host "Report saved: $Out"

# Display likely DC references in the console.
$Results |
    Where-Object {
        $_.Message -match
            '([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}|\\\\[^\\]+\\SYSVOL'
    } |
    Select-Object TimeCreated, LogName, Provider, EventID, Message |
    Format-List
```

# ============================================================
# AVD SLOW LOGIN ANALYSIS REPORT - LAST 72 HOURS
# ============================================================

$HoursBack = 72
$StartTime = (Get-Date).AddHours(-$HoursBack)
$ComputerName = $env:COMPUTERNAME

Write-Host ""
Write-Host "=====================================================" -ForegroundColor Cyan
Write-Host "AVD SLOW LOGIN ANALYSIS (SINGLE SESSION)" -ForegroundColor Cyan
Write-Host "HOST     : $ComputerName" -ForegroundColor Cyan
Write-Host "LOOKBACK : $HoursBack Hours" -ForegroundColor Cyan
Write-Host "=====================================================" -ForegroundColor Cyan
Write-Host ""

# ------------------------------------------------------------
# Collect Terminal Services Events
# ------------------------------------------------------------
$TSEvents = Get-WinEvent -FilterHashtable @{
    LogName = "Microsoft-Windows-TerminalServices-LocalSessionManager/Operational"
    StartTime = $StartTime
    Id = 21,22,41
} -ErrorAction SilentlyContinue | Sort-Object TimeCreated

$Sessions = @()
$SessionTracker = @{} 

foreach ($Event in $TSEvents) {
    $SessionId = $Event.Properties.Value
    $User = if ($Event.Message -match 'User:\s*([^\s\\]+)') { $Matches[1] } else { "Unknown" }

    switch ($Event.Id) {
        41 {
            $SessionTracker[$SessionId] = [ordered]@{
                User         = $User
                SessionStart = $Event.TimeCreated
                AuthSuccess  = $null
                DesktopReady = $null
            }
        }
        21 {
            if ($SessionTracker.ContainsKey($SessionId)) {
                $SessionTracker[$SessionId].AuthSuccess = $Event.TimeCreated
            }
        }
        22 {
            if ($SessionTracker.ContainsKey($SessionId) -and $SessionTracker[$SessionId].SessionStart -and $SessionTracker[$SessionId].AuthSuccess) {
                $CurrentSession = $SessionTracker[$SessionId]
                $CurrentSession.DesktopReady = $Event.TimeCreated

                $AuthSec    = [math]::Round(($CurrentSession.AuthSuccess - $CurrentSession.SessionStart).TotalSeconds,0)
                $DesktopSec = [math]::Round(($CurrentSession.DesktopReady - $CurrentSession.AuthSuccess).TotalSeconds,0)
                $TotalSec   = [math]::Round(($CurrentSession.DesktopReady - $CurrentSession.SessionStart).TotalSeconds,0)

                $Sessions += [PSCustomObject]@{
                    Hostname          = $ComputerName
                    Username          = $CurrentSession.User
                    LoginStart        = $CurrentSession.SessionStart
                    AuthenticationSec = $AuthSec
                    DesktopLoadSec    = $DesktopSec
                    TotalLoginSec     = $TotalSec
                    Severity          = if($TotalSec -gt 120){"CRITICAL"}
                                        elseif($TotalSec -gt 60){"HIGH"}
                                        elseif($TotalSec -gt 30){"WARNING"}
                                        else{"NORMAL"}
                }
                $SessionTracker.Remove($SessionId) | Out-Null
            }
        }
    }
}

# ------------------------------------------------------------
# Optimized Event Log Collections 
# ------------------------------------------------------------
$DiagEvents = Get-WinEvent -FilterHashtable @{
    LogName = "Microsoft-Windows-Diagnostics-Performance/Operational"
    StartTime = $StartTime
    Id = 100,101,200,400,500
} -ErrorAction SilentlyContinue

$GPEvents = Get-WinEvent -FilterHashtable @{
    LogName = "Microsoft-Windows-GroupPolicy/Operational"
    StartTime = $StartTime
} -ErrorAction SilentlyContinue | Select-Object TimeCreated,Id,LevelDisplayName

$WinlogonEvents = Get-WinEvent -FilterHashtable @{
    LogName = "Microsoft-Windows-Winlogon/Operational"
    StartTime = $StartTime
} -ErrorAction SilentlyContinue

# ------------------------------------------------------------
# Summary Display
# ------------------------------------------------------------
Write-Host ""
Write-Host "========== LOGIN PERFORMANCE ==========" -ForegroundColor Cyan
$Sessions | Sort-Object LoginStart | Format-Table -AutoSize

Write-Host ""
Write-Host "========== SLOW LOGINS (>30 SEC) ==========" -ForegroundColor Yellow
$Sessions | Where-Object {$_.TotalLoginSec -gt 30} | Sort-Object TotalLoginSec -Descending | Format-Table -AutoSize

Write-Host ""
Write-Host "========== SUMMARY ==========" -ForegroundColor Green
$total    = $Sessions.Count
$slow     = ($Sessions | Where-Object {$_.TotalLoginSec -gt 30}).Count
$critical = ($Sessions | Where-Object {$_.TotalLoginSec -gt 120}).Count

Write-Host "Total Login Attempts : $total"
Write-Host "Slow Logins (>30s)   : $slow"
Write-Host "Critical (>120s)     : $critical"
Write-Host "Winlogon Events      : $($WinlogonEvents.Count)"
Write-Host "GPO Events           : $($GPEvents.Count)"
Write-Host "Diag Events          : $($DiagEvents.Count)"

# ------------------------------------------------------------
# Export Files
# ------------------------------------------------------------
$Folder = "C:\Temp"
if (!(Test-Path $Folder)) { New-Item -Path $Folder -ItemType Directory -Force | Out-Null }

$Sessions | Export-Csv -Path "$Folder\AVD_LoginAnalysis.csv" -NoTypeInformation
$GPEvents | Export-Csv -Path "$Folder\AVD_GPO.csv" -NoTypeInformation
$WinlogonEvents | Select-Object TimeCreated,Id,Message | Export-Csv -Path "$Folder\AVD_Winlogon.csv" -NoTypeInformation

Write-Host ""
Write-Host "CSV Files Saved To: $Folder" -ForegroundColor Green
Write-Host ""

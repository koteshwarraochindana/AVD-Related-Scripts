
# AVD Slow Login - Azure Run Command
# Displays results directly in Run Command output
# Also saves a local copy on the VM

$Start = Get-Date "10/19/2026 07:45:00"
$End   = Get-Date "10/19/2026 08:15:00"
$Out   = "C:\Windows\Temp\AVD_SlowLogin_Report.txt"

$Logs = @(
    "Microsoft-Windows-GroupPolicy/Operational",
    "Microsoft-Windows-User Profiles Service/Operational",
    "Microsoft-Windows-Winlogon/Operational",
    "Microsoft-Windows-TerminalServices-LocalSessionManager/Operational",
    "Microsoft-Windows-TerminalServices-RemoteConnectionManager/Operational"
)

$Report = [System.Collections.Generic.List[string]]::new()

$Report.Add("AVD SLOW LOGIN REPORT")
$Report.Add("VM: $env:COMPUTERNAME")
$Report.Add("Time range: $Start to $End")
$Report.Add("")

foreach ($Log in $Logs) {
    $Report.Add("========== $Log ==========")

    try {
        $Events = @(
            Get-WinEvent -FilterHashtable @{
                LogName   = $Log
                StartTime = $Start
                EndTime   = $End
            } -ErrorAction Stop |
            Sort-Object TimeCreated
        )

        if ($Events.Count -eq 0) {
            $Report.Add("No events found.")
        }
        else {
            foreach ($Event in $Events) {
                $Report.Add("Time: $($Event.TimeCreated)")
                $Report.Add("Event ID: $($Event.Id)")
                $Report.Add("Level: $($Event.LevelDisplayName)")
                $Report.Add("Message: $($Event.Message)")
                $Report.Add("----------------------------------------")
            }
        }
    }
    catch {
        $Report.Add("Unable to read log: $($_.Exception.Message)")
    }

    $Report.Add("")
}

# Save locally
try {
    $Report | Out-File -FilePath $Out -Width 300 -Encoding UTF8
}
catch {
    Write-Output "WARNING: Could not save local report: $($_.Exception.Message)"
}

# Print results directly to Azure Run Command output
foreach ($Line in $Report) {
    Write-Output $Line
}

Write-Output "Report collection completed."


$Start = Get-Date "10/19/2026 07:45:00"
$End   = Get-Date "10/19/2026 08:15:00"

Write-Output "===== SECURITY LOG: LOGON EVENTS ====="

Get-WinEvent -FilterHashtable @{
    LogName   = "Security"
    Id        = 4624, 4625, 4768, 4769, 4771, 4776
    StartTime = $Start
    EndTime   = $End
} -ErrorAction SilentlyContinue |
Where-Object {
    $_.Message -match "u312963"
} |
Select-Object TimeCreated, Id, ProviderName, Message |
Format-List

Write-Output "===== GROUP POLICY EVENTS ====="

Get-WinEvent -FilterHashtable @{
    LogName   = "Microsoft-Windows-GroupPolicy/Operational"
    StartTime = $Start
    EndTime   = $End
} -ErrorAction SilentlyContinue |
Select-Object TimeCreated, Id, LevelDisplayName, Message |
Format-List

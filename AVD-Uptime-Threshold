
# AVD slow-login investigation - read only
$Start = Get-Date "10/19/2026 07:45:00"
$End   = Get-Date "10/19/2026 08:15:00"
$User  = "u312963"

$Logs = @(
    @{
        Name = "SECURITY - Authentication"
        Log  = "Security"
        IDs  = @(4624,4625,4768,4769,4771,4776)
    },
    @{
        Name = "GROUP POLICY"
        Log  = "Microsoft-Windows-GroupPolicy/Operational"
        IDs  = $null
    },
    @{
        Name = "USER PROFILE SERVICE"
        Log  = "Microsoft-Windows-User Profiles Service/Operational"
        IDs  = $null
    },
    @{
        Name = "TERMINAL SERVICES - REMOTE CONNECTION"
        Log  = "Microsoft-Windows-TerminalServices-RemoteConnectionManager/Operational"
        IDs  = $null
    }
)

foreach ($Item in $Logs) {
    Write-Host "`n========== $($Item.Name) ==========" -ForegroundColor Cyan

    try {
        $Filter = @{
            LogName   = $Item.Log
            StartTime = $Start
            EndTime   = $End
        }

        if ($Item.IDs) {
            $Filter.Id = $Item.IDs
        }

        Get-WinEvent -FilterHashtable $Filter -ErrorAction Stop |
            Where-Object {
                $_.Message -match [regex]::Escape($User) -or
                $Item.Name -ne "SECURITY - Authentication"
            } |
            Sort-Object TimeCreated |
            Select-Object TimeCreated, Id, ProviderName, Message |
            Format-List
    }
    catch {
        Write-Host "Could not read this log: $($_.Exception.Message)" `
            -ForegroundColor Yellow
    }
}

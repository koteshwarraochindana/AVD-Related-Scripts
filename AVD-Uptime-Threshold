PS C:\Users\p579652> # ============================================================
# AVD AUTHENTICATION INVESTIGATION REPORT
# Last 72 Hours
# ============================================================

$StartTime = (Get-Date).AddHours(-72)

Write-Host ""
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "AVD DOMAIN AUTHENTICATION INVESTIGATION" -ForegroundColor Yellow
Write-Host "Host: $env:COMPUTERNAME"
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host ""

# ------------------------------------------------------------
# SYSTEM LOG
# ------------------------------------------------------------

Write-Host ""
Write-Host "NETLOGON / DNS / SECURE CHANNEL EVENTS" -ForegroundColor Green
Write-Host "============================================================"

Get-WinEvent -FilterHashtable @{
    LogName='System'
    StartTime=$StartTime
} -ErrorAction SilentlyContinue |
Where-Object {
    $_.ProviderName -match 'NETLOGON|DNS|DNS Client Events|GroupPolicy|LSASRV|Time-Service'
} |
Select-Object `
TimeCreated,
ProviderName,
Id,
LevelDisplayName,
@{
    Name='Message'
    Expression={
        $_.Message.Replace("`r"," ").Replace("`n"," ")
    }
} |
Format-List

# ------------------------------------------------------------
# COMMON NETLOGON EVENTS
# ------------------------------------------------------------

Write-Host ""
Write-Host "NETLOGON FAILURES" -ForegroundColor Red
Write-Host "============================================================"

Get-WinEvent -FilterHashtable @{
    LogName='System'
    StartTime=$StartTime
} -ErrorAction SilentlyContinue |
Where-Object {
    $_.ProviderName -eq 'NETLOGON' -and
    $_.Id -in @(5719,5722,5783,5805)
} |
Select TimeCreated,Id,LevelDisplayName,Message |
Format-List

# ------------------------------------------------------------
# CURRENT DOMAIN INFO
# ------------------------------------------------------------

Write-Host ""
Write-Host "DOMAIN INFORMATION" -ForegroundColor Green
Write-Host "============================================================"

Write-Host "Computer Name : $env:COMPUTERNAME"
Write-Host "Domain        : $((Get-CimInstance Win32_ComputerSystem).Domain)"
Write-Host "Logon Server  : $env:LOGONSERVER"

Write-Host ""

# ------------------------------------------------------------
# TEST SECURE CHANNEL
# ------------------------------------------------------------

try {

    $SecureChannel = Test-ComputerSecureChannel -Verbose

    Write-Host "Secure Channel Healthy : $SecureChannel" -ForegroundColor Green
}
catch {

    Write-Host "Secure Channel Test Failed" -ForegroundColor Red
}

Write-Host ""

# ------------------------------------------------------------
# DISCOVER DOMAIN CONTROLLER
# ------------------------------------------------------------

Write-Host "CURRENT DOMAIN CONTROLLER" -ForegroundColor Green
Write-Host "============================================================"

$Domain = (Get-CimInstance Win32_ComputerSystem).Domain

nltest /dsgetdc:$Domain

Write-Host ""

# ------------------------------------------------------------
# LOGIN EVENTS
# ------------------------------------------------------------

Write-Host "LOGIN TIMING EVENTS" -ForegroundColor Green
Write-Host "============================================================"

Get-WinEvent -FilterHashtable @{
    LogName='Microsoft-Windows-TerminalServices-LocalSessionManager/Operational'
    Id=21,22,24,25,41
    StartTime=$StartTime
} -ErrorAction SilentlyContinue |
Select TimeCreated,Id |
Sort TimeCreated |
Format-Table -AutoSize


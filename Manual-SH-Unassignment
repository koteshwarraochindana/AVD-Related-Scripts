# ============================================================ #
# AVD Personal Host Un-Assignment - CSV Based                  #
# ============================================================ #
# -----------------------------
# Environment Variables
# -----------------------------
$SubscriptionId    = "750da1a4-85cc-489e-b629-e512e0989c16"
$ResourceGroupName = "prd_scentral_avd3_infra_rg"
$HostPoolName      = "AVD-CA2-AVD3-WIN11-SC1"
$CsvPath           = "C:\Temp\UnAssignments.csv"
$OutputPath        = "C:\Temp\AVD_UnAssignment_Results.csv"
# -----------------------------
# Prerequisite Check
# -----------------------------
if (!(Get-Module -ListAvailable -Name Az.DesktopVirtualization)) {
    Write-Host "Error: Az.DesktopVirtualization module is missing." -ForegroundColor Red
    return
}

if (!(Test-Path $CsvPath)) {
    Write-Host "Error: Input CSV file not found at $CsvPath" -ForegroundColor Red
    return
}
# -----------------------------
# Connect to Azure
# -----------------------------
Write-Host ""
Write-Host "Setting Azure Context..." -ForegroundColor Cyan

Set-AzContext `
    -SubscriptionId $SubscriptionId |
    Out-Null
# -----------------------------
# Import CSV
# -----------------------------
$UnAssignments = Import-Csv $CsvPath

if (!$UnAssignments) {
    Write-Host "Error: CSV contains no records." -ForegroundColor Red
    return
}
$TotalRows = $UnAssignments.Count
$Counter = 1
Write-Host ""
Write-Host "Found $TotalRows input records in CSV file." -ForegroundColor Cyan
Write-Host "Starting un-assignment process..." -ForegroundColor Cyan
Write-Host ""
# -----------------------------
# Process CSV
# -----------------------------
$Results = foreach ($Item in $UnAssignments) {

    $SessionHostName = $Item.SessionHostName.Trim()

    try {

        # Ensure correct AVD session host format
        if ($SessionHostName -notmatch "^$HostPoolName/") {
            $FullHostName = "$HostPoolName/$SessionHostName"
        }
        else {
            $FullHostName = $SessionHostName
        }


        # Remove user assignment by passing $null directly
        Update-AzWvdSessionHost `
            -ResourceGroupName $ResourceGroupName `
            -HostPoolName $HostPoolName `
            -Name $FullHostName `
            -AssignedUser $null `
            -ErrorAction Stop |
            Out-Null


        $Status = "Success"
        $Message = "Unassigned successfully"

    }
    catch {

        $Status = "Failed"
        $Message = $_.Exception.Message
    }


    # -----------------------------
    # Display Result
    # -----------------------------
    $TextColor = switch ($Status) {
        "Success" { "Green" }
        Default   { "Red" }
    }

    Write-Host `
        "[$Counter/$TotalRows] $SessionHostName -> Unassigned ($Status)" `
        -ForegroundColor $TextColor


    # -----------------------------
    # Result Object
    # -----------------------------
    [PSCustomObject]@{
        Sequence        = $Counter
        TimeStamp       = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        SessionHostName = $SessionHostName
        Status          = $Status
        Message         = $Message
    }

    $Counter++
}


# -----------------------------
# Export Results
# -----------------------------
$Results |
    Export-Csv `
        -Path $OutputPath `
        -NoTypeInformation `
        -Encoding UTF8


# -----------------------------
# Summary
# -----------------------------
$SuccessCount = @($Results | Where-Object Status -eq "Success").Count
$FailedCount  = @($Results | Where-Object Status -eq "Failed").Count


Write-Host ""
Write-Host "================================================================================" `
    -ForegroundColor Cyan

Write-Host "Un-assignment process completed." `
    -ForegroundColor Green

Write-Host "Total    : $TotalRows"
Write-Host "Success  : $SuccessCount" -ForegroundColor Green
Write-Host "Failed   : $FailedCount" -ForegroundColor Red

Write-Host ""
Write-Host "Results exported to:" -ForegroundColor Cyan
Write-Host $OutputPath
Write-Host "================================================================================" `
    -ForegroundColor Cyan

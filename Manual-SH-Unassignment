```powershell
# ============================================================ #
# AVD Personal Host Un-Assignment - CSV Based                  #
# ============================================================ #

# -----------------------------
# Environment Variables
# -----------------------------
$SubscriptionId    = "56fb6a7f-8b65-4aba-90f0-b17a9dbb7b55"
$ResourceGroupName = "prd_scentral_avd_corp2_infra_rg"
$HostPoolName      = "AVD-CAS2-CORP2-SC"

$InputCsv  = "C:\Temp\Assignments.csv"
$OutputCsv = "C:\Temp\AVD_UnAssignment_Results.csv"

# -----------------------------
# Set Subscription
# -----------------------------
Set-AzContext -SubscriptionId $SubscriptionId | Out-Null

# -----------------------------
# Import CSV
# -----------------------------
$Assignments = Import-Csv -Path $InputCsv

$Results = @()

# -----------------------------
# Process Each Session Host
# -----------------------------
foreach ($Assignment in $Assignments) {

    $SessionHostName = $Assignment.SessionHostName.Trim()

    # Remove FQDN if present
    $ShortHostName = $SessionHostName.Split(".")[0]

    Write-Host ""
    Write-Host "Processing: $ShortHostName" -ForegroundColor Cyan

    try {

        # -----------------------------
        # Get Session Host
        # -----------------------------
        $SessionHost = Get-AzWvdSessionHost `
            -ResourceGroupName $ResourceGroupName `
            -HostPoolName $HostPoolName `
            -Name $ShortHostName `
            -SubscriptionId $SubscriptionId `
            -ErrorAction Stop

        # -----------------------------
        # Check Current Assignment
        # -----------------------------
        $ExistingUser = $SessionHost.AssignedUser

        if ([string]::IsNullOrWhiteSpace($ExistingUser)) {

            Write-Host "SKIPPED - No user is currently assigned." -ForegroundColor Yellow

            $Results += [PSCustomObject]@{
                SessionHostName = $ShortHostName
                ExistingUser    = ""
                Status          = "Skipped"
                Reason          = "No user is currently assigned to this session host."
            }

            continue
        }

        # -----------------------------
        # Remove Assignment
        # -----------------------------
        Update-AzWvdSessionHost `
            -ResourceGroupName $ResourceGroupName `
            -HostPoolName $HostPoolName `
            -Name $ShortHostName `
            -AssignedUser $null `
            -SubscriptionId $SubscriptionId `
            -ErrorAction Stop | Out-Null

        Write-Host "SUCCESS - Unassigned $ExistingUser" -ForegroundColor Green

        $Results += [PSCustomObject]@{
            SessionHostName = $ShortHostName
            ExistingUser    = $ExistingUser
            Status          = "Success"
            Reason          = "User assignment removed successfully."
        }

    }
    catch {

        $ErrorReason = $_.Exception.Message

        Write-Host "FAILED - $ErrorReason" -ForegroundColor Red

        $Results += [PSCustomObject]@{
            SessionHostName = $ShortHostName
            ExistingUser    = $ExistingUser
            Status          = "Failed"
            Reason          = $ErrorReason
        }
    }
}

# -----------------------------
# Export Results
# -----------------------------
$Results | Export-Csv `
    -Path $OutputCsv `
    -NoTypeInformation `
    -Encoding UTF8

Write-Host ""
Write-Host "============================================" -ForegroundColor Cyan
Write-Host "Un-assignment processing completed." -ForegroundColor Green
Write-Host "Results saved to:" -ForegroundColor Cyan
Write-Host $OutputCsv -ForegroundColor White
Write-Host "============================================" -ForegroundColor Cyan
```
